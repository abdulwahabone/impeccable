---
import Base from '../../layouts/Base.astro';
import '../../styles/design-system.css';

// Every swatch reads its value live from kinpaku-tokens.css at load (see the
// script at the bottom), so this list only names tokens and their jobs.
const ladders = [
  {
    id: 'paper',
    name: 'Paper',
    note: 'The page and everything that sits flat on it. Neutral, chroma 0: gold on cream is gold on gold.',
    chips: [
      { token: '--ks-paper', role: 'page ground' },
      { token: '--ks-paper-raised', role: 'cards, panels, inputs' },
      { token: '--ks-paper-deep', role: 'wells, code blocks, footer' },
      { token: '--ks-gray', role: 'chips, inactive fills' },
      { token: '--ks-gray-2', role: 'one step down' },
    ],
  },
  {
    id: 'ink',
    name: 'Ink',
    note: 'Headlines and strong text are ink. Body is text. Muted is for captions, faint for meta, mute-deep for disabled.',
    chips: [
      { token: '--ks-ink', role: 'headlines, strong, active nav' },
      { token: '--ks-text', role: 'body' },
      { token: '--ks-text-muted', role: 'captions, eyebrows' },
      { token: '--ks-text-faint', role: 'subdued meta' },
      { token: '--ks-text-mute-deep', role: 'disabled' },
    ],
  },
  {
    id: 'instrument',
    name: 'Instrument',
    note: 'The only dark surfaces on the site, reserved for controls. Text on them uses the two instrument foregrounds.',
    dark: true,
    chips: [
      { token: '--ks-instrument-deep', role: 'track, well' },
      { token: '--ks-instrument', role: 'face' },
      { token: '--ks-instrument-raised', role: 'key cap, thumb' },
      { token: '--ks-instrument-text', role: 'text on instruments' },
      { token: '--ks-instrument-muted', role: 'muted text on instruments' },
    ],
  },
  {
    id: 'gold',
    name: 'Gold',
    note: 'The mark, a hairline, an indicator or fill on an instrument, the arrow in the primary button. None of these carry text: at 84% lightness the base gold lands under 2:1 against paper.',
    chips: [
      { token: '--ks-kinpaku', role: 'mark, indicators' },
      { token: '--ks-kinpaku-vivid', role: 'lit hover on a gold fill' },
      { token: '--ks-kinpaku-rich', role: 'hairline gold on paper' },
      { token: '--ks-kinpaku-deep', role: 'gold border against paper' },
      { token: '--ks-on-gold', role: 'foreground on a gold fill' },
    ],
  },
  {
    id: 'patina',
    name: 'Patina',
    note: 'Verdigris carries state, links and selection. When color has to be read as text, it is patina-deep, which clears 4.5:1 on paper.',
    chips: [
      { token: '--ks-patina', role: 'indicator, focus ring' },
      { token: '--ks-patina-pale', role: 'fill behind a selected row' },
      { token: '--ks-patina-deep', role: 'text on paper, links' },
      { token: '--ks-patina-ink', role: 'hover on patina text' },
      { token: '--ks-vermilion', role: 'warnings and failures only' },
    ],
  },
];

const typeRows = [
  { scale: 'wordmark', label: 'Wordmark', sample: 'IMPECCABLE' },
  { scale: 'display', label: 'Display · h1', sample: 'Tune interfaces while they run.' },
  { scale: 'headline', label: 'Headline · h2', sample: 'Ready to drop in.' },
  { scale: 'title', label: 'Title · h3', sample: 'Inherits tokens, components, conventions.' },
  { scale: 'body', label: 'Body', sample: 'Specific audit evidence, clear command language, no decorative hedging. Long copy holds a 65ch measure and breathes at line-height 1.65.' },
  { scale: 'eyebrow', label: 'Eyebrow', sample: 'Layout · Type · Color · Motion' },
  { scale: 'mono', label: 'Mono', sample: '/impeccable polish --scope hero' },
];

const markSvg = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 2.5 L13.5 2.5 L5.5 21.5 L5 21.5 Q2.5 21.5 2.5 19 L2.5 5 Q2.5 2.5 5 2.5 Z"/><path d="M16.5 2.5 L19 2.5 Q21.5 2.5 21.5 5 L21.5 19 Q21.5 21.5 19 21.5 L8.5 21.5 Z"/></svg>';
const arrowSvg = '<svg viewBox="0 0 16 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M0 4h14M10 0l4 4-4 4"/></svg>';
---

<Base
  title="Impeccable Design System"
  description="The paper system behind impeccable.style: color ladders, one type family, instruments, and the component kit as it ships."
  canonicalPath="/design-system"
  bodyClass="kinpaku-system-page kinpaku-chrome kinpaku-surface"
  mainId="design-system-main"
  mainClass="kinpaku-system"
  hideHeader={true}
  noIndex={true}
>
  <!-- ============================================================
       Header and intro. The page renders its own topbar because its
       nav is a table of contents, not the site nav.
       ============================================================ -->
  <section class="ks-hero" aria-labelledby="system-title">
    <header class="ks-topbar" aria-label="Design system navigation">
      <a class="ks-brand" href="/" aria-label="Impeccable home">
        <span class="ks-mark" aria-hidden="true" set:html={markSvg}></span>
        <span class="ks-wordmark">IMPECCABLE</span>
      </a>
      <nav class="ks-nav" aria-label="Design system sections">
        <a href="#mark">Mark</a>
        <a href="#color">Color</a>
        <a href="#type">Type</a>
        <a href="#instruments">Instruments</a>
        <a href="#components">Components</a>
        <a href="#space">Space</a>
      </nav>
    </header>

    <div class="ks-hero-body">
      <p class="ks-section-eyebrow">Design system</p>
      <h1 id="system-title">Paper and instruments.</h1>
      <p class="ks-hero-line">The site is a gallery wall. Every world card, case study and demo on it brings its own loud visual system, so the chrome stays quiet: neutral paper, one typeface, ink. Gold shows up as the mark, a one-pixel rule, or an indicator on a dark control. It never carries text, and it never fills an area on paper.</p>
    </div>
  </section>

  <!-- ============================================================
       Mark
       ============================================================ -->
  <section class="ks-section" id="mark" aria-labelledby="mark-title">
    <div class="ks-section-head">
      <p class="ks-section-eyebrow">Mark</p>
      <h2 id="mark-title">A carved tile split by the slash.</h2>
      <p class="ks-section-sub">The mark is the one place gold fills a shape on paper. The wordmark beside it is ink, set in Alumni Sans, the only text on the site not in Albert Sans.</p>
    </div>

    <div class="ks-subsection">
      <span class="ks-subsection-label">The mark · one fill, favicon to billboard</span>
      <div class="ks-mark-scale" aria-hidden="true">
        {[64, 38, 24, 16].map((size) => (
          <figure class="ks-mark-scale-item">
            <span class="ks-mark-glyph" style={`width:${size}px;height:${size}px;`} set:html={markSvg}></span>
            <figcaption>{size}px</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="ks-subsection">
      <span class="ks-subsection-label">Lockup · gold mark, ink wordmark, 4px gap</span>
      <div class="ks-lockup-stage">
        <span class="ks-brand" aria-label="Impeccable lockup">
          <span class="ks-mark" aria-hidden="true" set:html={markSvg}></span>
          <span class="ks-wordmark">IMPECCABLE</span>
        </span>
      </div>
      <p class="ks-note">This is the header on every page. The mark is <code>--ks-kinpaku</code>, the wordmark is <code>--ks-ink</code> at <code>--ks-type-wordmark-size</code> with 0.15em tracking.</p>
    </div>

    <div class="ks-subsection">
      <span class="ks-subsection-label">Files · press, decks, slides</span>
      <div class="ks-logo-grid">
        <figure class="ks-logo-tile is-light">
          <img src="/assets/brand/impeccable-logo-on-light.svg" alt="Impeccable logo, ink on light" width="510" height="120">
          <figcaption>
            <span class="ks-logo-tile-label">On light</span>
            <span class="ks-logo-tile-links">
              <a href="/assets/brand/impeccable-logo-on-light.svg" download>SVG</a>
              <a href="/assets/brand/impeccable-logo-on-light.png" download>PNG</a>
            </span>
          </figcaption>
        </figure>
        <figure class="ks-logo-tile is-dark">
          <img src="/assets/brand/impeccable-logo-on-dark.svg" alt="Impeccable logo, gold on dark" width="510" height="120">
          <figcaption>
            <span class="ks-logo-tile-label">On dark</span>
            <span class="ks-logo-tile-links">
              <a href="/assets/brand/impeccable-logo-on-dark.svg" download>SVG</a>
              <a href="/assets/brand/impeccable-logo-on-dark.png" download>PNG</a>
            </span>
          </figcaption>
        </figure>
      </div>
      <p class="ks-note">The on-light file is all ink. The on-dark file sets the wordmark in gold as well, which only works because its ground is dark; use it on a slide or a partner wall, never on this site. Wordmarks are outlined to paths, PNGs are transparent at 4x.</p>
    </div>
  </section>

  <!-- ============================================================
       Color
       ============================================================ -->
  <section class="ks-section" id="color" aria-labelledby="color-title">
    <div class="ks-section-head">
      <p class="ks-section-eyebrow">Color</p>
      <h2 id="color-title">Five surfaces, five inks, one signal.</h2>
      <p class="ks-section-sub">Values are read from <code>kinpaku-tokens.css</code> when the page loads. If a token moves, this page moves with it.</p>
    </div>

    {ladders.map((ladder) => (
      <div class="ks-subsection">
        <span class="ks-subsection-label">{ladder.name}</span>
        <div class={`ks-ladder ${ladder.dark ? 'is-dark' : ''}`} role="list" aria-label={`${ladder.name} tokens`}>
          {ladder.chips.map((chip) => (
            <div class="ks-swatch" role="listitem" style={`--chip: var(${chip.token});`}>
              <span class="ks-swatch-chip" aria-hidden="true"></span>
              <span class="ks-swatch-name">{chip.token}</span>
              <span class="ks-swatch-role">{chip.role}</span>
              <span class="ks-swatch-value" data-token-value={chip.token}></span>
            </div>
          ))}
        </div>
        <p class="ks-note">{ladder.note}</p>
      </div>
    ))}

    <div class="ks-subsection">
      <span class="ks-subsection-label">Rules</span>
      <div class="ks-rules">
        <div class="ks-rule-row">
          <span class="ks-rule-line" style="--line: var(--ks-rule);" aria-hidden="true"></span>
          <span class="ks-swatch-name">--ks-rule</span>
          <span class="ks-swatch-role">divides content</span>
          <span class="ks-swatch-value" data-token-value="--ks-rule"></span>
        </div>
        <div class="ks-rule-row">
          <span class="ks-rule-line" style="--line: var(--ks-edge);" aria-hidden="true"></span>
          <span class="ks-swatch-name">--ks-edge</span>
          <span class="ks-swatch-role">bounds a control, 3:1 for WCAG 1.4.11</span>
          <span class="ks-swatch-value" data-token-value="--ks-edge"></span>
        </div>
        <div class="ks-rule-row">
          <span class="ks-rule-line" style="--line: var(--ks-gold-line);" aria-hidden="true"></span>
          <span class="ks-swatch-name">--ks-gold-line</span>
          <span class="ks-swatch-role">the one-pixel gold rule</span>
          <span class="ks-swatch-value" data-token-value="--ks-gold-line"></span>
        </div>
      </div>
      <p class="ks-note">A divider is faint. The boundary of something you can operate is not. A gold line is jewelry: use one, not a set.</p>
    </div>
  </section>

  <!-- ============================================================
       Type
       ============================================================ -->
  <section class="ks-section" id="type" aria-labelledby="type-title">
    <div class="ks-section-head">
      <p class="ks-section-eyebrow">Type</p>
      <h2 id="type-title">One family. Albert Sans at 500 and 600.</h2>
      <p class="ks-section-sub">No hairline headings. Display and headline sit at weight 500, titles at 600, body at 400. <code>--ks-font-display</code> aliases <code>--ks-font</code>; the alias exists so old rules keep resolving.</p>
    </div>

    <div class="ks-type-stack">
      {typeRows.map((row) => (
        <div class="ks-type-row">
          <span class="ks-type-label">{row.label}</span>
          <div>
            <span class="ks-type-sample" data-scale={row.scale}>{row.sample}</span>
            <p class="ks-type-spec-line" data-type-scale={row.scale}></p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================================================
       Instruments
       ============================================================ -->
  <section class="ks-section" id="instruments" aria-labelledby="instruments-title">
    <div class="ks-section-head">
      <p class="ks-section-eyebrow">Instruments</p>
      <h2 id="instruments-title">The only dark surface is one you operate.</h2>
      <p class="ks-section-sub">A control the reader works, like a tab strip, a slider or a terminal, sits on <code>--ks-instrument</code> like a device on a desk. Nothing decorative goes dark: no dark sections, no dark cards, no dark footer. It is also the one place gold reads as a signal rather than a mark.</p>
    </div>

    <div class="ks-subsection">
      <span class="ks-subsection-label">Command strip · .ks-instrument-strip</span>
      <div class="ks-instrument-stage">
        <div class="ks-instrument-strip" role="tablist" aria-label="Command switcher sample" data-ks-strip>
          <button class="ks-instrument-key" type="button" role="tab" aria-selected="true">/polish</button>
          <button class="ks-instrument-key" type="button" role="tab" aria-selected="false">/distill</button>
          <button class="ks-instrument-key" type="button" role="tab" aria-selected="false">/clarify</button>
        </div>
      </div>
      <p class="ks-note">The homepage hero switcher, verbatim. Face at 24%, a 17% edge, and the active key raised to 31% with a 6px gold dot. Inactive keys read in <code>--ks-instrument-muted</code>, active in <code>--ks-instrument-text</code>. Click a key.</p>
    </div>

    <div class="ks-subsection">
      <span class="ks-subsection-label">Anatomy</span>
      <dl class="ks-anatomy">
        <div><dt>Face</dt><dd><code>--ks-instrument</code>, the strip itself, with a 1px <code>--ks-instrument-deep</code> border and an inset <code>--ks-instrument-rule</code> highlight along the top.</dd></div>
        <div><dt>Key cap</dt><dd><code>--ks-instrument-raised</code>. The active key lifts off the face; it does not tint.</dd></div>
        <div><dt>Indicator</dt><dd>A 6px dot. Gold when active, <code>--ks-instrument-raised</code> when idle. Patina takes the same slot when the state is selection rather than position.</dd></div>
        <div><dt>Focus</dt><dd>A 2px <code>--ks-patina</code> ring, 2px out, on every instrument key and on every control on paper.</dd></div>
      </dl>
    </div>
  </section>

  <!-- ============================================================
       Components
       ============================================================ -->
  <section class="ks-section" id="components" aria-labelledby="components-title">
    <div class="ks-section-head">
      <p class="ks-section-eyebrow">Components</p>
      <h2 id="components-title">The kit, as it ships.</h2>
      <p class="ks-section-sub">Every sample below is <code>kinpaku-kit.css</code> with no page overrides. If it looks wrong here, it looks wrong on every page.</p>
    </div>

    <div class="ks-component-grid">
      <div class="ks-component">
        <span class="ks-component-label">Buttons</span>
        <div class="ks-button-row">
          <a class="ks-button ks-button-primary" href="#components">
            Start audit
            <span class="ks-button-arrow" aria-hidden="true" set:html={arrowSvg}></span>
          </a>
          <a class="ks-button ks-button-secondary" href="#components">See rules</a>
          <button class="ks-button ks-button-ghost" type="button">Docs</button>
          <button class="ks-button ks-button-disabled" type="button" disabled>Loading</button>
        </div>
        <p class="ks-note">The primary is ink. The brand is present as the gold arrow, not as the fill.</p>
      </div>

      <div class="ks-component">
        <span class="ks-component-label">Primary states</span>
        <div class="ks-state-grid">
          <span class="ks-state-label">Default</span>
          <a class="ks-button ks-button-primary" href="#components">Start audit <span class="ks-button-arrow" aria-hidden="true" set:html={arrowSvg}></span></a>
          <span class="ks-state-label">Hover</span>
          <a class="ks-button ks-button-primary" href="#components" data-state="hover">Start audit <span class="ks-button-arrow" aria-hidden="true" set:html={arrowSvg}></span></a>
          <span class="ks-state-label">Pressed</span>
          <a class="ks-button ks-button-primary" href="#components" data-state="pressed">Start audit <span class="ks-button-arrow" aria-hidden="true" set:html={arrowSvg}></span></a>
          <span class="ks-state-label">Disabled</span>
          <button class="ks-button ks-button-disabled" type="button" disabled>Start audit <span class="ks-button-arrow" aria-hidden="true" set:html={arrowSvg}></span></button>
        </div>
      </div>

      <div class="ks-component">
        <span class="ks-component-label">Form controls</span>
        <form class="ks-form-sample" onsubmit="return false">
          <label>
            <span>Rule search</span>
            <input type="search" value="gradient" aria-label="Search rules">
          </label>
          <label class="ks-toggle">
            <input type="checkbox" checked>
            <span>Auto apply fixes</span>
          </label>
          <label class="ks-checkbox">
            <input type="checkbox" checked>
            <span>Include subpages</span>
          </label>
          <label>
            <span>Range</span>
            <select class="ks-select" aria-label="Range">
              <option>Last 7 days</option>
              <option>Last 30 days</option>
              <option>Last 90 days</option>
            </select>
          </label>
        </form>
      </div>

      <div class="ks-component">
        <span class="ks-component-label">Tabs</span>
        <div class="ks-tabs" data-ks-tabs>
          <div class="ks-tab-list" role="tablist" aria-label="Command filters">
            <button type="button" role="tab" aria-selected="true" aria-controls="tab-overview" id="tab-overview-control">Overview</button>
            <button type="button" role="tab" aria-selected="false" aria-controls="tab-issues" id="tab-issues-control">Issues</button>
            <button type="button" role="tab" aria-selected="false" aria-controls="tab-evidence" id="tab-evidence-control">Evidence</button>
            <button type="button" role="tab" aria-selected="false" aria-controls="tab-fixes" id="tab-fixes-control">Fixes</button>
          </div>
          <div class="ks-tab-panel" id="tab-overview" role="tabpanel" aria-labelledby="tab-overview-control">128 issues. 86 percent coverage. Ready to ship.</div>
          <div class="ks-tab-panel" id="tab-issues" role="tabpanel" aria-labelledby="tab-issues-control" hidden>Browse anti-patterns by category.</div>
          <div class="ks-tab-panel" id="tab-evidence" role="tabpanel" aria-labelledby="tab-evidence-control" hidden>Inspect captured DOM and screenshots per finding.</div>
          <div class="ks-tab-panel" id="tab-fixes" role="tabpanel" aria-labelledby="tab-fixes-control" hidden>Apply commands with design direction.</div>
        </div>

        <span class="ks-component-label" style="margin-top: 24px;">Segmented</span>
        <div class="ks-segmented" role="group" aria-label="View" data-ks-segmented>
          <button type="button" aria-pressed="true">Board</button>
          <button type="button" aria-pressed="false">Hero</button>
          <button type="button" aria-pressed="false">Docs</button>
        </div>
        <p class="ks-note">A paper instrument: recessed <code>--ks-paper-deep</code> track, <code>--ks-edge</code> border, a thumb that lifts on <code>--ks-lift-1</code>.</p>
      </div>

      <div class="ks-component">
        <span class="ks-component-label">Status badges</span>
        <div class="ks-badge-row">
          <span class="ks-badge is-detected">Detected</span>
          <span class="ks-badge is-improved">Improved</span>
          <span class="ks-badge is-ready">Ready</span>
        </div>
        <span class="ks-component-label" style="margin-top: 24px;">Issue tags</span>
        <div class="ks-tag-row">
          <span class="ks-tag is-detected">Gradient</span>
          <span class="ks-tag is-detected">Hierarchy</span>
          <span class="ks-tag is-neutral">Spacing</span>
          <span class="ks-tag is-improved">Improved</span>
          <span class="ks-tag is-ready">Consistent</span>
        </div>
      </div>

      <div class="ks-component">
        <span class="ks-component-label">Pagination</span>
        <div class="ks-pagination" role="navigation" aria-label="Page navigation">
          <button type="button" aria-label="Previous">‹</button>
          <button type="button">1</button>
          <button type="button" aria-current="page">2</button>
          <button type="button">3</button>
          <button type="button">4</button>
          <button type="button">5</button>
          <button type="button" aria-label="Next">›</button>
        </div>
        <span class="ks-component-label" style="margin-top: 24px;">Loading skeleton</span>
        <div class="ks-skeleton" aria-label="Loading">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>

    <div class="ks-component-grid-3">
      <div class="ks-component">
        <span class="ks-component-label">Toast · success</span>
        <div class="ks-toast is-success" role="status">
          <span class="ks-toast-icon" aria-hidden="true">
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="9" r="7.5"/>
              <path d="m5.5 9 2.5 2.5L12.5 7"/>
            </svg>
          </span>
          <div>
            <strong>Audit complete</strong>
            <span>12 issues detected, 8 ready to fix.</span>
          </div>
          <button class="ks-toast-close" type="button" aria-label="Dismiss">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"><path d="m1.5 1.5 9 9M10.5 1.5l-9 9"/></svg>
          </button>
        </div>
      </div>

      <div class="ks-component">
        <span class="ks-component-label">Toast · warning</span>
        <div class="ks-toast is-warning" role="status">
          <span class="ks-toast-icon" aria-hidden="true">
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="9" r="7.5"/>
              <path d="M9 5v4M9 12.5h.01"/>
            </svg>
          </span>
          <div>
            <strong>Audit failed</strong>
            <span>Reconnect the live page and run again.</span>
          </div>
          <button class="ks-toast-close" type="button" aria-label="Dismiss">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"><path d="m1.5 1.5 9 9M10.5 1.5l-9 9"/></svg>
          </button>
        </div>
      </div>

      <div class="ks-component">
        <span class="ks-component-label">Tooltip</span>
        <div class="ks-tooltip-sample">
          <button class="ks-icon-button" type="button" aria-describedby="tooltip-evidence">
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <circle cx="9" cy="9" r="7"/>
              <path d="M9 6.5v2.8M9 12h.01"/>
            </svg>
          </button>
          <span class="ks-tooltip" role="tooltip" id="tooltip-evidence">Evidence stays attached to the exact component.</span>
        </div>
      </div>

      <div class="ks-component">
        <span class="ks-component-label">Modal</span>
        <div class="ks-modal" role="dialog" aria-labelledby="modal-title">
          <button class="ks-modal-close" type="button" aria-label="Close">
            <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"><path d="m2 2 10 10M12 2 2 12"/></svg>
          </button>
          <h3 id="modal-title">Run audit on this project?</h3>
          <p>This will analyze 45 files and produce a report in the next few minutes.</p>
          <div class="ks-modal-actions">
            <button class="ks-button ks-button-secondary" type="button">Cancel</button>
            <button class="ks-button ks-button-primary" type="button">Run audit</button>
          </div>
        </div>
      </div>

      <div class="ks-component">
        <span class="ks-component-label">Empty state</span>
        <div class="ks-empty">
          <span class="ks-empty-icon" aria-hidden="true">
            <svg viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 12h24v18H6z"/>
              <path d="M6 12 18 4l12 8"/>
            </svg>
          </span>
          <strong>No issues found</strong>
          <p>Nothing flagged in 45 files.</p>
        </div>
      </div>

      <div class="ks-component">
        <span class="ks-component-label">Changelog</span>
        <div class="ks-changelog">
          <article class="ks-changelog-entry">
            <span class="ks-changelog-date">May 12, 2026</span>
            <div class="ks-changelog-body">
              <strong>New hierarchy detector <em>New</em></strong>
              <p>Spacing-consistency checks across rules and detectors.</p>
            </div>
          </article>
          <article class="ks-changelog-entry">
            <span class="ks-changelog-date">Apr 23, 2026</span>
            <div class="ks-changelog-body">
              <strong>Live audit performance</strong>
