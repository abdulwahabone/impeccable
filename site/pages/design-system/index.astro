  </section>

  <!-- ============================================================
       Space and shape
       ============================================================ -->
  <section class="ks-section" id="space" aria-labelledby="space-title">
    <div class="ks-section-head">
      <p class="ks-section-eyebrow">Space and shape</p>
      <h2 id="space-title">Three radii, three heights, two lifts.</h2>
      <p class="ks-section-sub">The control ladder is the whole shape vocabulary. There is no spacing token; rhythm comes from the section scaffolding in the kit.</p>
    </div>

    <div class="ks-shape-grid">
      <div class="ks-subsection">
        <span class="ks-subsection-label">Radii</span>
        <div class="ks-shape-row">
          {['sm', 'md', 'pill'].map((r) => (
            <figure class="ks-shape-item">
              <span class="ks-shape-radius" style={`border-radius: var(--ks-radius-${r});`} aria-hidden="true"></span>
              <figcaption><span>--ks-radius-{r}</span><span data-token-value={`--ks-radius-${r}`}></span></figcaption>
            </figure>
          ))}
        </div>
        <p class="ks-note">Small for buttons, inputs and chips. Medium for cards. Pill for an instrument strip and its keys.</p>
      </div>

      <div class="ks-subsection">
        <span class="ks-subsection-label">Control heights</span>
        <div class="ks-shape-row is-heights">
          {['sm', 'md', 'lg'].map((h) => (
            <figure class="ks-shape-item">
              <span class="ks-shape-height" style={`height: var(--ks-control-${h});`} aria-hidden="true"></span>
              <figcaption><span>--ks-control-{h}</span><span data-token-value={`--ks-control-${h}`}></span></figcaption>
            </figure>
          ))}
        </div>
        <p class="ks-note">A segmented control lands on medium exactly: 3px inset, 24px segment, 3px inset, two borders.</p>
      </div>

      <div class="ks-subsection">
        <span class="ks-subsection-label">Lifts</span>
        <div class="ks-shape-row">
          {['1', '2'].map((l) => (
            <figure class="ks-shape-item">
              <span class="ks-shape-lift" style={`box-shadow: var(--ks-lift-${l});`} aria-hidden="true"></span>
              <figcaption><span>--ks-lift-{l}</span></figcaption>
            </figure>
          ))}
        </div>
        <p class="ks-note">Lift one is a raised card or a thumb. Lift two is a popover or a modal. Nothing else casts a shadow.</p>
      </div>

      <div class="ks-subsection">
        <span class="ks-subsection-label">Rhythm and motion</span>
        <dl class="ks-anatomy">
          <div><dt>Section</dt><dd>110px of vertical padding inside a 1320px column with 56px gutters, a 1px <code>--ks-rule</code> between sections.</dd></div>
          <div><dt>Subsection</dt><dd>56px above, with the mono label 22px above its content.</dd></div>
          <div><dt>Bento</dt><dd>Tiles on a 12-column grid with an 8px gutter that shows the rail through.</dd></div>
          <div><dt>Motion</dt><dd><code>--ks-quick</code> (<span data-token-value="--ks-quick"></span>) for a state change, <code>--ks-settle</code> (<span data-token-value="--ks-settle"></span>) for something arriving, one ease: <code data-token-value="--ks-ease"></code>.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script>
      // Token display: read live values from kinpaku-tokens.css and write them
      // into the swatch and type spec elements. If a token changes there, this
      // page shows the new value on the next load without anyone editing prose.
      (() => {
        const root = getComputedStyle(document.documentElement);
        const read = (name) => root.getPropertyValue(name).trim();
        const familyName = (cssValue) =>
          cssValue.replace(/["']/g, '').split(',')[0].trim();

        document.querySelectorAll('[data-token-value]').forEach((el) => {
          const value = read(el.getAttribute('data-token-value'));
          if (value) el.textContent = value;
        });

        const scaleFamily = {
          wordmark: 'font-wordmark',
          eyebrow: 'mono',
          mono: 'mono',
        };
        const scaleWeight = { title: '', body: '400', eyebrow: '400', mono: '400', wordmark: '400' };

        document.querySelectorAll('[data-type-scale]').forEach((el) => {
          const scale = el.getAttribute('data-type-scale');
          const family = familyName(read('--ks-' + (scaleFamily[scale] || 'font')));
          const size = read(`--ks-type-${scale}-size`);
          const weight = read(`--ks-type-${scale}-weight`) || scaleWeight[scale] || '';
          const line = read(`--ks-type-${scale}-line`);
          const track = read(`--ks-type-${scale}-track`);
          const parts = [family];
          if (weight) parts.push(`weight ${weight}`);
          if (size) parts.push(`size ${size}`);
          if (line) parts.push(`line ${line}`);
          if (track) parts.push(`tracking ${track}`);
          el.textContent = parts.join(' · ');
        });
      })();

      // Tabs, the instrument strip and the segmented control all flip one
      // attribute on click. The kit styles the attribute; nothing here paints.
      document.querySelectorAll('[data-ks-tabs]').forEach((tabs) => {
        const controls = Array.from(tabs.querySelectorAll('[role="tab"]'));
        const panels = Array.from(tabs.querySelectorAll('[role="tabpanel"]'));
        controls.forEach((control) => {
          control.addEventListener('click', () => {
            controls.forEach((item) => item.setAttribute('aria-selected', String(item === control)));
            panels.forEach((panel) => {
              panel.hidden = panel.id !== control.getAttribute('aria-controls');
            });
          });
        });
      });

      document.querySelectorAll('[data-ks-strip]').forEach((strip) => {
        const keys = Array.from(strip.querySelectorAll('[role="tab"]'));
        keys.forEach((key) => {
          key.addEventListener('click', () => {
            keys.forEach((item) => {
              const on = item === key;
              item.setAttribute('aria-selected', String(on));
              item.classList.toggle('is-active', on);
            });
          });
        });
      });

      document.querySelectorAll('[data-ks-segmented]').forEach((group) => {
        const buttons = Array.from(group.querySelectorAll('button'));
        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          });
        });
      });
    </script>
  </Fragment>
</Base>
