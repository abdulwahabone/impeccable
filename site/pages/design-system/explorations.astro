---
import Base from '../../layouts/Base.astro';
import '../../styles/design-system.css';
---

<Base
  title="Impeccable Design System · Explorations"
  description="The Neo Kinpaku hero and mark explorations were retired with the move to the paper system."
  canonicalPath="/design-system/explorations"
  bodyClass="kinpaku-system-page kinpaku-chrome kinpaku-surface"
  mainId="design-system-explorations"
  mainClass="kinpaku-system"
  hideHeader={true}
  noIndex={true}
>
  <section class="ks-hero" aria-labelledby="explorations-title">
    <header class="ks-topbar" aria-label="Design system navigation">
      <a class="ks-brand" href="/" aria-label="Impeccable home">
        <span class="ks-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M5 2.5 L13.5 2.5 L5.5 21.5 L5 21.5 Q2.5 21.5 2.5 19 L2.5 5 Q2.5 2.5 5 2.5 Z"/>
            <path d="M16.5 2.5 L19 2.5 Q21.5 2.5 21.5 5 L21.5 19 Q21.5 21.5 19 21.5 L8.5 21.5 Z"/>
          </svg>
        </span>
        <span class="ks-wordmark">IMPECCABLE</span>
      </a>
      <nav class="ks-nav" aria-label="Design system sections">
        <a href="/design-system">Design system</a>
      </nav>
    </header>

    <div class="ks-hero-body">
      <p class="ks-section-eyebrow">Explorations</p>
      <h1 id="explorations-title">Retired.</h1>
      <p class="ks-hero-line">This page held the hero candidates and mark studies for the dark Neo Kinpaku system: kintsugi seams, gold-leaf textures, a roster test for three marks. The site moved to a single paper system in September 2026 and the carved-tile mark won, so the gallery came down. What ships is on <a href="/design-system">/design-system</a>.</p>
    </div>
  </section>
</Base>
