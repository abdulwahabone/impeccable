---
// Dev-only lab: exercises the REAL serve-question.mjs from this repo's
// materialized skill/ against scenario fixtures, one temp cwd per run. Not a
// replica: link a sibling checkout (IMPECCABLE_SKILL_SRC=../impeccable
// node scripts/fetch-public-skill.mjs --refresh) and uncommitted skill edits
// render here immediately.
if (!import.meta.env.DEV) return Astro.redirect('/');

import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import '../../styles/sub-pages.css';

const ROOT = process.cwd();
const FIXTURES = path.join(ROOT, 'site', 'labs-fixtures', 'decision');
const scenarios = fs.readdirSync(FIXTURES).filter((f) => f.endsWith('.json')).sort().map((file) => {
  const payload = JSON.parse(fs.readFileSync(path.join(FIXTURES, file), 'utf8'));
  return {
    name: file.replace(/\.json$/, ''),
    title: payload._lab?.title || file,
    description: payload._lab?.description || '',
    cards: (payload.options || []).length + (payload.canonCard ? 1 : 0),
  };
});
const skillSource = (() => {
  try { return JSON.parse(fs.readFileSync(path.join(ROOT, '.skill-source.json'), 'utf8')); } catch { return null; }
})();
const skillLinked = Boolean(skillSource?.linked);
---

<Base
  title="Decision Lab | Impeccable"
  description="Exercise the serve-question decision page across scenarios without running a greenfield flow."
  activeNav="docs"
  bodyClass="sub-page kinpaku-chrome kinpaku-surface"
>
  <main class="decision-lab">
    <header>
      <p class="dl-kicker"><a href="/labs/">Labs</a> · Decision page</p>
      <h1>The direction round, on demand</h1>
      <p class="dl-dek">
        Each scenario starts the real <code>serve-question.mjs</code> from this repo's
        <code>skill/</code> in its own temp cwd, opens the live page, and lets you walk
        the whole loop: pick, re-roll, steer, collect the ANSWER an agent would read.
      </p>
      <p class={`dl-source ${skillLinked ? 'is-linked' : ''}`}>
        skill source: <strong>{skillSource ? (skillLinked ? 'linked checkout (edits reflect live)' : skillSource.source) : 'not materialized'}</strong>
        {!skillLinked && <span> · for live co-development: <code>IMPECCABLE_SKILL_SRC=../impeccable node scripts/fetch-public-skill.mjs --refresh</code></span>}
      </p>
    </header>

    <ul class="dl-scenarios">
      {scenarios.map((scenario) => (
        <li class="dl-scenario" data-scenario={scenario.name}>
          <div class="dl-scenario-copy">
            <h2>{scenario.title}</h2>
            <p>{scenario.description}</p>
            <p class="dl-meta">{scenario.name}.json · {scenario.cards} cards</p>
          </div>
          <div class="dl-actions">
            <button type="button" data-start>Open</button>
            <button type="button" data-collect disabled>Collect answer</button>
            <button type="button" data-stop disabled>Stop</button>
          </div>
          <pre class="dl-out" hidden></pre>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .decision-lab { max-width: 56rem; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
  .dl-kicker { font-family: var(--ks-mono); font-size: 0.6875rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ks-text-faint); }
  .dl-kicker a { color: inherit; }
  .decision-lab h1 { margin: 0.4rem 0 0.6rem; }
  .dl-dek { color: var(--ks-text-muted); max-width: 44rem; }
  .dl-source { font-family: var(--ks-mono); font-size: 0.6875rem; color: var(--ks-text-faint); margin-top: 0.8rem; }
  .dl-source.is-linked strong { color: var(--ks-patina); }
  .dl-scenarios { list-style: none; margin: 2rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .dl-scenario { border: 1px solid var(--ks-rule); border-radius: 10px; padding: 1.1rem 1.25rem; display: grid; grid-template-columns: 1fr auto; gap: 0.4rem 1.25rem; align-items: center; background: var(--ks-lacquer-raised); }
  .dl-scenario h2 { font-size: 1.05rem; margin: 0 0 0.25rem; }
  .dl-scenario-copy p { margin: 0; color: var(--ks-text-muted); font-size: 0.9rem; }
  .dl-meta { font-family: var(--ks-mono); font-size: 0.625rem; letter-spacing: 0.08em; color: var(--ks-text-faint); margin-top: 0.4rem !important; }
  .dl-actions { display: flex; gap: 0.5rem; }
  .dl-actions button { font-family: var(--ks-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.5rem 0.9rem; border-radius: 6px; border: 1px solid var(--ks-rule); background: transparent; color: var(--ks-kinpaku); cursor: pointer; }
  .dl-actions button:hover:not([disabled]) { border-color: var(--ks-kinpaku-deep); }
  .dl-actions button[disabled] { opacity: 0.35; cursor: default; }
  .dl-out { grid-column: 1 / -1; margin: 0.6rem 0 0; padding: 0.8rem 1rem; border-radius: 8px; background: var(--ks-lacquer); border: 1px solid var(--ks-rule); font-size: 0.72rem; line-height: 1.5; white-space: pre-wrap; overflow-x: auto; max-height: 18rem; overflow-y: auto; }
</style>

<script>
  const api = (route, body) => fetch(`/labs/decision/api/${route}`, {
    method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body),
  }).then((r) => r.json());

  document.querySelectorAll('.dl-scenario').forEach((row) => {
    const scenario = row.dataset.scenario;
    const startBtn = row.querySelector('[data-start]');
    const collectBtn = row.querySelector('[data-collect]');
    const stopBtn = row.querySelector('[data-stop]');
    const out = row.querySelector('.dl-out');
    let key = null;
    const log = (text) => { out.hidden = false; out.textContent = text; };

    startBtn.addEventListener('click', async () => {
      startBtn.disabled = true;
      const started = await api('start', { scenario });
      startBtn.disabled = false;
      if (!started.url) { log(`start failed: ${started.error}\n${started.detail || ''}`); return; }
      key = started.key;
      collectBtn.disabled = stopBtn.disabled = false;
      log(`running · key ${key}\n${started.url}`);
      window.open(started.url, '_blank');
    });
    collectBtn.addEventListener('click', async () => {
      if (!key) return;
      collectBtn.disabled = true;
      const collected = await api('collect', { key });
      collectBtn.disabled = false;
      log(collected.out || `exit ${collected.code}`);
      // Exit 0 is a terminal answer; re-roll and followup keep the table open.
      if (collected.code === 0 && !/keeps the table open|FOLLOWUP OPEN|REGISTER:/.test(collected.out || '')) {
        if (/"optionId":"reroll"|followup":true/.test(collected.out || '')) return;
        stopBtn.disabled = collectBtn.disabled = true;
        key = null;
      }
    });
    stopBtn.addEventListener('click', async () => {
      if (!key) return;
      await api('stop', { key });
      log('stopped');
      key = null;
      collectBtn.disabled = stopBtn.disabled = true;
    });
  });
</script>
