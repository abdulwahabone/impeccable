---
// Dev-only lab: never render (or inline catalog data) in a production build.
if (!import.meta.env.DEV) return Astro.redirect('/');

import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import '../../styles/sub-pages.css';
import '../../styles/worlds-lab.css';
import { conceptContentHash } from '../../../skill/scripts/lib/concept-catalog.mjs';
import { siteSlug } from '../../../scripts/lib/site-queue.mjs';
import { STRATEGIES } from '../../../scripts/lib/site-world-prompt.mjs';

const ROOT = process.cwd();
const catalog = JSON.parse(fs.readFileSync(path.join(ROOT, 'catalog', 'concept-ingredients.json'), 'utf8'));
const reviewData = JSON.parse(fs.readFileSync(path.join(ROOT, 'catalog', 'concept-reviews.json'), 'utf8'));
const reviews = reviewData.reviews || {};
// Field telemetry: the committed snapshot scripts/pull-telemetry.mjs writes
// from Workers Analytics Engine. An absent snapshot renders as "no field
// data"; the lab never queries the network for it.
const telemetrySnapshot = (() => {
  try { return JSON.parse(fs.readFileSync(path.join(ROOT, 'catalog', 'telemetry-snapshot.json'), 'utf8')); } catch { return null; }
})();
const telemetryFor = (id) => {
  if (!telemetrySnapshot) return null;
  const long = telemetrySnapshot.windows?.['90d']?.ids?.[id];
  const short = telemetrySnapshot.windows?.['30d']?.ids?.[id];
  if (!long && !short) return null;
  return {
    dealt: long?.dealt || 0,
    chosen: long?.chosen || 0,
    dealt30: short?.dealt || 0,
    chosen30: short?.chosen || 0,
  };
};
const CARD_DIR = path.join(ROOT, 'site', 'public', 'worlds', 'cards');
const cardManifest = (() => {
  try { return JSON.parse(fs.readFileSync(path.join(CARD_DIR, 'manifest.json'), 'utf8')); } catch { return {}; }
})();
// Cards live in R2 in production (functions/worlds/cards). A local generation
// output is preferred when present; a clone without local cards falls back to
// the published set so the lab still shows them.
const PROD_CARDS_BASE = 'https://impeccable.style/worlds/cards';
const cardFor = concept => {
  const row = cardManifest[concept.id];
  const localExists = fs.existsSync(path.join(CARD_DIR, `${concept.id}.webp`));
  if (!localExists && !row) return null;
  // Cards are regenerated under the same filename, so the URL carries the
  // generation timestamp: browsers and CDNs refetch exactly when a card changes.
  const generated = Date.parse(row?.generatedAt || 0) || 0;
  const base = localExists ? '/worlds/cards' : PROD_CARDS_BASE;
  const heroLocal = fs.existsSync(path.join(CARD_DIR, `${concept.id}-hero.webp`));
  const heroGenerated = Date.parse(row?.heroGeneratedAt || 0) || 0;
  // The docs render answers a question the hero cannot: the hero is a landing
  // page, so a world judged only on it is judged on how well it persuades.
  const docsLocal = fs.existsSync(path.join(CARD_DIR, `${concept.id}-docs.webp`));
  const docsGenerated = Date.parse(row?.docsGeneratedAt || 0) || 0;
  // Variants and which of them is current. The winner already lives at the
  // canonical filename, so the three sources below are the alternatives a
  // reviewer chooses between rather than a separate set to keep in sync.
  const variantsFor = kind => {
    const suffix = { board: '', hero: '-hero', docs: '-docs' }[kind];
    return (row?.variants?.[kind] || []).map(variant => ({
      variant,
      src: `${localExists ? '/worlds/cards' : PROD_CARDS_BASE}/${concept.id}${suffix}-${variant}.webp?v=${generated.toString(36)}`,
      current: row?.[`${kind}Winner`] === variant,
    }));
  };
  return {
    variants: { board: variantsFor('board'), hero: variantsFor('hero'), docs: variantsFor('docs') },
    docsSrc: (docsLocal || row?.docsGeneratedAt)
      ? `${docsLocal ? '/worlds/cards' : PROD_CARDS_BASE}/${concept.id}-docs.webp?v=${docsGenerated.toString(36)}`
      : null,
    src: `${base}/${concept.id}.webp?v=${generated.toString(36)}`,
    heroSrc: (heroLocal || row?.heroGeneratedAt)
      ? `${heroLocal ? '/worlds/cards' : PROD_CARDS_BASE}/${concept.id}-hero.webp?v=${heroGenerated.toString(36)}`
      : null,
    stale: row?.hash !== conceptContentHash(concept),
  };
};
const wellsById = new Map((catalog.wells || []).map(well => [well.id, well]));
const families = catalog.families.map(family => ({
  id: family.id,
  label: family.label,
  description: family.description,
  wellId: family.well,
  wellLabel: wellsById.get(family.well)?.label || '',
  concepts: family.concepts.map(concept => ({
    ...concept,
    card: cardFor(concept),
    familyId: family.id,
    familyLabel: family.label,
    wellId: family.well,
    wellLabel: wellsById.get(family.well)?.label || '',
    // Tier drives the challenger draw and the coverage view's lineage grid, and
    // was the one well property the payload never carried.
    wellTier: wellsById.get(family.well)?.tier || null,
    status: reviews[concept.id]?.status || 'pending',
    review: reviews[concept.id] || null,
    telemetry: telemetryFor(concept.id),
  })),
}));
const wellGroups = (catalog.wells || [])
  .map(well => ({ well, families: families.filter(family => family.wellId === well.id) }))
  .filter(group => group.families.length > 0);
const concepts = families.flatMap(family => family.concepts);
const initialConcept = concepts.find(concept => concept.status === 'pending') || concepts[0];
const counts = {
  total: concepts.length,
  approved: concepts.filter(concept => concept.status === 'approved').length,
  pending: concepts.filter(concept => concept.status === 'pending').length,
  rejected: concepts.filter(concept => concept.status === 'rejected').length,
};
counts.reviewed = counts.approved + counts.rejected;
// One line per concept and one rail block; formatting lives here so the
// client script and the server render agree on the shape.
// The share of dealt worlds that get reported back at all, across the whole
// catalog. Every per-world rate has to be read against this and not against
// 100%: a world chosen 98 times out of 21,361 looks like a rout until you know
// the field average is 0.09%, at which point it is five times the average and
// one of the best performers in the catalog.
const FIELD_BASE_RATE = (() => {
  const ids = telemetrySnapshot?.windows?.['90d']?.ids;
  if (!ids) return null;
  let dealt = 0;
  let chosen = 0;
  for (const row of Object.values(ids)) { dealt += row.dealt || 0; chosen += row.chosen || 0; }
  return dealt > 0 ? chosen / dealt : null;
})();

const telemetryLine = (t) => {
  if (!t) return 'no field data';
  // Expressed as a multiple of the field average rather than a raw percentage.
  // A raw percentage invites reading it as a win rate, which it is not: most
  // rolls never report a choice at all, so the denominator counts appearances
  // and the numerator counts the small fraction anyone told us about.
  const index = FIELD_BASE_RATE && t.dealt
    ? ` · ${(t.chosen / t.dealt / FIELD_BASE_RATE).toFixed(1)}x field average`
    : '';
  // Below about twenty reports the rate is mostly Poisson noise and should not
  // be ranked on, so it says so instead of implying precision it does not have.
  const thin = t.chosen < 20 ? ' · too few to rank' : '';
  return `dealt ${t.dealt.toLocaleString()} · reported ${t.chosen}${index}${thin}`;
};
const telemetrySummary = telemetrySnapshot ? (() => {
  const w = telemetrySnapshot.windows?.['90d'] || {};
  const kinds = w.kinds || {};
  const kindTotal = Object.values(kinds).reduce((sum, n) => sum + Number(n), 0);
  return {
    rolls: w.totals?.rolls || 0,
    chosen: w.totals?.chosen || 0,
    kindLine: kindTotal > 0
      ? ['assigned', 'pick', 'challenger', 'canon'].filter(kind => kinds[kind]).map(kind => `${kind} ${Math.round((kinds[kind] / kindTotal) * 100)}%`).join(' · ')
      : null,
    registerLine: Object.keys(w.registers || {}).length
      ? `steers: ${Object.entries(w.registers).map(([register, n]) => `${register} ${n}`).join(' · ')}`
      : null,
    // Stated because every per-world number is a fraction of this, not of 100.
    reportRate: w.totals?.rolls ? ((w.totals.chosen / w.totals.rolls) * 100).toFixed(1) : '0',
    date: (telemetrySnapshot.generatedAt || '').slice(0, 10),
  };
})() : null;
const aestheticAxes = JSON.parse(fs.readFileSync(path.join(ROOT, 'catalog', 'aesthetic-axes.json'), 'utf8'));
// Absent on a fresh clone, and an absent queue is an empty one rather than an error.
const siteQueue = (() => {
  try {
    const sites = JSON.parse(fs.readFileSync(path.join(ROOT, 'catalog', 'site-queue.json'), 'utf8')).sites || [];
    // A candidate that has been rendered gets its source and its world attached,
    // so the judgement can happen here instead of in a file browser.
    return sites.map(site => {
      try {
        const slug = siteSlug(site.url);
        const dir = path.join(ROOT, '.waves', 'site-worlds', slug);
        if (!fs.existsSync(path.join(dir, 'world.webp'))) return site;
        const files = fs.readdirSync(dir);
        const refs = files.filter(f => /^ref-\d+\.png$/.test(f)).sort();
        // A candidate drawn under several strategies offers a choice; one drawn
        // under the old single prompt has none, and both have to render.
        const variants = files
          .map(f => (f.match(/^world-([a-z]+)\.webp$/) || [])[1])
          .filter(Boolean)
          .map(id => ({
            id,
            label: STRATEGIES[id]?.label || id,
            note: STRATEGIES[id]?.note || '',
            src: `/__impeccable/site-worlds/${slug}/world-${id}.webp`,
          }));
        return {
          ...site,
          render: {
            world: `/__impeccable/site-worlds/${slug}/world.webp`,
            refs: refs.map(f => `/__impeccable/site-worlds/${slug}/${f}`),
            variants,
          },
        };
      } catch {
        return site;
      }
    });
  } catch {
    return [];
  }
})();

const pageData = JSON.stringify({
  catalogVersion: catalog.catalogVersion,
  canWrite: import.meta.env.DEV,
  families,
  aestheticAxes,
  siteQueue,
  fieldBaseRate: FIELD_BASE_RATE,
}).replace(/</g, '\\u003c');
---

<!-- DIRECTION CONTRACT: THESIS: Turn an abstract challenger corpus into a human-governed editorial queue that rejects the tiled catalog and admin-dashboard defaults; one vivid world earns focused attention and proves its durable web structure. OWN-WORLD: Lacquer, kinpaku commitment, patina state, neutral hairlines, compact Albert Sans UI. STORY: Find pending work, picture the world immediately, judge whether its material and spatial laws become a real web system, decide, and advance the trusted pool. FIRST VIEWPORT: Well/progress rail, searchable queue, and one full-height review stage with keyboard-visible actions. BAR-RAISER: Every concept exposes an unforgettable scene, reusable system grammar, and browser-native leverage before approval. FORM: A catalog editor crossed with a contact-sheet loupe; hundreds of entries collapse into one precise judgment. UNIQUE: The review stage is a single editorial loupe with a folio counter (Catalog 001 of N), a lineage margin, and Option-chord decisions that write straight to source JSON; the queue lives in a side rail and never becomes the page. NOT-TEMPLATE: No tiled card grid, no stat-hero band, no modal-per-decision; aggregate numbers stay confined to the rail's progress block and the stage never shows more than one world. Seed key: not run; structure inherits the established Detector Lab. -->
<Base
  title="World Catalog | Impeccable"
  description="Browse and review the concept forms that challenge grounded Impeccable design directions."
  bodyClass="sub-page worlds-lab-page"
  mainClass="worlds-main-shell"
  noIndex
  hideHeader
  hideFooter
>
  <section class="worlds-workbench" aria-label="Concept world catalog">
    <nav class="worlds-skip-links" aria-label="Catalog shortcuts">
      <a href="#worlds-search">Skip to search</a>
      <a href="#worlds-review">Skip to review</a>
    </nav>
    <aside class="worlds-family-rail" aria-label="Catalog families and review status">
      <div class="worlds-rail-head">
        <a class="worlds-home-link ks-brand" href="/" aria-label="Back to Impeccable">
          <span class="ks-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M5 2.5 L13.5 2.5 L5.5 21.5 L5 21.5 Q2.5 21.5 2.5 19 L2.5 5 Q2.5 2.5 5 2.5 Z"></path>
              <path d="M16.5 2.5 L19 2.5 Q21.5 2.5 21.5 5 L21.5 19 Q21.5 21.5 19 21.5 L8.5 21.5 Z"></path>
            </svg>
          </span>
          <span class="ks-wordmark">Impeccable</span>
        </a>
        <div class="worlds-title-lockup">
          <h1>World catalog</h1>
        </div>

        <nav class="worlds-catalog-switch" aria-label="Catalog">
          <a href="/labs/worlds" aria-current="page">Worlds</a>
          <a href="/labs/compositions">Compositions</a>
        </nav>

        <div class="worlds-progress-block">
          <div class="worlds-progress-copy">
            <span>Human reviewed</span>
            <strong data-progress-percent>{Math.round((counts.reviewed / counts.total) * 100)}%</strong>
          </div>
          <div class="worlds-progress-track" role="progressbar" aria-label="Catalog review progress" aria-valuemin="0" aria-valuemax={counts.total} aria-valuenow={counts.reviewed} data-progress-track>
            <span style={`--worlds-progress: ${(counts.reviewed / counts.total) * 100}%`} data-progress-fill></span>
          </div>
          <div class="ks-segmented ks-segmented--wrap ks-segmented--dense worlds-rail-group" role="group" aria-label="Filter concepts by review status">
            <button type="button" data-status-filter="pending" aria-pressed="true">Backlog<b data-count-pending>{counts.pending}</b></button>
            <button type="button" data-status-filter="approved" aria-pressed="false">Approved<b data-count-approved>{counts.approved}</b></button>
            <button type="button" data-status-filter="rejected" aria-pressed="false">Rejected<b data-count-rejected>{counts.rejected}</b></button>
            <button type="button" data-status-filter="all" aria-pressed="false">All<b data-count-total>{counts.total}</b></button>
          </div>
        </div>
      </div>

      <!-- Rating, reach and tier are qualities OF an approved world rather than
           statuses beside it, which is why "unrated" used to sit oddly next to
           "rejected" as though they were the same kind of thing. Grouped here
           they compose: approved plus three stars plus pro is one query. -->
      <div class="worlds-filter-section">
        <span class="worlds-filter-heading">Refine approved</span>
        <div class="worlds-refine" role="group" aria-label="Filter approved worlds by rating, reach, and tier">
          <div class="worlds-refine-row" role="group" aria-label="Rating">
            <span>Rating</span>
            <div class="ks-segmented ks-segmented--dense">
              <button type="button" data-rating-filter="all" aria-pressed="true">Any</button>
              <button type="button" data-rating-filter="unrated" aria-pressed="false" title="Approved, no star rating yet">None</button>
              {[1, 2, 3].map(value => (
                <button type="button" data-rating-filter={String(value)} aria-pressed="false" title={`${value} star`}>{'★'.repeat(value)}</button>
              ))}
            </div>
          </div>
          <div class="worlds-refine-row" role="group" aria-label="Reach">
            <span>Reach</span>
            <div class="ks-segmented ks-segmented--dense">
              <button type="button" data-reach-filter="all" aria-pressed="true">Any</button>
              <button type="button" data-reach-filter="general" aria-pressed="false" title="Drawn by challenger rolls">General</button>
              <button type="button" data-reach-filter="niche" aria-pressed="false" title="Held out of challenger draws">Niche</button>
            </div>
          </div>
          <div class="worlds-refine-row" role="group" aria-label="Tier">
            <span>Tier</span>
            <div class="ks-segmented ks-segmented--dense">
              <button type="button" data-tier-filter="all" aria-pressed="true">Any</button>
              <button type="button" data-tier-filter="free" aria-pressed="false" title="Dealt by the free roll">Free</button>
              <button type="button" data-tier-filter="pro" aria-pressed="false" title="Reserved for Pro, withheld from the free roll">Pro</button>
            </div>
          </div>
        </div>
      </div>

      <div class="worlds-filter-section">
        <span class="worlds-filter-heading">Eligible for mode</span>
        <div class="ks-segmented ks-segmented--wrap ks-segmented--dense worlds-rail-group" role="group" aria-label="Filter concepts by the mode they can carry">
          <button type="button" data-mode-filter="all" aria-pressed="true">Any<b data-mode-count="all">0</b></button>
          <button type="button" data-mode-filter="unscoped" aria-pressed="false" title="Worlds nobody has narrowed, so they are eligible in every mode">Every<b data-mode-count="unscoped">0</b></button>
          {['persuade', 'operate', 'read', 'experience'].map(value => (
            <button type="button" data-mode-filter={value} aria-pressed="false" title={`Worlds a ${value} build can draw from, narrowed or not`}>
              {value.charAt(0).toUpperCase() + value.slice(1)}<b data-mode-count={value}>0</b>
            </button>
          ))}
          <button type="button" data-mode-filter="scoped" aria-pressed="false" title="Only worlds whose eligibility someone has narrowed">Narrowed<b data-mode-count="scoped">0</b></button>
        </div>
      </div>

      <label class="worlds-family-search worlds-rail-divide">
        <span>Find a family</span>
        <input type="search" placeholder={`Filter ${catalog.families.length} families`} autocomplete="off" data-family-search>
      </label>
      <nav class="worlds-family-scroll" aria-label="Concept families">
        <button type="button" class="worlds-family-button" data-family-filter="all" aria-pressed="true">
          <span>All families</span>
          <span data-family-count="all">{counts.pending}</span>
        </button>
        {wellGroups.map(group => (
          <>
            <p class="worlds-well-heading" data-well-heading={group.well.id} hidden>{group.well.label}</p>
            {group.families.map(family => (
              <button type="button" class="worlds-family-button" data-family-filter={family.id} data-family-well={group.well.id} data-family-label={`${family.label} ${group.well.label}`.toLowerCase()} aria-pressed="false" tabindex="-1" hidden>
                <span>{family.label}</span>
                <span data-family-count={family.id}>{family.concepts.filter(concept => concept.status === 'pending').length}</span>
              </button>
            ))}
          </>
        ))}
        <p class="worlds-family-empty" data-family-empty hidden>No families match.</p>
        <button type="button" class="worlds-family-expand" data-family-expand aria-expanded="false">
          Browse all {families.length} families
        </button>
      </nav>

      <!-- Field telemetry is reference, not a control. It used to sit between
           the status filters and the mode filters, so a stack that reads as
           "ways to narrow the list" had a paragraph of usage stats in the
           middle of it. Pinned to the foot of the rail it stays glanceable and
           stops interrupting the one thing the rail is for.

           The counts are also easy to misread, so the rate is stated against
           its own base rather than left to look like a win rate. See
           docs/WORLD-CATALOG-AUTHORING.md on reading field telemetry. -->
      {telemetrySummary && (
        <footer class="worlds-telemetry-foot" aria-label="Field telemetry from the roll API">
          <p>
            <span>Field · 90d</span>
            <strong>{telemetrySummary.rolls.toLocaleString()} rolls</strong>
          </p>
          <p class="is-muted">
            {telemetrySummary.chosen.toLocaleString()} reported back ({telemetrySummary.reportRate}% of rolls)
          </p>
          {telemetrySummary.kindLine && <p class="is-muted">{telemetrySummary.kindLine}</p>}
          <p class="is-muted">snapshot {telemetrySummary.date}</p>
        </footer>
      )}
    </aside>

    <div class="worlds-workspace">
      <header class="worlds-toolbar">
        <label class="worlds-search">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="m15.5 15.5 5 5"></path>
          </svg>
          <input id="worlds-search" type="search" aria-label="Search concepts" placeholder="Search forms, systems, lineage, or IDs" autocomplete="off" data-search>
          <kbd>/</kbd>
        </label>
        <!-- Page-level views, so they sit in page-level chrome. They used to
             live in the concept header beside its breadcrumb and ID, which read
             as belonging to the world rather than switching what the page is. -->
        <div class="ks-segmented worlds-view-toggle" role="group" aria-label="What this page shows" data-view-toggle>
          <button type="button" data-view="detail" aria-pressed="true" title="Review the catalog">Review</button>
          <button type="button" data-view="coverage" aria-pressed="false" title="Where the catalog is crowded and where it is open">Coverage</button>
          <button type="button" data-view="sites" aria-pressed="false" title="Real pages queued to derive a world from">Sites</button>
          <button type="button" data-view="triage" aria-pressed="false" title="Pick a winner for every rendered variant">Variants</button>
        </div>
        <!-- Only shown when it says something a reader cannot already infer.
             In dev the whole point of the page is that it writes, so a permanent
             badge announcing it is noise; read-only is worth saying. -->
        <div class="worlds-runtime-state" hidden={import.meta.env.DEV}>
          <span aria-hidden="true"></span>
          <div>
            <strong>Read-only catalog</strong>
            <small>Run bun run dev to review</small>
          </div>
        </div>
      </header>

      <div class="worlds-workspace-grid">
        <aside class="worlds-queue" aria-label="Filtered concept queue">
          <!-- One line, not three. "Review queue" over "Backlog" over a floating
               count spent 88px of a rail on saying the same thing three ways,
               and the bucket name already tells you which queue this is. -->
          <header class="worlds-queue-head">
            <h2 class="worlds-queue-title">
              <strong data-queue-title>Backlog</strong>
            </h2>
            <div class="worlds-queue-head-tools">
              <!-- Sort belongs to the list, not the rail: the rail decides which
                   worlds are in the set, this decides what order you meet them
                   in. Popularity is the field index, so it ranks by how a world
                   does against the field average rather than by raw reports,
                   which would just rank by how often the roll happened to deal
                   it. -->
              <div class="ks-segmented ks-segmented--dense worlds-queue-sort" role="group" aria-label="Sort the queue" data-sort-group>
                <!-- Numbered rules, not plain ones: the view control two
                     buttons along is also three horizontal lines, and two
                     adjacent switches whose first glyph is identical is how you
                     get someone changing the sort when they meant the view. -->
                <button type="button" data-sort="catalog" aria-pressed="true" title="Catalog order">
                  <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M6 4h8M6 8h8M6 12h8"></path>
                    <path d="M2 3.2v2.4M1.4 3.4l.8-.6M1.4 12.6h1.7M1.4 10.8a.9.9 0 0 1 1.7.4c0 .8-1.7 1-1.7 1.4" stroke-width="1.2"></path>
                  </svg>
                  <span class="worlds-sr">Catalog order</span>
                </button>
                <button type="button" data-sort="rating" aria-pressed="false" title="Rating, best first">
                  <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
                    <path d="M8 1.6l1.8 3.9 4.2.5-3.1 2.9.8 4.2L8 11l-3.7 2.1.8-4.2L2 6l4.2-.5z"></path>
                  </svg>
                  <span class="worlds-sr">Rating, best first</span>
                </button>
                <button type="button" data-sort="popularity" aria-pressed="false" title="Popularity, best first">
                  <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M2 12l3.5-4 3 2.5L13 4"></path><path d="M9.5 4H13v3.5"></path>
                  </svg>
                  <span class="worlds-sr">Popularity, best first</span>
                </button>
              </div>
              <!-- These present the queue, so they live on the queue. As a
                   page-level tab row they read as switching what the page is,
                   which is why "cards" seemed to throw the detail view away. -->
              <div class="ks-segmented ks-segmented--dense worlds-queue-view" role="group" aria-label="How the queue is shown">
                <button type="button" data-view="detail" aria-pressed="true" title="One at a time, with the full stage (V)" aria-keyshortcuts="v">
                  <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M2 4h12M2 8h12M2 12h8"></path>
                  </svg>
                  <span class="worlds-sr">List</span>
                </button>
                <button type="button" data-view="cards" aria-pressed="false" title="Every filtered concept as a contact sheet (V)" aria-keyshortcuts="v">
                  <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="2" width="5" height="5"></rect><rect x="9" y="2" width="5" height="5"></rect>
                    <rect x="2" y="9" width="5" height="5"></rect><rect x="9" y="9" width="5" height="5"></rect>
                  </svg>
                  <span class="worlds-sr">Contact sheet</span>
                </button>
              </div>
            </div>
          </header>
          <div class="worlds-queue-list" data-queue-list></div>
          <!-- The grid is a second presentation of this same rail, so it lives
               inside it and swaps with the list. It used to sit in the stage,
               where choosing it replaced the world under review with a wall of
               five hundred thumbnails: the control said "how the queue is
               shown" and then changed what the page was about. -->
          <div class="worlds-card-grid" data-card-grid hidden>
            <p class="worlds-card-grid-empty" data-card-grid-empty hidden>No concepts match.</p>
            <div class="worlds-card-grid-items" data-card-grid-items></div>
          </div>
          <footer class="worlds-queue-foot">
            <span data-window-label>Loading catalog…</span>
            <div>
              <button type="button" aria-label="Previous concept" data-previous aria-keyshortcuts="ArrowUp K"><kbd>↑</kbd><kbd>K</kbd></button>
              <button type="button" aria-label="Next concept" data-next aria-keyshortcuts="ArrowDown J"><kbd>↓</kbd><kbd>J</kbd></button>
            </div>
          </footer>
        </aside>

        <article id="worlds-review" class="worlds-review-stage" aria-labelledby="current-concept-form" tabindex="-1">
          <header class="worlds-review-head">
            <div class="worlds-review-context">
              <div class="worlds-review-path">
              <span data-concept-well>{initialConcept.wellLabel}</span>
              <span aria-hidden="true">/</span>
              <span data-concept-family>{initialConcept.familyLabel}</span>
              <span aria-hidden="true">/</span>
                <code data-concept-id>{initialConcept.id}</code>
              </div>
              <div class="worlds-review-glance">
              <span class="worlds-review-folio">Catalog <strong data-concept-position>{String(concepts.findIndex(concept => concept.id === initialConcept.id) + 1).padStart(3, '0')}</strong> / {counts.total.toLocaleString()}</span>
              <span class={`worlds-status-badge is-${initialConcept.status}`} data-concept-status>{initialConcept.status}</span>
              {telemetrySnapshot && <span class="worlds-telemetry-badge" data-concept-telemetry title="Field telemetry, 90-day window. Not a win rate: only about 1 roll in 120 reports a choice at all, so this is measured against the field average rather than against 100%.">{telemetryLine(initialConcept.telemetry)}</span>}
              <button type="button" class="worlds-edit-button" data-edit-toggle disabled={!import.meta.env.DEV} title="Edit this concept's source">
                Edit <kbd>E</kbd>
              </button>
            </div>
            </div>
            <!--
              Everything in this band writes to the catalog on disk, and the line
              above it is read-only. That difference used to be invisible: an
              APPROVED badge and a NICHE toggle were both bordered pills, four
              modes in a flush row read as a tab bar, and the rail's filters
              looked the same again while only changing what you see.

              Three things carry the distinction now. The band is its own
              surface, so writable controls physically sit on a different plane
              from the facts. Every control has a label, because a bare word in a
              pill is what a static tag looks like and a label beside a control
              is what a field looks like. And the labels are the rail's own
              words, Rating / Reach / Tier, so the same idea is named the same
              way whether you are filtering by it or setting it.
            -->
            <div class="worlds-review-controls" data-review-controls>
              <div class="worlds-field" data-field="rating" hidden={initialConcept.status !== 'approved'}>
                <span class="worlds-field-label" id="worlds-field-rating">Rating</span>
                <div class="worlds-rating" role="group" aria-labelledby="worlds-field-rating" data-rating-group>
                  {[1, 2, 3].map(value => (
                    <button
                      type="button"
                      data-rating-option={value}
                      aria-pressed={String((initialConcept.review?.rating || 0) >= value)}
                      disabled={!import.meta.env.DEV}
                      title={value === 3 ? 'Exceptional: flagship-grade world (press 3)' : value === 2 ? 'Solid approved world (press 2)' : 'Marginal keep (press 1)'}
                    >★</button>
                  ))}
                </div>
              </div>

              <!-- Two states named, rather than one state offered. "Niche" alone
                   made the reviewer infer both that it was pressable and what
                   the other state was called; General | Niche says both, and it
                   is why picking the value already set can now be a no-op. -->
              <div class="worlds-field" data-field="reach" hidden={initialConcept.status !== 'approved'}>
                <span class="worlds-field-label" id="worlds-field-reach">Reach</span>
                <div class="ks-segmented ks-segmented--dense worlds-breadth-toggle" role="group" aria-labelledby="worlds-field-reach" data-breadth-toggle>
                  {[
                    { value: 'general', label: 'General', title: 'Drawn by challenger rolls (press N to switch)' },
                    { value: 'niche', label: 'Niche', title: 'Keep the approval but hold this world out of challenger draws (press N)' },
                  ].map(option => (
                    <button
                      type="button"
                      data-breadth-option={option.value}
                      aria-pressed={String((initialConcept.review?.breadth === 'niche' ? 'niche' : 'general') === option.value)}
                      disabled={!import.meta.env.DEV}
                      title={option.title}
                      aria-keyshortcuts="n"
                    >{option.label}</button>
                  ))}
                </div>
              </div>

              <!-- Distribution rather than judgement, so it sits with the other
                   approved-only fields but reads as its own decision. -->
              <div class="worlds-field" data-field="tier" hidden={initialConcept.status !== 'approved'}>
                <span class="worlds-field-label" id="worlds-field-tier">Tier</span>
                <div class="ks-segmented ks-segmented--dense worlds-pro-toggle" role="group" aria-labelledby="worlds-field-tier" data-pro-toggle>
                  {[
                    { value: 'free', label: 'Free', title: 'Dealt by the free roll (press P to switch)' },
                    { value: 'pro', label: 'Pro', title: 'Reserved for Pro: stays approved and stops being dealt by the free roll (press P)' },
                  ].map(option => (
                    <button
                      type="button"
                      data-tier-option={option.value}
                      aria-pressed={String((initialConcept.review?.pro ? 'pro' : 'free') === option.value)}
                      disabled={!import.meta.env.DEV}
                      title={option.title}
                      aria-keyshortcuts="p"
                    >{option.label}</button>
                  ))}
                </div>
              </div>

              <!-- Spaced, not flush, and deliberately not a .ks-segmented track.
                   Flush reads as navigation and spaced reads as a checklist, and
                   these four are an independent multi-select where every one can
                   be on at once: the least tab-like thing on the page was
                   wearing the most tab-like shape. -->
              <div class="worlds-field" data-field="modes" hidden={initialConcept.status !== 'approved'}>
                <span class="worlds-field-label" id="worlds-field-modes">Eligible</span>
                <div class="worlds-modes" role="group" aria-labelledby="worlds-field-modes" data-modes-group>
                  {['persuade', 'operate', 'read', 'experience'].map(value => (
                    <button
                      type="button"
                      class="worlds-mode-option"
                      data-mode-option={value}
                      aria-pressed="true"
                      disabled={!import.meta.env.DEV}
                      title={`Eligible for ${value}. All four on means eligible everywhere, which is the default.`}
                    >{value}</button>
                  ))}
                </div>
              </div>

              <!-- Stays flush, because this one genuinely is a single-select of
                   three and that is what a segmented control is for. It only
                   read as a tab because everything beside it was segmented too. -->
              <div class="worlds-field" data-field="strength">
                <span class="worlds-field-label" id="worlds-field-strength">Strength</span>
                <div class="ks-segmented ks-segmented--dense worlds-strength-toggle" role="group" aria-labelledby="worlds-field-strength" data-strength-toggle>
                  {['world', 'composition', 'dual'].map(value => (
                    <button
                      type="button"
                      data-strength-option={value}
                      aria-pressed={String(initialConcept.strength === value)}
                      disabled={!import.meta.env.DEV}
                      title={value === 'world' ? 'Durable visual identity' : value === 'composition' ? 'Staging idea, dressable in any identity' : 'Identity and staging fused'}
                    >{value}</button>
                  ))}
                </div>
              </div>
            </div>
          </header>

          <div class="worlds-coverage" data-coverage hidden></div>

          <!-- Nine hundred decisions, so the screen holds one of them and nothing
               else: three variants, a number key each, and the next pair the
               instant one is pressed. Anything that costs a second here costs
               a quarter of an hour across the run. -->
          <div class="worlds-triage" data-triage hidden>
            <header class="worlds-triage-head">
              <div>
                <p data-triage-position>Nothing to triage</p>
                <strong data-triage-label></strong>
              </div>
              <div class="worlds-triage-progress">
                <span data-triage-changed>0 changed</span>
                <div><i data-triage-bar></i></div>
              </div>
            </header>
            <div class="worlds-triage-frames" data-triage-frames></div>
            <!-- Three renders of a world are hard to choose between without
                 knowing what the world was meant to be, and the space under a
                 row of 16:9 frames is free. -->
            <div class="worlds-triage-brief">
              <p data-triage-spark></p>
              <ol data-triage-system></ol>
            </div>
            <footer class="worlds-triage-keys">
              <span><kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> pick and advance</span>
              <span><kbd>&rarr;</kbd> keep and advance</span>
              <span><kbd>&larr;</kbd> back</span>
              <span>click a frame for full size</span>
            </footer>
          </div>

          <!-- The paste box leads because dropping a candidate in is the thing
               done often; working the queue is done rarely and deliberately. It
               takes anything with URLs in it, so there is nothing to get right. -->
          <div class="worlds-sites" data-sites hidden>
            <form class="worlds-sites-add" data-sites-form>
              <label for="worlds-sites-paste">Paste anything with links in it</label>
              <textarea
                id="worlds-sites-paste"
                data-sites-input
                rows="3"
                placeholder="https://example.com&#10;a markdown list, a bookmark export, or a chat log all work"
              ></textarea>
              <div class="worlds-sites-add-foot">
                <span data-sites-feedback role="status"></span>
                <button type="submit">Add to queue</button>
              </div>
            </form>
            <div class="worlds-sites-list" data-sites-list></div>
          </div>

          <div class="worlds-concept-body">
            <div class="worlds-concept-copy">
              <p class="worlds-concept-kicker">Structural challenger</p>
              <h2 id="current-concept-form" data-concept-form>{initialConcept.form}</h2>
              <section class="worlds-creative-spark">
                <p>Creative spark</p>
                <strong data-concept-spark>{initialConcept.spark}</strong>
              </section>
              <div class="worlds-tag-row" data-concept-tags>
                {initialConcept.tags.map(tag => <span>{tag}</span>)}
              </div>
              <div class="worlds-concept-meta">
                <div>
                  <p>Design lineage</p>
                  <strong data-concept-lineage>{initialConcept.lineage}</strong>
                </div>
                <div data-concept-review-note-wrap hidden={!initialConcept.review?.note}>
                  <p>Review note</p>
                  <strong data-concept-review-note>{initialConcept.review?.note}</strong>
                </div>
                <div class="worlds-concept-meta-row">
                  <span>Catalog version <em data-catalog-version>{catalog.catalogVersion}</em></span>
                </div>
              </div>
            </div>
            <div class="worlds-concept-evidence" data-evidence>
              <!-- One card leads and the other two sit under it, because a
                   reviewer is judging one thing at a time. Which one leads
                   follows the mode filter: a read world is judged on its
                   documentation page, an operate world on its component sheet. -->
              <figure class="worlds-lead-card" data-lead-wrap hidden={!initialConcept.card?.heroSrc}>
                <figcaption>
                  <span data-lead-label>Landing page</span>
                  <span class="worlds-card-stale" data-concept-card-stale hidden>stale</span>
                  <span class="worlds-lead-variants" data-lead-variants></span>
                </figcaption>
                <a data-lead-link href={initialConcept.card?.heroSrc} target="_blank" rel="noopener">
                  <img
                    data-lead-img
                    src={initialConcept.card?.heroSrc}
                    alt={initialConcept.card?.heroSrc ? `Landing page composed in the world of ${initialConcept.form}` : ''}
                    width="2048"
                    height="1152"
                    loading="lazy"
                    decoding="async"
                  >
                </a>
              </figure>
              <div class="worlds-card-pair" data-card-pair></div>
              <div class="worlds-system-contract">
                <section>
                  <p>System grammar</p>
                  <ol data-concept-system>
                    {initialConcept.system.map(rule => <li>{rule}</li>)}
                  </ol>
                </section>
                <section>
                  <p>Web leverage</p>
                  <strong data-concept-web-leverage>{initialConcept.webLeverage}</strong>
                </section>
                <section data-concept-avoid-wrap hidden={!initialConcept.avoid?.length}>
                  <p>Avoids</p>
                  <ul class="worlds-concept-avoid" data-concept-avoid>
                    {(initialConcept.avoid || []).map(item => <li>{item}</li>)}
                  </ul>
                </section>
              </div>
            </div>
          </div>

          <form class="worlds-edit-form" data-edit-form role="dialog" aria-modal="true" aria-labelledby="worlds-edit-title" hidden>
            <header>
              <div>
                <p id="worlds-edit-title">Edit source concept</p>
                <strong>The stable ID will not change.</strong>
              </div>
              <button type="button" data-edit-cancel aria-label="Close editor">×</button>
            </header>
            <label>
              <span>Grounded form</span>
              <textarea name="form" rows="5" minlength="40" maxlength="360" required></textarea>
            </label>
            <label>
              <span>Creative spark</span>
              <textarea name="spark" rows="4" minlength="80" maxlength="320" required></textarea>
            </label>
            <div class="worlds-edit-row">
              <label>
                <span>Territory</span>
                <select name="familyId">
                  {wellGroups.map(group => (
                    <optgroup label={group.well.label}>
                      {group.families.map(family => <option value={family.id}>{family.label}</option>)}
                    </optgroup>
                  ))}
                </select>
              </label>
              <label>
                <span>Lineage</span>
                <input name="lineage" minlength="12" maxlength="200" required>
              </label>
            </div>
            <fieldset>
              <legend>Structural tags</legend>
              <div class="worlds-edit-row is-tags">
                <input name="tag1" maxlength="40" aria-label="Structural tag one" required>
                <input name="tag2" maxlength="40" aria-label="Structural tag two" required>
                <input name="tag3" maxlength="40" aria-label="Structural tag three" required>
              </div>
            </fieldset>
            <fieldset>
              <legend>System grammar</legend>
              <div class="worlds-edit-system">
                <textarea name="system1" rows="2" maxlength="180" aria-label="Palette and material rule" required></textarea>
                <textarea name="system2" rows="2" maxlength="180" aria-label="Type and composition rule" required></textarea>
                <textarea name="system3" rows="2" maxlength="180" aria-label="Topology and navigation rule" required></textarea>
                <textarea name="system4" rows="2" maxlength="180" aria-label="Controls and state rule" required></textarea>
                <textarea name="system5" rows="2" maxlength="180" aria-label="Responsive and motion rule" required></textarea>
              </div>
            </fieldset>
            <label>
              <span>Web leverage</span>
              <textarea name="webLeverage" rows="3" minlength="20" maxlength="240" required></textarea>
            </label>
            <footer>
              <button type="button" class="worlds-button-secondary" data-edit-cancel>Cancel</button>
              <button type="submit" class="worlds-button-primary">Save to catalog</button>
            </footer>
          </form>

          <footer class="worlds-review-actions">
            <div class="worlds-action-status">
              <input
                class="worlds-decision-note"
                data-decision-note
                type="text"
                maxlength="500"
                placeholder="Optional note, attached to the next decision"
                aria-label="Optional note attached to the next review decision"
                autocomplete="off"
                disabled={!import.meta.env.DEV}
              >
              <p class="worlds-action-note" data-action-note role="status" aria-live="polite"></p>
              <button type="button" class="worlds-undo" data-undo hidden disabled={!import.meta.env.DEV} aria-keyshortcuts="Alt+Z">
                <span data-undo-label>Undo last decision</span><kbd>⌥Z</kbd>
              </button>
            </div>
            <div class="worlds-action-buttons">
              <button type="button" class="worlds-action-reject" data-review-status="rejected" disabled={!import.meta.env.DEV} aria-keyshortcuts="Alt+R">
                <span>Reject</span><kbd>⌥R</kbd>
              </button>
              <button type="button" class="worlds-action-pending" data-review-status="pending" disabled={!import.meta.env.DEV} aria-keyshortcuts="Alt+U">
                <span>Return to backlog</span><kbd>⌥U</kbd>
              </button>
              <button type="button" class="worlds-action-approve" data-review-status="approved" disabled={!import.meta.env.DEV} aria-keyshortcuts="Alt+A">
                <span>Approve</span><kbd>⌥A</kbd>
              </button>
            </div>
          </footer>
        </article>
      </div>
    </div>
  </section>

  <div class="worlds-toast" role="status" aria-live="polite" data-toast hidden></div>
  <!-- Viewing, not deciding. These images are 2048px and the judgement they
       support cannot always be made at thumbnail size. -->
  <div class="worlds-lightbox" data-lightbox hidden>
    <p data-lightbox-caption></p>
    <!-- The image is built when one is opened rather than parked here without a
         src, so there is never a source-less img in the document. -->
    <div data-lightbox-frame></div>
  </div>
  <script id="worlds-catalog-data" type="application/json" set:html={pageData}></script>

  <script>
    const payload = JSON.parse(document.getElementById('worlds-catalog-data').textContent);
    const families = payload.families;
    const concepts = families.flatMap(family => family.concepts);
    const familyMap = new Map(families.map(family => [family.id, family]));
    const conceptMap = new Map(concepts.map(concept => [concept.id, concept]));
    const canWrite = payload.canWrite;
    // The hash carries which view as well as which concept, so a reload lands
    // where you were. It used to hold the concept alone, which meant reloading
    // on Sites or Coverage dropped you back into the review of a world you were
    // not looking at.
    const VIEWS = new Set(['detail', 'cards', 'coverage', 'sites', 'triage']);
    const readHash = () => new URLSearchParams(location.hash.replace(/^#/, ''));
    const writeHash = () => {
      const params = new URLSearchParams();
      if (state.view && state.view !== 'detail') params.set('view', state.view);
      if (state.currentId) params.set('concept', state.currentId);
      const next = params.toString();
      // replaceState, not push: walking the queue with J would otherwise bury
      // the back button under one entry per world.
      history.replaceState(null, '', next ? `#${next}` : location.pathname);
    };
    const initialHash = readHash();
    const initialId = initialHash.get('concept') || '';
    const initialView = VIEWS.has(initialHash.get('view')) ? initialHash.get('view') : 'detail';
    // Land on a bucket that has something in it. The default used to be
    // 'pending' unconditionally, so once the backlog was cleared the app opened
    // on an empty stage and an empty queue and read as broken to anyone who did
    // not already know that meant the reviewing was done. A linked concept still
    // wins; otherwise take the backlog while it has work, and fall back through
    // approved to the whole catalog.
    const conceptCount = status => concepts.reduce((n, c) => n + (c.status === status ? 1 : 0), 0);
    const initialStatus = conceptMap.get(initialId)?.status
      || (conceptCount('pending') > 0 ? 'pending'
        : conceptCount('approved') > 0 ? 'approved'
        : 'all');
    const state = {
      status: initialStatus,
      family: 'all',
      mode: 'all',
      // Qualities of an approved world rather than statuses beside it.
      rating: 'all',
      reach: 'all',
      tier: 'all',
      sort: 'catalog',
      view: initialView,
      query: '',
      currentId: initialId,
    };

    const queueList = document.querySelector('[data-queue-list]');
    const queuePanel = document.querySelector('.worlds-queue');
    const workspaceGrid = document.querySelector('.worlds-workspace-grid');
    const workbench = document.querySelector('.worlds-workbench');
    const reviewHead = document.querySelector('.worlds-review-head');
    const resultCount = document.querySelector('[data-result-count]');
    const windowLabel = document.querySelector('[data-window-label]');
    const queueTitle = document.querySelector('[data-queue-title]');
    const searchInput = document.querySelector('[data-search]');
    const formEl = document.querySelector('[data-concept-form]');
    const wellEl = document.querySelector('[data-concept-well]');
    const familyEl = document.querySelector('[data-concept-family]');
    const idEl = document.querySelector('[data-concept-id]');
    const statusEl = document.querySelector('[data-concept-status]');
    const telemetryEl = document.querySelector('[data-concept-telemetry]');
    // The same reading the server renders. Two copies of this drifted the
    // moment one of them was corrected, which is exactly how the stage kept
    // showing "won 7 · 0%" after that wording was retired.
    const fieldBaseRate = payload.fieldBaseRate || null;
    const fieldLine = (t) => {
      if (!t) return 'no field data';
      const index = fieldBaseRate && t.dealt
        ? ` · ${(t.chosen / t.dealt / fieldBaseRate).toFixed(1)}x field average`
        : '';
      const thin = t.chosen < 20 ? ' · too few to rank' : '';
      return `dealt ${t.dealt.toLocaleString()} · reported ${t.chosen}${index}${thin}`;
    };
    const lineageEl = document.querySelector('[data-concept-lineage]');
    const tagsEl = document.querySelector('[data-concept-tags]');
    const systemEl = document.querySelector('[data-concept-system]');
    const sparkEl = document.querySelector('[data-concept-spark]');
    const leadWrapEl = document.querySelector('[data-lead-wrap]');
    const leadImgEl = document.querySelector('[data-lead-img]');
    const leadLinkEl = document.querySelector('[data-lead-link]');
    const leadLabelEl = document.querySelector('[data-lead-label]');
    const leadVariantsEl = document.querySelector('[data-lead-variants]');
    const cardPairEl = document.querySelector('[data-card-pair]');
    const cardStaleEl = document.querySelector('[data-concept-card-stale]');

    // Which card leads follows the mode filter, because that is the surface the
    // reviewer is judging the world for: a read world stands or falls on its
    // documentation page, an operate world on its component sheet, and the rest
    // on the landing page.
    // Mode alone decides which card leads. There was a promote-on-click as well,
    // which meant opening one of the small cards full size took two clicks: one
    // to move it up, another to open it. Now the small ones are plain links.
    const LEAD_FOR_MODE = { persuade: 'hero', experience: 'hero', read: 'docs', operate: 'board' };
    const DEFAULT_LEAD = 'board';
    const KIND_LABEL = { board: 'Component sheet', hero: 'Landing page', docs: 'Documentation page' };
    const KIND_SRC = { board: 'src', hero: 'heroSrc', docs: 'docsSrc' };

    function renderEvidence(concept) {
      const card = concept.card;
      if (!card) {
        leadWrapEl.hidden = true;
        leadImgEl.removeAttribute('src');
        cardPairEl.replaceChildren();
        return;
      }
      const preferred = LEAD_FOR_MODE[state.mode] || DEFAULT_LEAD;
      const order = ['board', 'hero', 'docs'];
      const present = order.filter(kind => card[KIND_SRC[kind]]);
      const lead = present.includes(preferred) ? preferred : present[0];
      if (!lead) {
        leadWrapEl.hidden = true;
        leadImgEl.removeAttribute('src');
        cardPairEl.replaceChildren();
        return;
      }

      leadWrapEl.hidden = false;
      leadImgEl.src = card[KIND_SRC[lead]];
      leadImgEl.alt = `${KIND_LABEL[lead]} composed in the world of ${concept.form}`;
      leadLinkEl.href = card[KIND_SRC[lead]];
      leadLabelEl.textContent = KIND_LABEL[lead];
      // Guarded because this element has been deleted once already, and losing
      // it silently killed the rest of the panel: the lead image was set, the
      // throw landed here, and the pair below never rendered.
      if (cardStaleEl) cardStaleEl.hidden = !(lead === 'board' && card.stale);

      leadVariantsEl.replaceChildren(...variantChips(concept, card, lead, leadImgEl));

      cardPairEl.replaceChildren(...present.filter(kind => kind !== lead).map(kind => {
        const figure = document.createElement('figure');
        const caption = document.createElement('figcaption');
        const name = document.createElement('span');
        name.textContent = KIND_LABEL[kind];
        const link = document.createElement('a');
        link.href = card[KIND_SRC[kind]];
        link.target = '_blank';
        link.rel = 'noopener';
        link.title = `Open the ${KIND_LABEL[kind].toLowerCase()} full size`;
        const img = document.createElement('img');
        img.src = card[KIND_SRC[kind]];
        img.alt = `${KIND_LABEL[kind]} composed in the world of ${concept.form}`;
        img.loading = 'lazy';
        link.append(img);
        // The pair needs its own chips or two thirds of the run is unpickable:
        // the lead kind is fixed by mode, so without these the only way to
        // choose a landing page was to review the world under another mode.
        const chips = document.createElement('span');
        chips.className = 'worlds-lead-variants';
        chips.replaceChildren(...variantChips(concept, card, kind, img));
        caption.append(name, chips);
        figure.append(caption, link);
        return figure;
      }));
    }

    // One builder for both the lead and the pair. Chips appear only where there
    // is a choice to make; hovering previews in place and clicking commits.
    function variantChips(concept, card, kind, imgEl) {
      const variants = card.variants?.[kind] || [];
      if (variants.length < 2) return [];
      return variants.map(entry => {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = entry.variant.toUpperCase();
        button.className = entry.current ? 'is-current' : '';
        button.title = entry.current
          ? `The ${KIND_LABEL[kind].toLowerCase()} everything else uses`
          : `Make this the ${KIND_LABEL[kind].toLowerCase()} everything else uses`;
        button.addEventListener('click', () => {
          chooseVariant(concept.id, kind, entry.variant)
            .catch(error => showToast(`could not set the winner: ${error.message}`, 'error'));
        });
        button.addEventListener('mouseenter', () => { imgEl.src = entry.src; });
        button.addEventListener('mouseleave', () => { imgEl.src = card[KIND_SRC[kind]]; });
        return button;
      });
    }

    // Throws rather than swallowing, because triage fires this nine hundred
    // times and a run that silently failed halfway would look exactly like a
    // run that worked. Callers on the stage catch it into a toast.
    async function chooseVariant(id, kind, variant) {
      const response = await fetch('/__impeccable/worlds', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'cardWinner', id, kind, variant }),
      });
      if (!response.ok) throw new Error((await response.text()).slice(0, 160));
      // The winner now sits at the canonical filename, so the cache buster has
      // to move or the browser keeps showing the previous choice.
      const concept = conceptMap.get(id);
      const bust = `?v=${Date.now().toString(36)}`;
      const base = concept.card[KIND_SRC[kind]].split('?')[0];
      concept.card[KIND_SRC[kind]] = base + bust;
      for (const entry of concept.card.variants[kind]) entry.current = entry.variant === variant;
      if (state.view !== 'triage') renderEvidence(concept);
    }


    const webLeverageEl = document.querySelector('[data-concept-web-leverage]');
    const avoidWrapEl = document.querySelector('[data-concept-avoid-wrap]');
    const avoidEl = document.querySelector('[data-concept-avoid]');
    const positionEl = document.querySelector('[data-concept-position]');
    const editForm = document.querySelector('[data-edit-form]');
    const toast = document.querySelector('[data-toast]');
    const lightbox = document.querySelector('[data-lightbox]');
    const lightboxFrame = document.querySelector('[data-lightbox-frame]');
    const lightboxCaption = document.querySelector('[data-lightbox-caption]');

    function openLightbox(src, caption = '') {
      const image = document.createElement('img');
      image.src = src;
      image.alt = caption;
      lightboxFrame.replaceChildren(image);
      lightboxCaption.textContent = caption;
      lightbox.hidden = false;
    }
    function closeLightbox() {
      lightbox.hidden = true;
      lightboxFrame.replaceChildren();
    }
    lightbox?.addEventListener('click', closeLightbox);
    const reviewStage = document.querySelector('[data-concept-form]').closest('.worlds-review-stage');
    const actionNote = document.querySelector('[data-action-note]');
    const decisionNoteInput = document.querySelector('[data-decision-note]');
    const strengthButtons = [...document.querySelectorAll('[data-strength-option]')];
    const ratingGroup = document.querySelector('[data-rating-group]');
    const ratingButtons = [...document.querySelectorAll('[data-rating-option]')];
    const breadthToggle = document.querySelector('[data-breadth-toggle]');
    const proToggle = document.querySelector('[data-pro-toggle]');
    const breadthButtons = [...document.querySelectorAll('[data-breadth-option]')];
    const tierButtons = [...document.querySelectorAll('[data-tier-option]')];
    // Labeled wrappers, keyed by the field they hold, so visibility and the
    // write flash can address a whole field rather than hunting for its control.
    const reviewFields = Object.fromEntries(
      [...document.querySelectorAll('[data-field]')].map(el => [el.dataset.field, el]),
    );
    /** Point a two-or-three-way segmented group at one value. */
    const setSegmentState = (buttons, key, value) => {
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset[key] === value));
    };
    /**
     * Say that a write landed, on the control that was written.
     *
     * These controls commit to the catalog on disk the moment they are clicked,
     * and the only acknowledgement was a toast in the far corner of the screen.
     * A brief flash on the field ties the write to the thing written, which is
     * also the clearest possible statement that the control was a control.
     */
    const flashWrite = (field) => {
      const el = typeof field === 'string' ? reviewFields[field] : field;
      if (!el) return;
      el.classList.remove('is-written');
      // Reading offsetWidth restarts the animation when the same field is
      // written twice in a row; without it the class is added in the same frame
      // it was removed and nothing replays.
      void el.offsetWidth;
      el.classList.add('is-written');
    };
    const coveragePanel = document.querySelector('[data-coverage]');
    const cardGrid = document.querySelector('[data-card-grid]');
    const reviewControls = document.querySelector('.worlds-review-controls');
    const reviewActions = document.querySelector('.worlds-review-actions');
    const cardGridItems = document.querySelector('[data-card-grid-items]');
    const cardGridEmpty = document.querySelector('[data-card-grid-empty]');
    const conceptBody = document.querySelector('.worlds-concept-body');
    const modesGroup = document.querySelector('[data-modes-group]');
    const modeOptions = [...document.querySelectorAll('[data-mode-option]')];
    let notedConceptId = '';
    const reviewNoteWrapEl = document.querySelector('[data-concept-review-note-wrap]');
    const reviewNoteEl = document.querySelector('[data-concept-review-note]');
    const undoButton = document.querySelector('[data-undo]');
    const undoLabel = document.querySelector('[data-undo-label]');
    const familySearchInput = document.querySelector('[data-family-search]');
    const familyExpandButton = document.querySelector('[data-family-expand]');
    const familyEmpty = document.querySelector('[data-family-empty]');
    const familyButtons = [...document.querySelectorAll('[data-family-filter]')];
    // The header runtime indicator already states write mode; this line only
    // carries transient operation messages (saving, restoring, errors).
    const defaultActionNote = '';
    let toastTimer = 0;
    let familyExpanded = true;
    let lastReview = null;
    let editorBaseline = '';

    function currentConcept() {
      return conceptMap.get(state.currentId) || null;
    }

    function searchableText(concept) {
      return [concept.id, concept.form, concept.spark, concept.lineage, concept.familyLabel, concept.wellLabel, concept.webLeverage, ...concept.tags, ...concept.system].join(' ').toLowerCase();
    }

    function filteredConcepts() {
      const query = state.query.trim().toLowerCase();
      const rows = concepts.filter(concept => {
        if (state.status !== 'all' && concept.status !== state.status) return false;

        // All three only exist on an approved world, so each implies approved
        // rather than silently matching a backlog entry that has no such field.
        if (state.rating !== 'all') {
          if (concept.status !== 'approved') return false;
          const rating = concept.review?.rating || null;
          if (state.rating === 'unrated' ? rating : rating !== Number(state.rating)) return false;
        }
        if (state.reach !== 'all') {
          if (concept.status !== 'approved') return false;
          const niche = concept.review?.breadth === 'niche';
          if (state.reach === 'niche' ? !niche : niche) return false;
        }
        if (state.tier !== 'all') {
          if (concept.status !== 'approved') return false;
          const pro = Boolean(concept.review?.pro);
          if (state.tier === 'pro' ? !pro : pro) return false;
        }
        if (state.family !== 'all' && concept.familyId !== state.family) return false;
        // A world with no allowedModes is eligible everywhere, so it matches every
        // mode filter. 'scoped' is the inverse view: only worlds someone narrowed.
        if (state.mode !== 'all') {
          const allowed = concept.review?.allowedModes;
          const scoped = Array.isArray(allowed) && allowed.length > 0;
          if (state.mode === 'scoped') {
            if (!scoped) return false;
          } else if (state.mode === 'unscoped') {
            if (scoped) return false;
          } else if (scoped && !allowed.includes(state.mode)) {
            return false;
          }
        }
        return !query || searchableText(concept).includes(query);
      });
      if (state.sort === 'catalog') return rows;
      // Copied before sorting: filteredConcepts is called on every render and
      // sorting in place would permanently reorder the catalog array the folio
      // counter and the id lookups are built from.
      const sorted = [...rows];
      if (state.sort === 'rating') {
        // Unrated last rather than first: a missing rating is unknown, not zero.
        sorted.sort((a, b) => (b.review?.rating || 0) - (a.review?.rating || 0)
          || fieldIndex(b) - fieldIndex(a));
      } else if (state.sort === 'popularity') {
        sorted.sort((a, b) => fieldIndex(b) - fieldIndex(a));
      }
      return sorted;
    }

    // How a world does against the field average, which is the only comparable
    // reading: raw reports rank by how often the roll dealt a world, and a raw
    // rate reads as a win rate when it is nothing of the kind. Worlds under
    // twenty reports sort as unknown rather than as good or bad, because at the
    // median of one report the rate is noise.
    function fieldIndex(concept) {
      const t = concept.telemetry;
      if (!t || !t.dealt || !fieldBaseRate || t.chosen < 20) return -1;
      return t.chosen / t.dealt / fieldBaseRate;
    }

    // Coverage: where the catalog is crowded and where it is open. Computed live
    // from the same rules scripts/lib/world-occupancy.mjs uses, so the page and
    // the CLI report never disagree.
    //
    // The axis health line is the important part. A value nobody matches reads as
    // a wide-open opening, and a wave briefed from that would chase a hole that
    // does not exist, so an axis that places too little of the corpus says so
    // instead of quietly reporting zeroes.
    const AXES = payload.aestheticAxes?.axes || [];
    const DIGITAL_FAMILIES = new Set(['medium-native', 'digital-design-canon']);
    const MODE_LIST = ['persuade', 'operate', 'read', 'experience'];
    const TIER_LIST = ['graphic', 'interaction', 'atmosphere'];

    function axisText(concept, axis) {
      if (axis.rule === 'all') return (concept.form + ' ' + (concept.system || []).join(' ')).toLowerCase();
      return ((concept.system || []).find(rule => rule.startsWith(axis.rule)) || '').toLowerCase();
    }
    function axisMatches(concept, axis, value) {
      const text = axisText(concept, axis);
      if (!text) return false;
      // Escaping via a replacer function, not a $& string: a literal $& in a
      // replacement re-inserts the matched text, which is exactly how this line
      // got mangled the first time.
      const says = word => new RegExp(`\\b${word.replace(/[.*+?^${}()|[\]\\]/g, m => '\\' + m)}\\b`, 'i').test(text);
      // A count axis asks how many things a rule names rather than whether it
      // says one: palette rules enumerate pigments instead of naming a strategy.
      if (axis.kind === "count") {
        const found = new Set((axis.lexicon || []).filter(says));
        if (found.size === 0) return false;
        if (value.min != null && found.size < value.min) return false;
        if (value.max != null && found.size > value.max) return false;
        return true;
      }
      return (value.match || []).some(says);
    }

    // Coverage: where the catalog is crowded, where it is open, and whether the
    // measurement can be trusted. Editable, because fixing an axis means changing
    // a keyword and immediately seeing which worlds it caught; doing that by hand
    // in JSON and re-running a script loses the loop that makes it work.
    const coverageState = { open: null, dirty: false };

    function coverageWorlds() {
      return concepts.filter(concept => concept.status === 'approved');
    }

    function axisPlacement(axis, pool) {
      const placed = pool.filter(concept => (axis.values || []).some(value => axisMatches(concept, axis, value)));
      return { placed, unplaced: pool.filter(concept => !placed.includes(concept)) };
    }

    // Variant triage. The generation run produced three of every card and left
    // v1 winning everywhere, so until a human picks, none of it is used. That is
    // 303 worlds by three kinds, and the only way through it is one keystroke
    // per decision.
    const triagePanel = document.querySelector('[data-triage]');
    const triageFrames = document.querySelector('[data-triage-frames]');
    const triagePosition = document.querySelector('[data-triage-position]');
    const triageLabel = document.querySelector('[data-triage-label]');
    const triageChanged = document.querySelector('[data-triage-changed]');
    const triageBar = document.querySelector('[data-triage-bar]');
    const triageSpark = document.querySelector('[data-triage-spark]');
    const triageSystem = document.querySelector('[data-triage-system]');
    let triageQueue = [];
    let triageIndex = 0;
    let triageChangedCount = 0;

    function buildTriageQueue() {
      triageQueue = [];
      for (const concept of concepts) {
        for (const kind of ['board', 'hero', 'docs']) {
          if ((concept.card?.variants?.[kind] || []).length > 1) triageQueue.push({ id: concept.id, kind });
        }
      }
    }

    function renderTriage() {
      const showing = state.view === 'triage';
      triagePanel.hidden = !showing;
      if (!showing) return;
      if (triageQueue.length === 0) buildTriageQueue();
      if (triageQueue.length === 0) {
        triagePosition.textContent = 'Nothing has variants yet';
        triageLabel.textContent = '';
        triageFrames.replaceChildren();
        return;
      }
      triageIndex = Math.max(0, Math.min(triageIndex, triageQueue.length - 1));
      const item = triageQueue[triageIndex];
      const concept = conceptMap.get(item.id);
      const variants = concept?.card?.variants?.[item.kind] || [];

      triagePosition.textContent = `${triageIndex + 1} of ${triageQueue.length}`;
      triageLabel.textContent = `${KIND_LABEL[item.kind]}: ${concept.form.split(',')[0]}`;
      triageChanged.textContent = `${triageChangedCount} changed`;
      triageBar.style.width = `${((triageIndex + 1) / triageQueue.length) * 100}%`;

      triageFrames.replaceChildren(...variants.map((entry, index) => {
        const figure = document.createElement('figure');
        figure.className = entry.current ? 'is-current' : '';
        const image = document.createElement('img');
        image.src = entry.src;
        image.alt = `${entry.variant} of ${KIND_LABEL[item.kind]} for ${concept.form.split(',')[0]}`;
        image.addEventListener('click', () => openLightbox(entry.src, `${entry.variant.toUpperCase()}: ${concept.form.split(',')[0]}`));
        const caption = document.createElement('figcaption');
        caption.innerHTML = `<kbd>${index + 1}</kbd> ${entry.variant.toUpperCase()}${entry.current ? ' <em>in use</em>' : ''}`;
        figure.append(image, caption);
        return figure;
      }));

      triageSpark.textContent = concept.spark || '';
      triageSystem.replaceChildren(...(concept.system || []).map(rule => {
        const li = document.createElement('li');
        li.textContent = rule;
        return li;
      }));

      // The next pair's images are fetched now, so the keystroke that advances
      // lands on a drawn screen rather than three empty boxes.
      const next = triageQueue[triageIndex + 1];
      if (next) {
        for (const entry of conceptMap.get(next.id)?.card?.variants?.[next.kind] || []) {
          const preload = new Image();
          preload.src = entry.src;
        }
      }
    }

    function triageMove(delta) {
      triageIndex = Math.max(0, Math.min(triageIndex + delta, triageQueue.length - 1));
      renderTriage();
    }

    async function triagePick(index) {
      const item = triageQueue[triageIndex];
      if (!item) return;
      const concept = conceptMap.get(item.id);
      const entry = (concept?.card?.variants?.[item.kind] || [])[index];
      if (!entry) return;
      // Already the winner, so advancing is the whole action. Writing it again
      // would copy a file and move a stamp to reach the state it is in.
      if (entry.current) { triageMove(1); return; }
      triageMove(1);
      try {
        await chooseVariant(item.id, item.kind, entry.variant);
        triageChangedCount += 1;
        triageChanged.textContent = `${triageChangedCount} changed`;
      } catch (error) {
        showToast(`could not set ${entry.variant}: ${error.message}`, 'error');
      }
    }

    // The site queue: candidate pages to derive a world from. Its rows are not
    // concepts and never become part of the review queue, so it renders itself
    // rather than borrowing the stage's machinery.
    const sitesPanel = document.querySelector('[data-sites]');
    const sitesForm = document.querySelector('[data-sites-form]');
    const sitesInput = document.querySelector('[data-sites-input]');
    const sitesFeedback = document.querySelector('[data-sites-feedback]');
    const sitesListEl = document.querySelector('[data-sites-list]');
    let siteQueue = Array.isArray(payload.siteQueue) ? payload.siteQueue : [];

    function renderSites() {
      const showing = state.view === 'sites';
      sitesPanel.hidden = !showing;
      if (!showing) return;
      const pending = siteQueue.filter(site => site.status === 'pending');
      // Kept sits between the two: judged, but not yet written up. It is the
      // work list for the derivation pass, so it stays visible rather than
      // being filed away with the finished and the rejected.
      const kept = siteQueue.filter(site => site.status === 'keep');
      const closed = siteQueue.filter(site => site.status === 'done' || site.status === 'passed');
      sitesListEl.replaceChildren();

      const section = (title, rows, builder) => {
        if (rows.length === 0) return;
        const head = document.createElement('p');
        head.className = 'worlds-sites-section';
        head.textContent = `${title} (${rows.length})`;
        sitesListEl.append(head, ...rows.map(builder));
      };

      section('Pending', pending, site => {
        const row = document.createElement('div');
        row.className = 'worlds-sites-row';

        const link = document.createElement('a');
        link.href = site.url;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = site.url.replace(/^https:\/\//, '');
        link.title = 'Open it. A screenshot cannot show you why it is here.';

        const meta = document.createElement('span');
        meta.className = 'worlds-sites-meta';
        meta.textContent = [site.note, site.source, site.added].filter(Boolean).join(' · ');

        const actions = document.createElement('span');
        actions.className = 'worlds-sites-actions';

        // Inline rather than a prompt(). The page's direction contract rules out
        // a modal per decision, and a browser prompt is exactly that; it also
        // throws away what you typed the moment you want to check the URL again.
        const askFor = (verb, placeholder, build) => {
          const input = document.createElement('input');
          input.type = 'text';
          input.placeholder = placeholder;
          const commit = () => {
            const value = input.value.trim();
            // A reason is required, not optional: the whole value of a closed
            // row is that it stops the page being argued again later.
            if (value) closeSite(site.url, build(value));
            else renderSites();
          };
          input.addEventListener('keydown', event => {
            if (event.key === 'Enter') { event.preventDefault(); commit(); }
            if (event.key === 'Escape') { event.preventDefault(); renderSites(); }
          });
          input.addEventListener('blur', () => { if (!input.value.trim()) renderSites(); });
          actions.replaceChildren(input);
          input.focus();
        };

        const pass = document.createElement('button');
        pass.type = 'button';
        pass.textContent = 'Pass';
        pass.title = 'Record why this page does not become a world';
        pass.addEventListener('click', () => askFor('pass', 'why not? (enter)', why => ({ status: 'passed', why })));

        // One click, nothing to type. Judging the render and writing the entry
        // happen at different times, and the concept id is produced by the
        // second: asking for it here asked for the answer to the next step.
        const keep = document.createElement('button');
        keep.type = 'button';
        keep.className = 'is-keep';
        keep.textContent = 'Keep';
        keep.title = 'Worth a catalog entry. The id gets filled in when one is written.';
        keep.addEventListener('click', () => closeSite(site.url, { status: 'keep' }));

        actions.append(pass, keep);
        row.append(link, meta, actions);

        // A rendered candidate is judged on one question: does the world belong
        // to the source's family without being the same page? That is a
        // comparison, so both are shown, at a size you can actually answer it at.
        if (!site.render) return row;
        const variants = site.render.variants || [];
        const wrap = document.createElement('div');
        // One prompt could not serve every source: a page whose idea is a
        // centred sentence and a page that lives on a shader want different
        // treatments, and seven rounds of tuning one instruction traded one
        // failure for another. So each candidate is drawn under several
        // strategies and the choice is a human's.
        wrap.className = variants.length > 1 ? 'worlds-sites-render is-choice' : 'worlds-sites-render';
        const shown = variants.length > 1
          ? [['Source', site.render.refs[0], null], ...variants.map(v => [v.label, v.src, v])]
          : [['Source', site.render.refs[0], null], ['World', site.render.world, null]];
        for (const [label, src, variant] of shown) {
          if (!src) continue;
          const figure = document.createElement('figure');
          if (variant) figure.className = 'is-pickable';
          const caption = document.createElement('figcaption');
          caption.textContent = label;
          if (variant) caption.title = variant.note;
          const image = document.createElement('img');
          // Downscaled for the row, full size in the lightbox. That takes each
          // one to about 20KB, which is why these are NOT lazy: an image
          // inserted into a container that was display:none never registers
          // with the intersection observer, and since nothing here scrolls on
          // arrival they simply never loaded. Sixty of them is under a megabyte.
          image.src = `${src}?w=900`;
          image.alt = `${label} for ${site.url}`;
          image.addEventListener('click', () => openLightbox(src, `${label}: ${site.url}`));
          figure.append(caption, image);

          // Choosing a strategy is the same act as keeping the candidate, so it
          // does both: the pick becomes the world and the row moves to kept.
          if (variant) {
            const choose = document.createElement('button');
            choose.type = 'button';
            choose.textContent = 'Keep this one';
            choose.addEventListener('click', async () => {
              try {
                await postSites({ action: 'pick', url: site.url, strategy: variant.id });
                await postSites({ action: 'close', url: site.url, status: 'keep' });
              } catch (error) {
                showToast(error.message, 'error');
              }
            });
            figure.append(choose);
          }
          wrap.append(figure);
        }
        const group = document.createElement('div');
        group.className = 'worlds-sites-entry';
        group.append(row, wrap);
        return group;
      });

      section('Kept, waiting on an entry', kept, site => {
        const row = document.createElement('div');
        row.className = 'worlds-sites-row is-kept';
        const link = document.createElement('a');
        link.href = site.url;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = site.url.replace(/^https:\/\//, '');
        const meta = document.createElement('span');
        meta.className = 'worlds-sites-meta';
        meta.textContent = site.note || '';
        const actions = document.createElement('span');
        actions.className = 'worlds-sites-actions';
        const undo = document.createElement('button');
        undo.type = 'button';
        undo.textContent = 'Back to pending';
        undo.addEventListener('click', () => reopenSite(site.url));
        actions.append(undo);
        row.append(link, meta, actions);
        return row;
      });

      section('Closed', closed, site => {
        const row = document.createElement('div');
        row.className = 'worlds-sites-row is-closed';
        const link = document.createElement('a');
        link.href = site.url;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = site.url.replace(/^https:\/\//, '');
        const meta = document.createElement('span');
        meta.className = 'worlds-sites-meta';
        meta.dataset.status = site.status;
        meta.textContent = site.status === 'done' ? `became ${site.conceptId}` : `passed: ${site.note || 'no reason recorded'}`;
        row.append(link, meta);
        return row;
      });

      if (siteQueue.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'worlds-sites-empty';
        empty.textContent = 'Nothing queued. Paste some links above.';
        sitesListEl.append(empty);
      }
    }

    async function postSites(payload) {
      const response = await fetch('/__impeccable/worlds', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ catalog: 'sites', ...payload }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result?.error || 'the queue refused that');
      // The endpoint returns queue rows, which know nothing about renders: those
      // are attached when the page is built, by looking on disk. Taking the
      // response wholesale therefore dropped every image the moment anything was
      // clicked, and only a reload brought them back. Carry them across.
      const renders = new Map(siteQueue.filter(site => site.render).map(site => [site.url, site.render]));
      siteQueue = (result.result?.sites || siteQueue).map(site => (
        renders.has(site.url) ? { ...site, render: renders.get(site.url) } : site
      ));
      renderSites();
      return result.result;
    }

    async function closeSite(url, verdict) {
      try {
        await postSites({ action: 'close', url, ...verdict });
      } catch (error) {
        showToast(error.message, 'error');
      }
    }

    async function reopenSite(url) {
      try {
        await postSites({ action: 'reopen', url });
      } catch (error) {
        showToast(error.message, 'error');
      }
    }

    sitesForm?.addEventListener('submit', async event => {
      event.preventDefault();
      const text = sitesInput.value;
      if (!text.trim()) return;
      try {
        const result = await postSites({ action: 'add', text });
        sitesInput.value = '';
        sitesFeedback.textContent = `${result.added} added${result.duplicate ? `, ${result.duplicate} already queued` : ''}`;
      } catch (error) {
        sitesFeedback.textContent = error.message;
      }
    });

    function renderCoverage() {
      const showing = state.view === 'coverage';
      coveragePanel.hidden = !showing;
      if (!showing) return;
      const pool = coverageWorlds();
      const digital = concept => DIGITAL_FAMILIES.has(concept.familyId);
      const modesOf = concept => {
        const allowed = concept.review?.allowedModes;
        return Array.isArray(allowed) && allowed.length ? allowed : MODE_LIST;
      };
      const esc = value => String(value).replace(/[&<>"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]));
      const parts = [];

      parts.push('<p class="worlds-coverage-lede">' + pool.length
        + ' approved worlds. Crowded rows are what the catalog already does; thin rows on a trusted axis are what a wave is briefed from. Click any value to see what it caught.'
        + (coverageState.dirty ? ' <strong>Unsaved axis edits.</strong>' : '') + '</p>');

      parts.push('<h3>Lineage by tier</h3><table class="worlds-coverage-table"><thead><tr><th>lineage</th>'
        + TIER_LIST.map(t => '<th>' + t + '</th>').join('') + '</tr></thead><tbody>'
        + [['digital-native', true], ['physical / cultural', false]].map(([label, want]) =>
            '<tr><th>' + label + '</th>' + TIER_LIST.map(tier => {
              const n = pool.filter(c => digital(c) === want && c.wellTier === tier).length;
              return '<td' + (n === 0 ? ' class="is-empty"' : '') + '>' + n + '</td>';
            }).join('') + '</tr>').join('')
        + '</tbody></table>');

      parts.push('<h3>What each mode can draw</h3><table class="worlds-coverage-table"><thead><tr><th>mode</th><th>digital</th><th>physical</th><th>total</th></tr></thead><tbody>'
        + MODE_LIST.map(mode => {
            const p2 = pool.filter(c => modesOf(c).includes(mode));
            return '<tr><th>' + mode + '</th><td>' + p2.filter(digital).length + '</td><td>'
              + (p2.length - p2.filter(digital).length) + '</td><td>' + p2.length + '</td></tr>';
          }).join('')
        + '</tbody></table>');

      for (const axis of AXES) {
        const { placed, unplaced } = axisPlacement(axis, pool);
        // Recorded-only axes (prohibition is an absence, variance needs two
        // instances) cannot be probed, so zero is "no wave has assigned this yet"
        // rather than a broken probe someone should go fix.
        const recordedOnly = axis.recorded === true;
        const recorded = pool.filter(c => c.axes?.[axis.id] != null).length;
        const trustworthy = recordedOnly
          ? recorded >= pool.length * 0.6
          : placed.length >= pool.length * 0.6;
        parts.push('<h3>' + esc(axis.label) + (axis.question ? ' <small>' + esc(axis.question) + '</small>' : '') + '</h3>');
        if (axis.note) parts.push('<p class="worlds-coverage-note">' + esc(axis.note) + '</p>');
        // One value carrying most of an axis is a smell: density once cleared the
        // trust bar on the bare word "every", which 129 worlds contain.
        const counts = (axis.values || []).map(v => pool.filter(c => axisMatches(c, axis, v)).length);
        const topShare = placed.length ? Math.max(...counts, 0) / placed.length : 0;
        if (!recordedOnly && placed.length > 0 && topShare > 0.6) {
          parts.push('<p class="worlds-coverage-warn">One value carries ' + Math.round(topShare * 100)
            + '% of what this axis places. Check it is not matching a common word.</p>');
        }
        if (!trustworthy && recordedOnly) {
          parts.push('<p class="worlds-coverage-warn">Recorded only: ' + recorded + ' of ' + pool.length
            + ' assigned so far. This dimension cannot be read from a world\'s prose, so it fills as waves'
            + ' assign and record it rather than by finding better keywords.</p>');
        } else if (!trustworthy) {
          parts.push('<p class="worlds-coverage-warn">Places only ' + placed.length + ' of ' + pool.length
            + '. Either the values are wrong or the dimension was never authored, and until it is one or the other'
            + ' nothing here is an opening: a value nobody matches looks exactly like one.'
            + ' <button type="button" class="worlds-coverage-link" data-unplaced="' + esc(axis.id) + '">read the '
            + unplaced.length + ' it missed</button></p>');
        }
        parts.push('<table class="worlds-coverage-table"><thead><tr><th>value</th><th>worlds</th><th>share</th><th>digital</th><th>weight</th></tr></thead><tbody>');
        for (const value of (axis.values || [])) {
          const hits = pool.filter(c => axisMatches(c, axis, value));
          const share = pool.length ? hits.length / pool.length : 0;
          const weight = Math.max(1, Math.round((1 - share) * 10));
          const thin = share < 0.1 && trustworthy;
          const key = axis.id + '/' + value.id;
          const open = coverageState.open === key;
          parts.push('<tr' + (thin ? ' class="is-opening"' : '') + (open ? ' class="is-open"' : '') + '>'
            + '<th><button type="button" class="worlds-coverage-link" data-value-key="' + esc(key) + '">'
            + esc(value.label) + '</button></th>'
            + '<td>' + hits.length + '</td><td>' + Math.round(share * 100) + '%</td>'
            + '<td>' + hits.filter(digital).length + '</td><td>' + weight + '</td></tr>');
          if (open) {
            parts.push('<tr class="worlds-coverage-detail"><td colspan="5">');
            if (axis.kind === 'count') {
              parts.push('<p>Counted from the axis lexicon (' + (axis.lexicon || []).length
                + ' terms) against <code>' + esc(axis.rule) + '</code>, between '
                + (value.min ?? 'any') + ' and ' + (value.max ?? 'any') + '.</p>');
            } else {
              parts.push('<label class="worlds-coverage-edit"><span>match words</span>'
                + '<input type="text" data-match-key="' + esc(key) + '" value="' + esc((value.match || []).join(', ')) + '"'
                + (canWrite ? '' : ' disabled') + '></label>'
                + '<p class="worlds-coverage-hint">Comma separated, matched on word boundaries against <code>'
                + esc(axis.rule) + '</code>. Edits recount live; nothing is written until you save.</p>');
            }
            parts.push('<p class="worlds-coverage-hint">' + hits.length + ' matched:</p><ul class="worlds-coverage-list">'
              + hits.slice(0, 14).map(c => '<li>' + esc(c.form.split(',')[0].slice(0, 96)) + '</li>').join('')
              + (hits.length > 14 ? '<li>and ' + (hits.length - 14) + ' more</li>' : '')
              + (hits.length === 0 ? '<li><em>nothing, which is either an opening or a bad probe</em></li>' : '')
              + '</ul></td></tr>');
          }
        }
        parts.push('</tbody></table>');
        if (coverageState.open === 'unplaced/' + axis.id) {
          parts.push('<div class="worlds-coverage-detail-block"><p class="worlds-coverage-hint">'
            + unplaced.length + ' worlds no value caught. Read these to invent the missing value, not to widen an existing one:</p>'
            + '<ul class="worlds-coverage-list">'
            + unplaced.slice(0, 20).map(c => '<li>' + esc(((c.system || []).find(r => r.startsWith(axis.rule)) || c.form).slice(0, 128)) + '</li>').join('')
            + (unplaced.length > 20 ? '<li>and ' + (unplaced.length - 20) + ' more</li>' : '')
            + '</ul></div>');
        }
      }

      if (canWrite) {
        parts.push('<div class="worlds-coverage-actions">'
          + '<button type="button" class="worlds-coverage-save" data-save-axes' + (coverageState.dirty ? '' : ' disabled') + '>'
          + (coverageState.dirty ? 'Save axes' : 'No axis changes') + '</button></div>');
      }
      coveragePanel.innerHTML = parts.join('');
    }


    // --- Contact sheet thumbnails ---------------------------------------
    // The generated cards are 2048x1152 at around 350KB, and the sheet draws
    // them 144px wide. Asking for the sources cost 214MB to scroll the sheet
    // once and put the renderer on the floor, so the dev server resizes them
    // and the page asks for the size it will actually paint.
    const THUMB_ENDPOINT = '/__impeccable/card-thumb';
    const THUMB_WIDTHS = [160, 320, 480];
    // The column is fixed by the rail, so one number describes every card and
    // the browser can pick a candidate before layout instead of after it.
    const THUMB_SIZES = '144px';
    const LOCAL_CARDS = '/worlds/cards/';

    // Only a locally generated card can be resized. A clone without one reads
    // the published card off impeccable.style, which has no resizer, so that
    // path keeps the full-size URL and simply pays for it.
    function thumbSourcesFor(src) {
      if (!src.startsWith(LOCAL_CARDS)) return { srcset: '', src };
      const [file, query] = src.slice(LOCAL_CARDS.length).split('?');
      // The card's generation stamp rides along so a regenerated world busts the
      // browser cache; the server keys on the file's mtime for the same reason.
      const stamp = query ? `&${query}` : '';
      return {
        srcset: THUMB_WIDTHS.map(w => `${THUMB_ENDPOINT}/${file}?w=${w}${stamp} ${w}w`).join(', '),
        src: `${THUMB_ENDPOINT}/${file}?w=${THUMB_WIDTHS[0]}${stamp}`,
      };
    }

    // Native loading="lazy" is what the sheet used to rely on, and inside this
    // nested scroller it releases a whole scroll-region at a time: a scrollbar
    // drag fired 60-odd full-size requests at once. An IntersectionObserver on
    // its own has the opposite failure, handing all 628 over in one callback the
    // moment the grid is shown. So the observer only nominates, and a queue with
    // a fixed number of slots decides when each one is allowed to start.
    const THUMB_CONCURRENCY = 6;
    let thumbGeneration = 0;
    let thumbObserver = null;
    let thumbQueue = [];
    let thumbInFlight = 0;

    function pumpThumbQueue() {
      while (thumbInFlight < THUMB_CONCURRENCY && thumbQueue.length > 0) {
        const job = thumbQueue.shift();
        // The sheet rebuilds whenever the filters change, so by the time a slot
        // frees up the element this job was queued for may be off the page. Both
        // checks matter: the generation catches a rebuild, isConnected catches an
        // element dropped for any other reason.
        if (job.generation !== thumbGeneration || !job.img.isConnected) continue;
        thumbInFlight += 1;
        const done = () => {
          thumbInFlight -= 1;
          pumpThumbQueue();
        };
        job.img.addEventListener('load', () => {
          // A response that arrives after a rebuild has nowhere to land. The
          // element is detached by then, so dropping the state change is enough.
          if (job.generation === thumbGeneration) job.img.parentNode?.setAttribute('data-state', 'ready');
          done();
        }, { once: true });
        job.img.addEventListener('error', () => {
          if (job.generation === thumbGeneration) job.img.parentNode?.setAttribute('data-state', 'failed');
          done();
        }, { once: true });
        if (job.srcset) job.img.srcset = job.srcset;
        job.img.src = job.src;
      }
    }

    function onThumbsVisible(entries) {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        // One shot each: a card that has been nominated never needs nominating
        // again, and unobserving keeps the callback's work proportional to what
        // just scrolled in rather than to the whole sheet.
        thumbObserver.unobserve(entry.target);
        const img = entry.target.querySelector('img[data-thumb-src]');
        if (!img) continue;
        thumbQueue.push({
          img,
          src: img.dataset.thumbSrc,
          srcset: img.dataset.thumbSrcset || '',
          generation: thumbGeneration,
        });
      }
      pumpThumbQueue();
    }

    function resetThumbLoader() {
      // Anything still queued belongs to the sheet that is being replaced.
      thumbGeneration += 1;
      thumbQueue = [];
      // Zeroed rather than left to drain. A request already on the wire when the
      // sheet rebuilds can briefly push the real total over the limit, which is
      // the price of never deadlocking: an abandoned image whose load the
      // browser cancels without firing either event would otherwise hold a slot
      // for the rest of the session.
      thumbInFlight = 0;
      thumbObserver?.disconnect();
      // Observed on the card rather than on the image, because the card carries
      // content-visibility: auto and a skipped subtree generates no box for the
      // image to be seen through. The card always has one.
      thumbObserver = new IntersectionObserver(onThumbsVisible, {
        root: cardGrid,
        // Roughly a screenful of lead time, so a steady scroll finds pictures
        // already there without reaching far enough to drain the queue.
        rootMargin: '600px 0px',
      });
    }

    let cardSignature = null;
    function renderCardGrid() {
      const showing = state.view === 'cards';
      // List and grid are two ways of drawing the queue, so they swap with each
      // other inside the rail. The stage is unaffected: whichever concept is
      // current stays under review, and its verdict controls stay live, because
      // picking a thumbnail is the same act as picking a row.
      // List and grid both review; Coverage, Sites and Variants are elsewhere.
      const reviewing = state.view === 'detail' || state.view === 'cards';
      // Triage needs the width more than it needs the queue, and the queue
      // cannot act on what triage is showing anyway.
      // Coverage, Sites and Variants are places, not presentations of the
      // queue, and none of them acts on a current concept. Leaving the review
      // furniture up under them showed a queue reading "no concepts match" and
      // a breadcrumb for a world nothing on screen referred to. All three now
      // take the full width and drop the queue, the family rail and the
      // concept's own header.
      reviewHead.hidden = !reviewing;
      queuePanel.hidden = !reviewing;
      workspaceGrid.classList.toggle('is-wide', !reviewing);
      workbench.classList.toggle('is-wide', !reviewing);
      cardGrid.hidden = !showing;
      queueList.hidden = showing;
      conceptBody.hidden = !reviewing;
      reviewControls.hidden = !reviewing;
      reviewActions.hidden = !reviewing;
      for (const item of document.querySelectorAll('[data-view]')) {
        // The toolbar's Review covers both queue presentations, because a
        // contact sheet is still reviewing.
        const active = item.dataset.view === 'detail' && item.closest('.worlds-view-toggle')
          ? reviewing
          : item.dataset.view === state.view;
        item.setAttribute('aria-pressed', String(active));
      }
      if (!showing) return;
      const rows = filteredConcepts();
      // Cheap identity for the current set: rebuilding 500-odd images on every
      // keystroke of the search box stutters badly.
      const signature = rows.length + ':' + (rows[0]?.id || '') + ':' + (rows[rows.length - 1]?.id || '');
      cardGridEmpty.hidden = rows.length > 0;
      if (signature === cardSignature) {
        // The set is unchanged but the selection may not be, and the grid now
        // stays up while concepts are picked through it. Move the marker without
        // rebuilding five hundred images to do it.
        for (const card of cardGridItems.children) {
          card.setAttribute('aria-current', String(card.dataset.cardId === state.currentId));
        }
        keepCurrentCardInSight();
        return;
      }
      cardSignature = signature;
      resetThumbLoader();
      const pending = [];
      cardGridItems.replaceChildren(...rows.map(concept => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'worlds-card';
        button.dataset.cardId = concept.id;
        button.setAttribute('aria-current', String(concept.id === state.currentId));
        const figure = document.createElement('span');
        figure.className = 'worlds-card-thumb';
        if (concept.card?.src) {
          const sources = thumbSourcesFor(concept.card.src);
          const img = document.createElement('img');
          img.alt = '';
          img.decoding = 'async';
          // The intrinsic size is on the element rather than left to the file,
          // so the box is the right shape before a byte arrives and a card that
          // never loads holds its place instead of collapsing.
          img.width = 160;
          img.height = 90;
          img.sizes = THUMB_SIZES;
          // Held off the src until the loader says go. An src set here is a
          // request the queue no longer controls.
          img.dataset.thumbSrc = sources.src;
          if (sources.srcset) img.dataset.thumbSrcset = sources.srcset;
          figure.dataset.state = 'pending';
          figure.append(img);
          pending.push(button);
        } else {
          // Never generated, which is a different fact from not loaded yet and
          // has to look like one: a fair number of these worlds are legitimately
          // near-flat grey at this size.
          figure.dataset.state = 'unrendered';
        }
        // Status and rating ride on the picture rather than taking a line of
        // their own: at two columns that line was a third of the card's height
        // to say what a dot can. The mode subset comes off entirely, because a
        // list of mode names is read, not scanned, and the stage carries it.
        const rating = Number(concept.review?.rating) || 0;
        const mark = document.createElement('span');
        mark.className = 'worlds-card-mark';
        mark.dataset.status = concept.status;
        mark.textContent = rating ? '\u2605'.repeat(rating) : '';
        figure.append(mark);

        const label = document.createElement('span');
        label.className = 'worlds-card-label';
        label.textContent = concept.form.split(',')[0];

        // Everything the card stopped showing is still one hover away.
        const scoped = Array.isArray(concept.review?.allowedModes) && concept.review.allowedModes.length > 0
          ? concept.review.allowedModes.join(', ')
          : '';
        button.title = [concept.form.split(',')[0], concept.status, rating ? `${rating} star` : '', scoped]
          .filter(Boolean).join(' \u00b7 ');

        button.append(figure, label);
        return button;
      }));
      // Observed only once the cards are in the document, so the first callback
      // reports real geometry rather than nominating the whole sheet at once.
      for (const card of pending) thumbObserver.observe(card);
      keepCurrentCardInSight();
    }

    // J/K walk the queue in either presentation, and the grid is the taller of
    // the two, so the current card can leave the viewport without this.
    function keepCurrentCardInSight() {
      cardGridItems.querySelector('[aria-current="true"]')?.scrollIntoView({ block: 'nearest' });
    }

    function showToast(message, kind = 'success') {
      clearTimeout(toastTimer);
      toast.textContent = message;
      toast.dataset.kind = kind;
      toast.hidden = false;
      toastTimer = window.setTimeout(() => { toast.hidden = true; }, kind === 'error' ? 6400 : 3200);
    }

    function setReviewBusy(isBusy, message = defaultActionNote) {
      reviewStage.setAttribute('aria-busy', String(isBusy));
      actionNote.textContent = message;
    }

    function syncStatusTabs() {
      document.querySelectorAll('[data-status-filter]').forEach(item => {
        item.setAttribute('aria-pressed', String(item.dataset.statusFilter === state.status));
      });
    }

    function renderFamilyDirectory() {
      const query = familySearchInput.value.trim().toLowerCase();
      let matches = 0;
      for (const button of familyButtons) {
        const isAll = button.dataset.familyFilter === 'all';
        const isSelected = button.getAttribute('aria-pressed') === 'true';
        const matchesQuery = !query || button.dataset.familyLabel?.includes(query);
        const visible = isAll || isSelected || (query ? matchesQuery : familyExpanded);
        button.hidden = !visible;
        if (visible && !isAll && matchesQuery) matches += 1;
        button.tabIndex = isSelected ? 0 : -1;
      }
      for (const heading of document.querySelectorAll('[data-well-heading]')) {
        const wellId = heading.dataset.wellHeading;
        heading.hidden = !familyButtons.some(button => button.dataset.familyWell === wellId && !button.hidden);
      }
      familyEmpty.hidden = !query || matches > 0;
      familyExpandButton.hidden = Boolean(query);
      familyExpandButton.setAttribute('aria-expanded', String(familyExpanded));
      familyExpandButton.textContent = familyExpanded
        ? 'Show selected family only'
        : `Browse all ${families.length} families`;
    }

    function statusCounts() {
      return concepts.reduce((counts, concept) => {
        counts[concept.status] += 1;
        return counts;
      }, { approved: 0, pending: 0, rejected: 0 });
    }

    function renderCounts() {
      const counts = statusCounts();
      document.querySelector('[data-count-approved]').textContent = counts.approved.toLocaleString();
      document.querySelector('[data-count-pending]').textContent = counts.pending.toLocaleString();
      document.querySelector('[data-count-rejected]').textContent = counts.rejected.toLocaleString();
      document.querySelector('[data-count-total]').textContent = concepts.length.toLocaleString();
      // Mode counts are scoped to the current status filter, so they answer how
      // many of what you are looking at each mode can draw from. A world nobody
      // narrowed is eligible everywhere and counts toward every mode.
      const inStatus = concepts.filter(concept => state.status === 'all' || concept.status === state.status);
      const scopedOf = concept => {
        const allowed = concept.review?.allowedModes;
        return Array.isArray(allowed) && allowed.length > 0 ? allowed : null;
      };
      const modeCount = key => {
        if (key === 'all') return inStatus.length;
        if (key === 'unscoped') return inStatus.filter(c => !scopedOf(c)).length;
        if (key === 'scoped') return inStatus.filter(c => scopedOf(c)).length;
        return inStatus.filter(c => { const a = scopedOf(c); return !a || a.includes(key); }).length;
      };
      for (const cell of document.querySelectorAll('[data-mode-count]')) {
        cell.textContent = modeCount(cell.dataset.modeCount).toLocaleString();
      }
      const reviewed = counts.approved + counts.rejected;
      const percent = Math.round((reviewed / concepts.length) * 100);
      document.querySelector('[data-progress-percent]').textContent = `${percent}%`;
      const progress = document.querySelector('[data-progress-track]');
      progress.setAttribute('aria-valuenow', String(reviewed));
      document.querySelector('[data-progress-fill]').style.setProperty('--worlds-progress', `${(reviewed / concepts.length) * 100}%`);

      for (const button of document.querySelectorAll('[data-family-filter]')) {
        const familyId = button.dataset.familyFilter;
        const count = concepts.filter(concept =>
          (familyId === 'all' || concept.familyId === familyId)
          && (state.status === 'all' || concept.status === state.status)
        ).length;
        button.querySelector('span:last-child')?.replaceChildren(document.createTextNode(count.toLocaleString()));
      }
    }

    function ensureCurrent(rows) {
      if (rows.some(concept => concept.id === state.currentId)) return;
      state.currentId = rows[0]?.id || '';
    }

    function renderQueue(rows) {
      ensureCurrent(rows);
      const currentIndex = Math.max(0, rows.findIndex(concept => concept.id === state.currentId));
      const start = Math.max(0, Math.min(currentIndex - 24, Math.max(0, rows.length - 60)));
      const visible = rows.slice(start, start + 60);
      queueList.replaceChildren();

      if (visible.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'worlds-queue-empty';
        empty.innerHTML = '<strong>No concepts match.</strong><p>Change the status, family, or search query.</p>';
        queueList.append(empty);
      } else {
        for (const [offset, concept] of visible.entries()) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'worlds-queue-item';
          button.dataset.queueConceptId = concept.id;
          button.setAttribute('aria-pressed', String(concept.id === state.currentId));
          button.setAttribute('aria-label', `${start + offset + 1} in current queue: ${concept.form}`);
          button.tabIndex = concept.id === state.currentId ? 0 : -1;
          const index = document.createElement('span');
          index.textContent = String(start + offset + 1).padStart(3, '0');
          const copy = document.createElement('span');
          const family = document.createElement('small');
          family.textContent = concept.familyLabel;
          const form = document.createElement('strong');
          form.textContent = concept.form.split(',')[0];
          copy.append(family, form);
          button.append(index, copy);

          // The rating rides on the row, because sorting by it and then not
          // showing it means reading an order you cannot check. Shown wherever
          // an approved world can appear, and it is the meaning of the row's
          // position whenever the sort is by rating.
          if (concept.status === 'approved') {
            const stars = document.createElement('em');
            stars.className = 'worlds-queue-stars';
            const rating = concept.review?.rating || 0;
            stars.textContent = rating ? '\u2605'.repeat(rating) : '\u00b7';
            stars.title = rating ? `${rating} star` : 'approved, not yet rated';
            button.append(stars);
          }
          // Only where statuses mix. Filtered to backlog every row is pending,
          // so a dot per row said nothing and read as an unexplained marker.
          if (state.status === 'all') {
            const status = document.createElement('i');
            status.className = `is-${concept.status}`;
            status.title = concept.status;
            status.setAttribute('aria-label', concept.status);
            button.append(status);
          }
          queueList.append(button);
        }
        queueList.querySelector('[aria-pressed="true"]')?.scrollIntoView({ block: 'nearest' });
      }

      // The filtered size was on screen three times: on the status button that
      // set it, beside the queue title, and in "of N" at the foot. The header
      // copy was the one with no context around it, and dropping it is what
      // gives a long bucket name room to finish on one line.
      if (resultCount) resultCount.textContent = rows.length.toLocaleString();
      windowLabel.textContent = rows.length
        ? `Showing ${start + 1}–${Math.min(start + 60, rows.length)} of ${rows.length.toLocaleString()}`
        : 'No results';
      queueTitle.textContent = state.status === 'pending'
        ? 'Backlog'
        : state.status.charAt(0).toUpperCase() + state.status.slice(1);
    }

    function renderConcept(rows) {
      const concept = currentConcept();
      if (!concept) {
        formEl.textContent = 'No concept selected';
        wellEl.textContent = '';
        familyEl.textContent = 'Empty queue';
        idEl.textContent = 'none';
        statusEl.textContent = 'empty';
        statusEl.className = 'worlds-status-badge';
        lineageEl.textContent = 'Change the current filters to continue.';
        tagsEl.replaceChildren();
        systemEl.replaceChildren();
        sparkEl.textContent = '';
        webLeverageEl.textContent = '';
        avoidWrapEl.hidden = true;
        avoidEl.replaceChildren();
        leadWrapEl.hidden = true;
        leadImgEl.removeAttribute('src');
        cardPairEl.replaceChildren();
        reviewNoteWrapEl.hidden = true;
        reviewNoteEl.textContent = '';
        decisionNoteInput.value = '';
        notedConceptId = '';
        return;
      }

      const globalIndex = concepts.findIndex(item => item.id === concept.id);
      formEl.textContent = concept.form;
      wellEl.textContent = concept.wellLabel;
      familyEl.textContent = concept.familyLabel;
      idEl.textContent = concept.id;
      // Truncated parts keep their full value reachable on hover.
      familyEl.title = concept.familyLabel;
      idEl.title = concept.id;
      statusEl.textContent = concept.status;
      statusEl.className = `worlds-status-badge is-${concept.status}`;
      if (telemetryEl) telemetryEl.textContent = fieldLine(concept.telemetry);
      lineageEl.textContent = concept.lineage;
      systemEl.replaceChildren(...concept.system.map(rule => {
        const item = document.createElement('li');
        item.textContent = rule;
        return item;
      }));
      sparkEl.textContent = concept.spark;
      webLeverageEl.textContent = concept.webLeverage;
      avoidWrapEl.hidden = !concept.avoid?.length;
      avoidEl.replaceChildren(...(concept.avoid || []).map(item => {
        const li = document.createElement('li');
        li.textContent = item;
        return li;
      }));
      const reviewNote = concept.review?.note || '';
      reviewNoteWrapEl.hidden = !reviewNote;
      reviewNoteEl.textContent = reviewNote;
      strengthButtons.forEach(button => {
        button.setAttribute('aria-pressed', String(button.dataset.strengthOption === concept.strength));
      });
      // Each control is wrapped in a labeled field now, so approved-only
      // visibility is set on the field. Hiding the control alone would leave its
      // label behind, announcing a setting that is not there.
      const approved = concept.status === 'approved';
      for (const field of ['rating', 'reach', 'tier', 'modes']) {
        const el = reviewFields[field];
        if (el) el.hidden = !approved;
      }
      ratingButtons.forEach(button => {
        button.setAttribute('aria-pressed', String((concept.review?.rating || 0) >= Number(button.dataset.ratingOption)));
      });
      const allowed = concept.review?.allowedModes;
      for (const option of modeOptions) {
        const on = !Array.isArray(allowed) || allowed.length === 0 || allowed.includes(option.dataset.modeOption);
        option.setAttribute('aria-pressed', String(on));
      }
      setSegmentState(breadthButtons, 'breadthOption', concept.review?.breadth === 'niche' ? 'niche' : 'general');
      setSegmentState(tierButtons, 'tierOption', concept.review?.pro ? 'pro' : 'free');
      // The decision-note field mirrors the current concept's saved note.
      // Only refill when the concept changes so re-renders never clobber typing.
      if (concept.id !== notedConceptId) {
        decisionNoteInput.value = reviewNote;
        notedConceptId = concept.id;
      }
      renderEvidence(concept);
      positionEl.textContent = String(globalIndex + 1).padStart(3, '0');
      tagsEl.replaceChildren(...concept.tags.map(tag => {
        const span = document.createElement('span');
        span.textContent = tag;
        return span;
      }));
      for (const button of document.querySelectorAll('[data-review-status]')) {
        button.classList.toggle('is-current', button.dataset.reviewStatus === concept.status);
      }
      const position = rows.findIndex(item => item.id === concept.id);
      document.querySelector('[data-previous]').disabled = position <= 0;
      document.querySelector('[data-next]').disabled = position === -1 || position >= rows.length - 1;
    }

    function render() {
      const rows = filteredConcepts();
      renderCounts();
      renderQueue(rows);
      renderConcept(rows);
      renderCardGrid();
      renderCoverage();
      renderSites();
      renderTriage();
      // Here rather than in renderConcept, which does not run on the views that
      // have no current concept, so those never made it into the URL.
      writeHash();
    }

    function move(delta, focusQueue = false) {
      const rows = filteredConcepts();
      if (rows.length === 0) return;
      const currentIndex = Math.max(0, rows.findIndex(concept => concept.id === state.currentId));
      const nextIndex = Math.max(0, Math.min(rows.length - 1, currentIndex + delta));
      state.currentId = rows[nextIndex].id;
      renderQueue(rows);
      renderConcept(rows);
      if (focusQueue) queueList.querySelector('[aria-pressed="true"]')?.focus();
    }

    async function persistReview(concept, status, note = '') {
      const response = await fetch('/__impeccable/worlds', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'review', id: concept.id, status, ...(note ? { note } : {}) }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Review could not be saved');
      return result.result.review;
    }

    function revealUndo(review) {
      lastReview = review;
      undoLabel.textContent = `Undo ${review.nextStatus}: ${review.form.split(',')[0]}`;
      undoButton.hidden = false;
    }

    async function review(status) {
      const concept = currentConcept();
      if (!canWrite || !concept) return;
      const note = decisionNoteInput.value.trim();
      const sameStatus = concept.status === status;
      const savedNote = concept.review?.note || '';
      // A same-status decision re-saves only when the note changed (added,
      // edited, or cleared); otherwise it is a no-op. Backlog entries hold no
      // review record, so notes cannot attach to them.
      if (note && status === 'pending') {
        showToast('Notes attach to approve or reject; clear the note first to return to backlog', 'error');
        return;
      }
      if (sameStatus && note === savedNote) return;
      const rowsBefore = filteredConcepts();
      const indexBefore = rowsBefore.findIndex(item => item.id === concept.id);
      const previousStatus = concept.status;
      const buttons = [...document.querySelectorAll('[data-review-status]')];
      buttons.forEach(button => { button.disabled = true; });
      undoButton.disabled = true;
      setReviewBusy(true, sameStatus ? 'Saving note…' : `Saving ${status} decision…`);
      try {
        const savedReview = await persistReview(concept, status, note);
        concept.status = status;
        concept.review = savedReview;
        if (!sameStatus) revealUndo({ id: concept.id, form: concept.form, previousStatus, nextStatus: status });
        const rowsAfter = filteredConcepts();
        if (!rowsAfter.some(item => item.id === concept.id)) {
          state.currentId = rowsAfter[Math.min(Math.max(indexBefore, 0), Math.max(0, rowsAfter.length - 1))]?.id || '';
        }
        render();
        showToast(sameStatus
          ? `${note ? 'Note saved' : 'Note removed'}: ${concept.form.split(',')[0]}`
          : `${status === 'pending' ? 'Returned' : status === 'approved' ? 'Approved' : 'Rejected'}: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      } finally {
        buttons.forEach(button => { button.disabled = !canWrite; });
        undoButton.disabled = !canWrite;
        setReviewBusy(false);
      }
    }

    async function setStrength(strength) {
      const concept = currentConcept();
      if (!canWrite || !concept || concept.strength === strength) return;
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'strength', id: concept.id, strength }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Strength could not be saved');
        concept.strength = strength;
        document.querySelector('[data-catalog-version]').textContent = result.result.catalogVersion;
        render();
        flashWrite('strength');
        showToast(`Typed as ${strength}: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      }
    }

    async function setRating(value) {
      const concept = currentConcept();
      if (!canWrite || !concept || concept.status !== 'approved') return;
      // Rating the current value again clears it.
      const rating = concept.review?.rating === value ? null : value;
      const rowsBefore = filteredConcepts();
      const indexBefore = rowsBefore.findIndex(item => item.id === concept.id);
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'rate', id: concept.id, rating }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Rating could not be saved');
        concept.review = result.result.review;
        // In the unrated filter a rated item leaves the list; advance in place.
        const rowsAfter = filteredConcepts();
        if (!rowsAfter.some(item => item.id === concept.id)) {
          state.currentId = rowsAfter[Math.min(Math.max(indexBefore, 0), Math.max(0, rowsAfter.length - 1))]?.id || concept.id;
        }
        render();
        flashWrite('rating');
        showToast(rating
          ? `Rated ${'★'.repeat(rating)}: ${concept.form.split(',')[0]}`
          : `Rating cleared: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      }
    }

    // Breadth is not a quality grade. It answers whether a world can serve an
    // arbitrary build, so an excellent but narrow world can be held out of
    // challenger draws without being libelled as marginal.
    async function togglePro() {
      const concept = currentConcept();
      if (!canWrite || !concept || concept.status !== 'approved') return;
      const pro = !concept.review?.pro;
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'pro', id: concept.id, pro }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Pro could not be saved');
        concept.review = result.result.review;
        render();
        flashWrite('tier');
        showToast(pro
          ? `Reserved for Pro, out of the free roll: ${concept.form.split(',')[0]}`
          : `Back in the free roll: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      }
    }

    async function toggleBreadth() {
      const concept = currentConcept();
      if (!canWrite || !concept || concept.status !== 'approved') return;
      const breadth = concept.review?.breadth === 'niche' ? 'general' : 'niche';
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'breadth', id: concept.id, breadth }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Breadth could not be saved');
        concept.review = result.result.review;
        render();
        flashWrite('reach');
        showToast(breadth === 'niche'
          ? `Held out of challenger draws: ${concept.form.split(',')[0]}`
          : `Back in challenger draws: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      }
    }

    // Mode eligibility is a ceiling, not a category. A world with every mode on
    // is eligible everywhere, which is also what an absent field means, so the
    // endpoint stores nothing in that case and the buttons simply read as all-on.
    async function toggleMode(mode) {
      const concept = currentConcept();
      if (!canWrite || !concept || concept.status !== 'approved') return;
      const current = Array.isArray(concept.review?.allowedModes) && concept.review.allowedModes.length > 0
        ? [...concept.review.allowedModes]
        : ['persuade', 'operate', 'read', 'experience'];
      const next = current.includes(mode) ? current.filter(entry => entry !== mode) : [...current, mode];
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'modes', id: concept.id, allowedModes: next }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Mode eligibility could not be saved');
        concept.review = result.result.review;
        render();
        flashWrite('modes');
        const saved = result.result.allowedModes;
        showToast(saved
          ? `Eligible for ${saved.join(', ')}: ${concept.form.split(',')[0]}`
          : `Eligible in every mode: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      }
    }

    async function undoLastReview() {
      if (!canWrite || !lastReview) return;
      const review = lastReview;
      const concept = conceptMap.get(review.id);
      if (!concept) return;
      const buttons = [...document.querySelectorAll('[data-review-status]')];
      buttons.forEach(button => { button.disabled = true; });
      undoButton.disabled = true;
      setReviewBusy(true, 'Restoring the previous decision…');
      try {
        concept.review = await persistReview(concept, review.previousStatus);
        concept.status = review.previousStatus;
        state.currentId = concept.id;
        lastReview = null;
        undoButton.hidden = true;
        render();
        showToast(`Restored: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      } finally {
        buttons.forEach(button => { button.disabled = !canWrite; });
        undoButton.disabled = !canWrite;
        setReviewBusy(false);
      }
    }

    function editorSnapshot() {
      const data = new FormData(editForm);
      return JSON.stringify([...data.entries()]);
    }

    function openEditor() {
      const concept = currentConcept();
      if (!canWrite || !concept) return;
      editForm.elements.form.value = concept.form;
      editForm.elements.familyId.value = concept.familyId;
      editForm.elements.lineage.value = concept.lineage;
      editForm.elements.tag1.value = concept.tags[0];
      editForm.elements.tag2.value = concept.tags[1];
      editForm.elements.tag3.value = concept.tags[2];
      editForm.elements.system1.value = concept.system[0];
      editForm.elements.system2.value = concept.system[1];
      editForm.elements.system3.value = concept.system[2];
      editForm.elements.system4.value = concept.system[3];
      editForm.elements.system5.value = concept.system[4];
      editForm.elements.spark.value = concept.spark;
      editForm.elements.webLeverage.value = concept.webLeverage;
      editorBaseline = editorSnapshot();
      editForm.hidden = false;
      editForm.elements.form.focus();
    }

    function closeEditor(force = false) {
      if (!force && !editForm.hidden && editorSnapshot() !== editorBaseline) {
        const discard = window.confirm('Discard your unsaved concept edits?');
        if (!discard) return false;
      }
      editForm.hidden = true;
      return true;
    }

    async function saveEdit(event) {
      event.preventDefault();
      const concept = currentConcept();
      if (!canWrite || !concept) return;
      const submit = editForm.querySelector('[type="submit"]');
      submit.disabled = true;
      const data = new FormData(editForm);
      const body = {
        action: 'update',
        id: concept.id,
        form: data.get('form'),
        familyId: data.get('familyId'),
        lineage: data.get('lineage'),
        tags: [data.get('tag1'), data.get('tag2'), data.get('tag3')],
        system: [data.get('system1'), data.get('system2'), data.get('system3'), data.get('system4'), data.get('system5')],
        spark: data.get('spark'),
        webLeverage: data.get('webLeverage'),
      };
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Concept could not be saved');
        const previousStatus = concept.status;
        const saved = result.result.concept;
        concept.form = saved.form;
        concept.lineage = saved.lineage;
        concept.tags = saved.tags;
        concept.system = saved.system;
        concept.spark = saved.spark;
        concept.webLeverage = saved.webLeverage;
        concept.status = result.result.status;
        concept.review = null;
        if (concept.card) concept.card.stale = true;
        if (concept.familyId !== result.result.familyId) {
          const target = familyMap.get(result.result.familyId);
          concept.familyId = result.result.familyId;
          concept.familyLabel = target.label;
          concept.wellId = target.wellId;
          concept.wellLabel = target.wellLabel;
        }
        document.querySelector('[data-catalog-version]').textContent = result.result.catalogVersion;
        if (lastReview?.id === concept.id) {
          lastReview = null;
          undoButton.hidden = true;
        }
        editorBaseline = editorSnapshot();
        closeEditor(true);
        render();
        showToast(previousStatus === 'pending'
          ? 'Concept source updated'
          : 'Concept updated and returned to the backlog');
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      } finally {
        submit.disabled = false;
      }
    }

    for (const button of document.querySelectorAll('[data-view]')) {
      button.addEventListener('click', () => {
        state.view = button.dataset.view;
        render();
      });
    }
    // Clicking a card opens it, because the grid is for finding one rather than
    // for judging in place: every decision control lives on the detail stage.
    // Coverage interactions. Expanding a value is how a real opening is told from
    // a bad probe: a row at 1% with nothing under it is a hole, a row at 1% whose
    // matched list is full of the wrong worlds is a keyword problem.
    coveragePanel.addEventListener('click', event => {
      const valueButton = event.target.closest('[data-value-key]');
      if (valueButton) {
        const key = valueButton.dataset.valueKey;
        coverageState.open = coverageState.open === key ? null : key;
        renderCoverage();
        return;
      }
      const unplacedButton = event.target.closest('[data-unplaced]');
      if (unplacedButton) {
        const key = 'unplaced/' + unplacedButton.dataset.unplaced;
        coverageState.open = coverageState.open === key ? null : key;
        renderCoverage();
        return;
      }
      if (event.target.closest('[data-save-axes]')) saveAxes();
    });

    // Recount as you type, so a keyword change shows its effect before it is
    // written. The input keeps focus and the caret, since re-rendering the whole
    // panel under a typing cursor is otherwise unusable.
    coveragePanel.addEventListener('input', event => {
      const input = event.target.closest('[data-match-key]');
      if (!input) return;
      const [axisId, valueId] = input.dataset.matchKey.split('/');
      const axis = AXES.find(a => a.id === axisId);
      const value = axis?.values?.find(v => v.id === valueId);
      if (!value) return;
      value.match = input.value.split(',').map(word => word.trim()).filter(Boolean);
      coverageState.dirty = true;
      const caret = input.selectionStart;
      renderCoverage();
      const again = coveragePanel.querySelector('[data-match-key="' + input.dataset.matchKey + '"]');
      if (again) {
        again.focus();
        again.setSelectionRange(caret, caret);
      }
    });

    async function saveAxes() {
      if (!canWrite || !coverageState.dirty) return;
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ catalog: 'axes', action: 'axes', axes: { ...payload.aestheticAxes, axes: AXES } }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Axes could not be saved');
        coverageState.dirty = false;
        renderCoverage();
        showToast('Axes saved: ' + result.result.axes + ' axes');
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      }
    }

    cardGridItems.addEventListener('click', event => {
      const card = event.target.closest('[data-card-id]');
      if (!card) return;
      // Stay in the grid. Clicking a thumbnail loads it on the stage beside the
      // grid, so a run of thumbnails can be judged without the view flipping
      // back and losing your place in five hundred of them.
      state.currentId = card.dataset.cardId;
      render();
    });
    document.querySelectorAll('[data-mode-filter]').forEach(button => {
      button.addEventListener('click', () => {
        state.mode = button.dataset.modeFilter;
        document.querySelectorAll('[data-mode-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        render();
      });
    });
    // One wiring for the three refine axes, since they behave identically and a
    // third copy of the same eight lines is where they start to drift apart.
    for (const [attribute, key] of [['ratingFilter', 'rating'], ['reachFilter', 'reach'], ['tierFilter', 'tier']]) {
      const selector = `[data-${attribute.replace(/([A-Z])/g, '-$1').toLowerCase()}]`;
      document.querySelectorAll(selector).forEach(button => {
        button.addEventListener('click', () => {
          state[key] = button.dataset[attribute];
          document.querySelectorAll(selector).forEach(item => item.setAttribute('aria-pressed', String(item === button)));
          render();
        });
      });
    }
    // Three icon buttons rather than a select. The select rendered its own
    // value clipped as "Catalog orde" in the space the header could spare, and
    // spelling out the current sort is not worth a third of the queue header.
    document.querySelectorAll('[data-sort]').forEach(button => {
      button.addEventListener('click', () => {
        state.sort = button.dataset.sort;
        document.querySelectorAll('[data-sort]').forEach(item => {
          item.setAttribute('aria-pressed', String(item === button));
        });
        // Move to the top of the new order. The queue window follows the current
        // concept, so re-sorting while parked at row 124 re-sorts the list and
        // then shows you row 124 of it, which looks exactly like nothing sorted.
        const rows = filteredConcepts();
        if (rows.length) state.currentId = rows[0].id;
        render();
      });
    });
    document.querySelectorAll('[data-status-filter]').forEach(button => {
      button.addEventListener('click', () => {
        state.status = button.dataset.statusFilter;
        document.querySelectorAll('[data-status-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        render();
      });
    });
    document.querySelectorAll('[data-family-filter]').forEach(button => {
      button.addEventListener('click', () => {
        state.family = button.dataset.familyFilter;
        document.querySelectorAll('[data-family-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        renderFamilyDirectory();
        render();
      });
    });
    familySearchInput.addEventListener('input', renderFamilyDirectory);
    familyExpandButton.addEventListener('click', () => {
      familyExpanded = !familyExpanded;
      renderFamilyDirectory();
    });
    document.querySelector('.worlds-family-scroll').addEventListener('keydown', event => {
      if (!event.target.matches('[data-family-filter]')) return;
      if (!['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const visible = familyButtons.filter(button => !button.hidden);
      const index = visible.indexOf(event.target);
      const nextIndex = event.key === 'Home'
        ? 0
        : event.key === 'End'
          ? visible.length - 1
          : Math.max(0, Math.min(visible.length - 1, index + (['ArrowDown', 'ArrowRight'].includes(event.key) ? 1 : -1)));
      visible.forEach(button => { button.tabIndex = -1; });
      visible[nextIndex].tabIndex = 0;
      visible[nextIndex].focus();
    });
    queueList.addEventListener('click', event => {
      const button = event.target.closest('[data-queue-concept-id]');
      if (!button) return;
      state.currentId = button.dataset.queueConceptId;
      render();
    });
    queueList.addEventListener('keydown', event => {
      if (!event.target.closest('[data-queue-concept-id]')) return;
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        move(1, true);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        move(-1, true);
      }
    });
    searchInput.addEventListener('input', () => {
      state.query = searchInput.value;
      render();
    });
    document.querySelector('[data-previous]').addEventListener('click', () => move(-1));
    document.querySelector('[data-next]').addEventListener('click', () => move(1));
    strengthButtons.forEach(button => {
      button.addEventListener('click', () => setStrength(button.dataset.strengthOption));
    });
    ratingButtons.forEach(button => {
      button.addEventListener('click', () => setRating(Number(button.dataset.ratingOption)));
    });
    // Picking the value that is already set is a no-op, not a flip. The old
    // single-button form had no way to express that: any click toggled, so the
    // only way to confirm a world was General was to make it Niche and back.
    breadthButtons.forEach(button => {
      button.addEventListener('click', () => {
        const concept = currentConcept();
        const current = concept?.review?.breadth === 'niche' ? 'niche' : 'general';
        if (button.dataset.breadthOption !== current) toggleBreadth();
      });
    });
    tierButtons.forEach(button => {
      button.addEventListener('click', () => {
        const concept = currentConcept();
        const current = concept?.review?.pro ? 'pro' : 'free';
        if (button.dataset.tierOption !== current) togglePro();
      });
    });
    for (const option of modeOptions) {
      option.addEventListener('click', () => toggleMode(option.dataset.modeOption));
    }
    document.querySelectorAll('[data-review-status]').forEach(button => {
      button.addEventListener('click', () => review(button.dataset.reviewStatus));
    });
    undoButton.addEventListener('click', undoLastReview);
    document.querySelector('[data-edit-toggle]').addEventListener('click', openEditor);
    document.querySelectorAll('[data-edit-cancel]').forEach(button => button.addEventListener('click', () => closeEditor()));
    editForm.addEventListener('submit', saveEdit);
    window.addEventListener('hashchange', () => {
      const params = readHash();
      const id = params.get('concept') || '';
      const view = params.get('view') || 'detail';
      let changed = false;
      if (conceptMap.has(id) && id !== state.currentId) { state.currentId = id; changed = true; }
      if (VIEWS.has(view) && view !== state.view) { state.view = view; changed = true; }
      if (changed) render();
    });
    document.addEventListener('keydown', event => {
      const target = event.target;
      if (event.key === 'Escape' && !editForm.hidden) {
        event.preventDefault();
        closeEditor();
        return;
      }
      if (target === decisionNoteInput && event.altKey) {
        // Decision shortcuts stay live while typing a note: write the reason,
        // then commit with the same keys. event.code sidesteps macOS Alt
        // remapping inside text inputs.
        if (event.code === 'KeyA') { event.preventDefault(); review('approved'); return; }
        if (event.code === 'KeyR') { event.preventDefault(); review('rejected'); return; }
        if (event.code === 'KeyU') { event.preventDefault(); review('pending'); return; }
      }
      if (event.key === 'Escape' && !lightbox.hidden) {
        event.preventDefault();
        closeLightbox();
        return;
      }
      // Triage owns the digits while it is up. They mean rating on the stage and
      // variant here, and the stage is not visible to be rated.
      if (state.view === 'triage' && !(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) {
        if (['1', '2', '3'].includes(event.key) && !event.altKey && !event.metaKey && !event.ctrlKey) {
          event.preventDefault();
          triagePick(Number(event.key) - 1);
          return;
        }
        if (event.key === 'ArrowRight' || event.key === 'Enter') { event.preventDefault(); triageMove(1); return; }
        if (event.key === 'ArrowLeft') { event.preventDefault(); triageMove(-1); return; }
      }
      if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement || target.isContentEditable) {
        return;
      }
      // The search field has always shown a "/" hint and nothing was bound to
      // it, so the label was teaching a shortcut that did not exist.
      if (event.key === '/') {
        event.preventDefault();
        document.querySelector('[data-search]')?.focus();
        return;
      }
      if (event.key === '/') {
        event.preventDefault();
        searchInput.focus();
      } else if (event.key.toLowerCase() === 'j') {
        move(1, Boolean(target.closest?.('[data-queue-list]')));
      } else if (event.key.toLowerCase() === 'k') {
        move(-1, Boolean(target.closest?.('[data-queue-list]')));
      } else if (event.key === 'ArrowDown' && !event.altKey && !event.metaKey && !event.ctrlKey) {
        event.preventDefault();
        move(1, Boolean(target.closest?.('[data-queue-list]')));
      } else if (event.key === 'ArrowUp' && !event.altKey && !event.metaKey && !event.ctrlKey) {
        event.preventDefault();
        move(-1, Boolean(target.closest?.('[data-queue-list]')));
      } else if (event.altKey && event.key.toLowerCase() === 'a') {
        event.preventDefault();
        review('approved');
      } else if (event.altKey && event.key.toLowerCase() === 'r') {
        event.preventDefault();
        review('rejected');
      } else if (event.altKey && event.key.toLowerCase() === 'u') {
        event.preventDefault();
        review('pending');
      } else if (event.altKey && event.key.toLowerCase() === 'z') {
        event.preventDefault();
        undoLastReview();
      } else if (event.key.toLowerCase() === 'v' && !event.altKey && !event.metaKey && !event.ctrlKey) {
        // Both queue buttons have advertised this in their title and their
        // aria-keyshortcuts since they were added, and nothing was listening.
        state.view = state.view === 'cards' ? 'detail' : 'cards';
        render();
      } else if (event.key.toLowerCase() === 'e') {
        openEditor();
      } else if (['1', '2', '3'].includes(event.key) && !event.altKey && !event.metaKey && !event.ctrlKey) {
        setRating(Number(event.key));
      } else if (event.key.toLowerCase() === 'n' && !event.altKey && !event.metaKey && !event.ctrlKey) {
        toggleBreadth();
      } else if (event.key.toLowerCase() === 'p' && !event.altKey && !event.metaKey && !event.ctrlKey) {
        togglePro();
      }
    });
    window.addEventListener('beforeunload', event => {
      if (!editForm.hidden && editorSnapshot() !== editorBaseline) event.preventDefault();
    });

    if (!conceptMap.has(state.currentId)) state.currentId = filteredConcepts()[0]?.id || concepts[0]?.id || '';
    syncStatusTabs();
    renderFamilyDirectory();
    render();
  </script>
</Base>
