---
// Dev-only lab: never render (or inline catalog data) in a production build.
if (!import.meta.env.DEV) return Astro.redirect('/');

import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import '../../styles/sub-pages.css';
import '../../styles/worlds-lab.css';
import { conceptContentHash } from '../../../skill/scripts/lib/concept-catalog.mjs';

const ROOT = process.cwd();
const catalog = JSON.parse(fs.readFileSync(path.join(ROOT, 'catalog', 'concept-ingredients.json'), 'utf8'));
const reviewData = JSON.parse(fs.readFileSync(path.join(ROOT, 'catalog', 'concept-reviews.json'), 'utf8'));
const reviews = reviewData.reviews || {};
const CARD_DIR = path.join(ROOT, 'site', 'public', 'worlds', 'cards');
const cardManifest = (() => {
  try { return JSON.parse(fs.readFileSync(path.join(CARD_DIR, 'manifest.json'), 'utf8')); } catch { return {}; }
})();
// Cards live in R2 in production (functions/worlds/cards). A local generation
// output is preferred when present; a clone without local cards falls back to
// the published set so the lab still shows them.
const PROD_CARDS_BASE = 'https://impeccable.style/worlds/cards';
const cardFor = concept => {
  const row = cardManifest[concept.id];
  const localExists = fs.existsSync(path.join(CARD_DIR, `${concept.id}.webp`));
  if (!localExists && !row) return null;
  // Cards are regenerated under the same filename, so the URL carries the
  // generation timestamp: browsers and CDNs refetch exactly when a card changes.
  const generated = Date.parse(row?.generatedAt || 0) || 0;
  const base = localExists ? '/worlds/cards' : PROD_CARDS_BASE;
  const heroLocal = fs.existsSync(path.join(CARD_DIR, `${concept.id}-hero.webp`));
  const heroGenerated = Date.parse(row?.heroGeneratedAt || 0) || 0;
  // The docs render answers a question the hero cannot: the hero is a landing
  // page, so a world judged only on it is judged on how well it persuades.
  const docsLocal = fs.existsSync(path.join(CARD_DIR, `${concept.id}-docs.webp`));
  const docsGenerated = Date.parse(row?.docsGeneratedAt || 0) || 0;
  return {
    docsSrc: (docsLocal || row?.docsGeneratedAt)
      ? `${docsLocal ? '/worlds/cards' : PROD_CARDS_BASE}/${concept.id}-docs.webp?v=${docsGenerated.toString(36)}`
      : null,
    src: `${base}/${concept.id}.webp?v=${generated.toString(36)}`,
    heroSrc: (heroLocal || row?.heroGeneratedAt)
      ? `${heroLocal ? '/worlds/cards' : PROD_CARDS_BASE}/${concept.id}-hero.webp?v=${heroGenerated.toString(36)}`
      : null,
    stale: row?.hash !== conceptContentHash(concept),
  };
};
const wellsById = new Map((catalog.wells || []).map(well => [well.id, well]));
const families = catalog.families.map(family => ({
  id: family.id,
  label: family.label,
  description: family.description,
  wellId: family.well,
  wellLabel: wellsById.get(family.well)?.label || '',
  concepts: family.concepts.map(concept => ({
    ...concept,
    card: cardFor(concept),
    familyId: family.id,
    familyLabel: family.label,
    wellId: family.well,
    wellLabel: wellsById.get(family.well)?.label || '',
    // Tier drives the challenger draw and the coverage view's lineage grid, and
    // was the one well property the payload never carried.
    wellTier: wellsById.get(family.well)?.tier || null,
    status: reviews[concept.id]?.status || 'pending',
    review: reviews[concept.id] || null,
  })),
}));
const wellGroups = (catalog.wells || [])
  .map(well => ({ well, families: families.filter(family => family.wellId === well.id) }))
  .filter(group => group.families.length > 0);
const concepts = families.flatMap(family => family.concepts);
const initialConcept = concepts.find(concept => concept.status === 'pending') || concepts[0];
const counts = {
  total: concepts.length,
  approved: concepts.filter(concept => concept.status === 'approved').length,
  pending: concepts.filter(concept => concept.status === 'pending').length,
  rejected: concepts.filter(concept => concept.status === 'rejected').length,
};
counts.reviewed = counts.approved + counts.rejected;
const aestheticAxes = JSON.parse(fs.readFileSync(path.join(ROOT, 'catalog', 'aesthetic-axes.json'), 'utf8'));
const pageData = JSON.stringify({
  catalogVersion: catalog.catalogVersion,
  canWrite: import.meta.env.DEV,
  families,
  aestheticAxes,
}).replace(/</g, '\\u003c');
---

<!-- DIRECTION CONTRACT: THESIS: Turn an abstract challenger corpus into a human-governed editorial queue that rejects the tiled catalog and admin-dashboard defaults; one vivid world earns focused attention and proves its durable web structure. OWN-WORLD: Lacquer, kinpaku commitment, patina state, neutral hairlines, compact Albert Sans UI. STORY: Find pending work, picture the world immediately, judge whether its material and spatial laws become a real web system, decide, and advance the trusted pool. FIRST VIEWPORT: Well/progress rail, searchable queue, and one full-height review stage with keyboard-visible actions. BAR-RAISER: Every concept exposes an unforgettable scene, reusable system grammar, and browser-native leverage before approval. FORM: A catalog editor crossed with a contact-sheet loupe; hundreds of entries collapse into one precise judgment. UNIQUE: The review stage is a single editorial loupe with a folio counter (Catalog 001 of N), a lineage margin, and Option-chord decisions that write straight to source JSON; the queue lives in a side rail and never becomes the page. NOT-TEMPLATE: No tiled card grid, no stat-hero band, no modal-per-decision; aggregate numbers stay confined to the rail's progress block and the stage never shows more than one world. Seed key: not run; structure inherits the established Detector Lab. -->
<Base
  title="World Catalog | Impeccable"
  description="Browse and review the concept forms that challenge grounded Impeccable design directions."
  bodyClass="sub-page worlds-lab-page"
  mainClass="worlds-main-shell"
  noIndex
  hideHeader
  hideFooter
>
  <section class="worlds-workbench" aria-label="Concept world catalog">
    <nav class="worlds-skip-links" aria-label="Catalog shortcuts">
      <a href="#worlds-search">Skip to search</a>
      <a href="#worlds-review">Skip to review</a>
    </nav>
    <aside class="worlds-family-rail" aria-label="Catalog families and review status">
      <div class="worlds-rail-head">
        <a class="worlds-home-link ks-brand" href="/" aria-label="Back to Impeccable">
          <span class="ks-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M5 2.5 L13.5 2.5 L5.5 21.5 L5 21.5 Q2.5 21.5 2.5 19 L2.5 5 Q2.5 2.5 5 2.5 Z"></path>
              <path d="M16.5 2.5 L19 2.5 Q21.5 2.5 21.5 5 L21.5 19 Q21.5 21.5 19 21.5 L8.5 21.5 Z"></path>
            </svg>
          </span>
          <span class="ks-wordmark">Impeccable</span>
        </a>
        <div class="worlds-title-lockup">
          <p>Challenger corpus</p>
          <h1>World Catalog</h1>
        </div>

        <nav class="worlds-catalog-switch" aria-label="Catalog">
          <a href="/labs/worlds" aria-current="page">Worlds</a>
          <a href="/labs/compositions">Compositions</a>
        </nav>

        <div class="worlds-progress-block">
          <div class="worlds-progress-copy">
            <span>Human reviewed</span>
            <strong data-progress-percent>{Math.round((counts.reviewed / counts.total) * 100)}%</strong>
          </div>
          <div class="worlds-progress-track" role="progressbar" aria-label="Catalog review progress" aria-valuemin="0" aria-valuemax={counts.total} aria-valuenow={counts.reviewed} data-progress-track>
            <span style={`--worlds-progress: ${(counts.reviewed / counts.total) * 100}%`} data-progress-fill></span>
          </div>
          <div class="worlds-status-grid" role="group" aria-label="Filter concepts by review status">
            <button type="button" data-status-filter="pending" aria-pressed="true">
              <span>Backlog</span><strong data-count-pending>{counts.pending}</strong>
            </button>
            <button type="button" data-status-filter="approved" aria-pressed="false">
              <span>Approved</span><strong data-count-approved>{counts.approved}</strong>
            </button>
            <button type="button" data-status-filter="rejected" aria-pressed="false">
              <span>Rejected</span><strong data-count-rejected>{counts.rejected}</strong>
            </button>
            <button type="button" data-status-filter="unrated" aria-pressed="false" title="Approved worlds without a star rating yet">
              <span>Unrated</span><strong data-count-unrated>{concepts.filter(concept => concept.status === 'approved' && !concept.review?.rating).length}</strong>
            </button>
            <button type="button" data-status-filter="all" aria-pressed="false">
              <span>All</span><strong data-count-total>{counts.total}</strong>
            </button>
          </div>
        </div>
      </div>

      <div class="worlds-filter-section">
        <span class="worlds-filter-heading">Eligible for mode</span>
        <div class="worlds-status-grid" role="group" aria-label="Filter concepts by the mode they can carry">
          <button type="button" data-mode-filter="all" aria-pressed="true">
            <span>Any</span><strong data-mode-count="all">0</strong>
          </button>
          <button type="button" data-mode-filter="unscoped" aria-pressed="false" title="Worlds nobody has narrowed, so they are eligible in every mode">
            <span>Every mode</span><strong data-mode-count="unscoped">0</strong>
          </button>
          {['persuade', 'operate', 'read', 'experience'].map(value => (
            <button type="button" data-mode-filter={value} aria-pressed="false" title={`Worlds a ${value} build can draw from, narrowed or not`}>
              <span>{value.charAt(0).toUpperCase() + value.slice(1)}</span><strong data-mode-count={value}>0</strong>
            </button>
          ))}
          <button type="button" data-mode-filter="scoped" aria-pressed="false" title="Only worlds whose eligibility someone has narrowed">
            <span>Narrowed</span><strong data-mode-count="scoped">0</strong>
          </button>
        </div>
      </div>

      <label class="worlds-family-search">
        <span>Find a family</span>
        <input type="search" placeholder={`Filter ${catalog.families.length} families`} autocomplete="off" data-family-search>
      </label>
      <nav class="worlds-family-scroll" aria-label="Concept families">
        <button type="button" class="worlds-family-button" data-family-filter="all" aria-pressed="true">
          <span>All families</span>
          <span data-family-count="all">{counts.pending}</span>
        </button>
        {wellGroups.map(group => (
          <>
            <p class="worlds-well-heading" data-well-heading={group.well.id} hidden>{group.well.label}</p>
            {group.families.map(family => (
              <button type="button" class="worlds-family-button" data-family-filter={family.id} data-family-well={group.well.id} data-family-label={`${family.label} ${group.well.label}`.toLowerCase()} aria-pressed="false" tabindex="-1" hidden>
                <span>{family.label}</span>
                <span data-family-count={family.id}>{family.concepts.filter(concept => concept.status === 'pending').length}</span>
              </button>
            ))}
          </>
        ))}
        <p class="worlds-family-empty" data-family-empty hidden>No families match.</p>
        <button type="button" class="worlds-family-expand" data-family-expand aria-expanded="false">
          Browse all {families.length} families
        </button>
      </nav>
    </aside>

    <div class="worlds-workspace">
      <header class="worlds-toolbar">
        <label class="worlds-search">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="m15.5 15.5 5 5"></path>
          </svg>
          <input id="worlds-search" type="search" aria-label="Search concepts" placeholder="Search forms, systems, lineage, or IDs" autocomplete="off" data-search>
          <kbd>/</kbd>
        </label>
        <div class="worlds-runtime-state">
          <span class:list={{ 'is-live': import.meta.env.DEV }} aria-hidden="true"></span>
          <div>
            <strong>{import.meta.env.DEV ? 'Source writing active' : 'Read-only catalog'}</strong>
            <small>{import.meta.env.DEV ? 'Changes persist to skill/scripts' : 'Run bun run dev to review'}</small>
          </div>
        </div>
      </header>

      <div class="worlds-workspace-grid">
        <aside class="worlds-queue" aria-label="Filtered concept queue">
          <header class="worlds-queue-head">
            <div>
              <p>Review queue</p>
              <strong data-queue-title>Backlog</strong>
            </div>
            <span data-result-count>{counts.pending.toLocaleString()}</span>
          </header>
          <div class="worlds-queue-list" data-queue-list></div>
          <footer class="worlds-queue-foot">
            <span data-window-label>Loading catalog…</span>
            <div>
              <button type="button" aria-label="Previous concept" data-previous aria-keyshortcuts="ArrowUp K"><kbd>↑</kbd><kbd>K</kbd></button>
              <button type="button" aria-label="Next concept" data-next aria-keyshortcuts="ArrowDown J"><kbd>↓</kbd><kbd>J</kbd></button>
            </div>
          </footer>
        </aside>

        <article id="worlds-review" class="worlds-review-stage" aria-labelledby="current-concept-form" tabindex="-1">
          <header class="worlds-review-head">
            <div class="worlds-review-context">
              <div class="worlds-review-path">
              <span data-concept-well>{initialConcept.wellLabel}</span>
              <span aria-hidden="true">/</span>
              <span data-concept-family>{initialConcept.familyLabel}</span>
              <span aria-hidden="true">/</span>
                <code data-concept-id>{initialConcept.id}</code>
              </div>
              <div class="worlds-review-glance">
                <div class="worlds-view-toggle" role="group" aria-label="Stage view" data-view-toggle>
                  <button type="button" data-view="detail" aria-pressed="true" title="One concept at a time (press V to switch)" aria-keyshortcuts="v">detail</button>
                  <button type="button" data-view="cards" aria-pressed="false" title="Every filtered concept as a card (press V to switch)" aria-keyshortcuts="v">cards</button>
                  <button type="button" data-view="coverage" aria-pressed="false" title="Where the catalog is crowded and where it is open">coverage</button>
                </div>
              <span class="worlds-review-folio">Catalog <strong data-concept-position>{String(concepts.findIndex(concept => concept.id === initialConcept.id) + 1).padStart(3, '0')}</strong> / {counts.total.toLocaleString()}</span>
              <span class={`worlds-status-badge is-${initialConcept.status}`} data-concept-status>{initialConcept.status}</span>
            </div>
            </div>
            <div class="worlds-review-controls">
              <div class="worlds-rating" role="group" aria-label="Approval rating: how strong this approved world is" data-rating-group hidden={initialConcept.status !== 'approved'}>
                {[1, 2, 3].map(value => (
                  <button
                    type="button"
                    data-rating-option={value}
                    aria-pressed={String((initialConcept.review?.rating || 0) >= value)}
                    disabled={!import.meta.env.DEV}
                    title={value === 3 ? 'Exceptional: flagship-grade world (press 3)' : value === 2 ? 'Solid approved world (press 2)' : 'Marginal keep (press 1)'}
                  >★</button>
                ))}
              </div>
              <button
                type="button"
                class="worlds-breadth-toggle"
                data-breadth-toggle
                hidden={initialConcept.status !== 'approved'}
                aria-pressed={String(initialConcept.review?.breadth === 'niche')}
                disabled={!import.meta.env.DEV}
                title="Niche: keep the approval but hold this world out of challenger draws (press N)"
                aria-keyshortcuts="n"
              >Niche</button>
              <div
                class="worlds-modes"
                role="group"
                aria-label="Mode eligibility: which registers of work this world can carry"
                data-modes-group
                hidden={initialConcept.status !== 'approved'}
              >
                {['persuade', 'operate', 'read', 'experience'].map(value => (
                  <button
                    type="button"
                    class="worlds-mode-option"
                    data-mode-option={value}
                    aria-pressed="true"
                    disabled={!import.meta.env.DEV}
                    title={`Eligible for ${value}. All four on means eligible everywhere, which is the default.`}
                  >{value}</button>
                ))}
              </div>
              <div class="worlds-strength-toggle" role="group" aria-label="Concept strength: what this entry is strong at" data-strength-toggle>
                {['world', 'composition', 'dual'].map(value => (
                  <button
                    type="button"
                    data-strength-option={value}
                    aria-pressed={String(initialConcept.strength === value)}
                    disabled={!import.meta.env.DEV}
                    title={value === 'world' ? 'Durable visual identity' : value === 'composition' ? 'Staging idea, dressable in any identity' : 'Identity and staging fused'}
                  >{value}</button>
                ))}
              </div>
            </div>
          </header>

          <div class="worlds-coverage" data-coverage hidden></div>

          <div class="worlds-card-grid" data-card-grid hidden>
            <p class="worlds-card-grid-empty" data-card-grid-empty hidden>No concepts match.</p>
            <div class="worlds-card-grid-items" data-card-grid-items></div>
          </div>

          <div class="worlds-concept-body">
            <div class="worlds-concept-copy">
              <p class="worlds-concept-kicker">Structural challenger</p>
              <h2 id="current-concept-form" data-concept-form>{initialConcept.form}</h2>
              <section class="worlds-creative-spark">
                <p>Creative spark</p>
                <strong data-concept-spark>{initialConcept.spark}</strong>
              </section>
              <div class="worlds-tag-row" data-concept-tags>
                {initialConcept.tags.map(tag => <span>{tag}</span>)}
              </div>
              <div class="worlds-concept-meta">
                <div>
                  <p>Design lineage</p>
                  <strong data-concept-lineage>{initialConcept.lineage}</strong>
                </div>
                <div data-concept-review-note-wrap hidden={!initialConcept.review?.note}>
                  <p>Review note</p>
                  <strong data-concept-review-note>{initialConcept.review?.note}</strong>
                </div>
                <div class="worlds-concept-meta-row">
                  <span>Catalog version <em data-catalog-version>{catalog.catalogVersion}</em></span>
                  <button type="button" data-edit-toggle disabled={!import.meta.env.DEV}>
                    Edit concept <kbd>E</kbd>
                  </button>
                </div>
              </div>
            </div>
            <div class="worlds-concept-evidence">
              <p class="worlds-concept-ask">With the label covered, could you tell which world this is?</p>
              <figure class="worlds-concept-card" data-concept-hero-wrap hidden={!initialConcept.card?.heroSrc}>
                <a data-concept-hero-link href={initialConcept.card?.heroSrc} target="_blank" rel="noopener">
                  <img
                    data-concept-hero
                    src={initialConcept.card?.heroSrc}
                    alt={initialConcept.card?.heroSrc ? `Landing page composed in the world of ${initialConcept.form}` : ''}
                    width="2048"
                    height="1152"
                    loading="lazy"
                    decoding="async"
                  >
                </a>
              </figure>
              <figure class="worlds-concept-card" data-concept-docs-wrap hidden={!initialConcept.card?.docsSrc}>
                <figcaption class="worlds-concept-card-label">as a documentation page</figcaption>
                <a data-concept-docs-link href={initialConcept.card?.docsSrc} target="_blank" rel="noopener">
                  <img
                    data-concept-docs
                    src={initialConcept.card?.docsSrc}
                    alt={initialConcept.card?.docsSrc ? `Documentation page composed in the world of ${initialConcept.form}` : ''}
                    width="2048"
                    height="1152"
                    loading="lazy"
                    decoding="async"
                  >
                </a>
              </figure>
              <figure class="worlds-concept-card" data-concept-card-wrap hidden={!initialConcept.card}>
                <a data-concept-card-link href={initialConcept.card?.src} target="_blank" rel="noopener">
                  <img
                    data-concept-card
                    src={initialConcept.card?.src}
                    alt={initialConcept.card ? `Design-system translation of ${initialConcept.form}` : ''}
                    width="2048"
                    height="1152"
                    loading="lazy"
                    decoding="async"
                  >
                </a>
                <figcaption data-concept-card-stale hidden={!initialConcept.card?.stale}>Card predates the latest edit of this concept</figcaption>
              </figure>
              <div class="worlds-system-contract">
                <section>
                  <p>System grammar</p>
                  <ol data-concept-system>
                    {initialConcept.system.map(rule => <li>{rule}</li>)}
                  </ol>
                </section>
                <section>
                  <p>Web leverage</p>
                  <strong data-concept-web-leverage>{initialConcept.webLeverage}</strong>
                </section>
                <section data-concept-avoid-wrap hidden={!initialConcept.avoid?.length}>
                  <p>Avoids</p>
                  <ul class="worlds-concept-avoid" data-concept-avoid>
                    {(initialConcept.avoid || []).map(item => <li>{item}</li>)}
                  </ul>
                </section>
              </div>
            </div>
          </div>

          <form class="worlds-edit-form" data-edit-form role="dialog" aria-modal="true" aria-labelledby="worlds-edit-title" hidden>
            <header>
              <div>
                <p id="worlds-edit-title">Edit source concept</p>
                <strong>The stable ID will not change.</strong>
              </div>
              <button type="button" data-edit-cancel aria-label="Close editor">×</button>
            </header>
            <label>
              <span>Grounded form</span>
              <textarea name="form" rows="5" minlength="40" maxlength="360" required></textarea>
            </label>
            <label>
              <span>Creative spark</span>
              <textarea name="spark" rows="4" minlength="80" maxlength="320" required></textarea>
            </label>
            <div class="worlds-edit-row">
              <label>
                <span>Territory</span>
                <select name="familyId">
                  {wellGroups.map(group => (
                    <optgroup label={group.well.label}>
                      {group.families.map(family => <option value={family.id}>{family.label}</option>)}
                    </optgroup>
                  ))}
                </select>
              </label>
              <label>
                <span>Lineage</span>
                <input name="lineage" minlength="12" maxlength="200" required>
              </label>
            </div>
            <fieldset>
              <legend>Structural tags</legend>
              <div class="worlds-edit-row is-tags">
                <input name="tag1" maxlength="40" aria-label="Structural tag one" required>
                <input name="tag2" maxlength="40" aria-label="Structural tag two" required>
                <input name="tag3" maxlength="40" aria-label="Structural tag three" required>
              </div>
            </fieldset>
            <fieldset>
              <legend>System grammar</legend>
              <div class="worlds-edit-system">
                <textarea name="system1" rows="2" maxlength="180" aria-label="Palette and material rule" required></textarea>
                <textarea name="system2" rows="2" maxlength="180" aria-label="Type and composition rule" required></textarea>
                <textarea name="system3" rows="2" maxlength="180" aria-label="Topology and navigation rule" required></textarea>
                <textarea name="system4" rows="2" maxlength="180" aria-label="Controls and state rule" required></textarea>
                <textarea name="system5" rows="2" maxlength="180" aria-label="Responsive and motion rule" required></textarea>
              </div>
            </fieldset>
            <label>
              <span>Web leverage</span>
              <textarea name="webLeverage" rows="3" minlength="20" maxlength="240" required></textarea>
            </label>
            <footer>
              <button type="button" class="worlds-button-secondary" data-edit-cancel>Cancel</button>
              <button type="submit" class="worlds-button-primary">Save to catalog</button>
            </footer>
          </form>

          <footer class="worlds-review-actions">
            <div class="worlds-action-status">
              <input
                class="worlds-decision-note"
                data-decision-note
                type="text"
                maxlength="500"
                placeholder="Optional note, attached to the next decision"
                aria-label="Optional note attached to the next review decision"
                autocomplete="off"
                disabled={!import.meta.env.DEV}
              >
              <p class="worlds-action-note" data-action-note role="status" aria-live="polite"></p>
              <button type="button" class="worlds-undo" data-undo hidden disabled={!import.meta.env.DEV} aria-keyshortcuts="Alt+Z">
                <span data-undo-label>Undo last decision</span><kbd>⌥Z</kbd>
              </button>
            </div>
            <div class="worlds-action-buttons">
              <button type="button" class="worlds-action-reject" data-review-status="rejected" disabled={!import.meta.env.DEV} aria-keyshortcuts="Alt+R">
                <span>Reject</span><kbd>⌥R</kbd>
              </button>
              <button type="button" class="worlds-action-pending" data-review-status="pending" disabled={!import.meta.env.DEV} aria-keyshortcuts="Alt+U">
                <span>Return to backlog</span><kbd>⌥U</kbd>
              </button>
              <button type="button" class="worlds-action-approve" data-review-status="approved" disabled={!import.meta.env.DEV} aria-keyshortcuts="Alt+A">
                <span>Approve</span><kbd>⌥A</kbd>
              </button>
            </div>
          </footer>
        </article>
      </div>
    </div>
  </section>

  <div class="worlds-toast" role="status" aria-live="polite" data-toast hidden></div>
  <script id="worlds-catalog-data" type="application/json" set:html={pageData}></script>

  <script>
    const payload = JSON.parse(document.getElementById('worlds-catalog-data').textContent);
    const families = payload.families;
    const concepts = families.flatMap(family => family.concepts);
    const familyMap = new Map(families.map(family => [family.id, family]));
    const conceptMap = new Map(concepts.map(concept => [concept.id, concept]));
    const canWrite = payload.canWrite;
    const initialId = location.hash.startsWith('#concept=') ? decodeURIComponent(location.hash.slice(9)) : '';
    const initialStatus = conceptMap.get(initialId)?.status || 'pending';
    const state = {
      status: initialStatus,
      family: 'all',
      mode: 'all',
      view: 'detail',
      query: '',
      currentId: initialId,
    };

    const queueList = document.querySelector('[data-queue-list]');
    const resultCount = document.querySelector('[data-result-count]');
    const windowLabel = document.querySelector('[data-window-label]');
    const queueTitle = document.querySelector('[data-queue-title]');
    const searchInput = document.querySelector('[data-search]');
    const formEl = document.querySelector('[data-concept-form]');
    const wellEl = document.querySelector('[data-concept-well]');
    const familyEl = document.querySelector('[data-concept-family]');
    const idEl = document.querySelector('[data-concept-id]');
    const statusEl = document.querySelector('[data-concept-status]');
    const lineageEl = document.querySelector('[data-concept-lineage]');
    const tagsEl = document.querySelector('[data-concept-tags]');
    const systemEl = document.querySelector('[data-concept-system]');
    const sparkEl = document.querySelector('[data-concept-spark]');
    const cardWrapEl = document.querySelector('[data-concept-card-wrap]');
    const cardImgEl = document.querySelector('[data-concept-card]');
    const cardLinkEl = document.querySelector('[data-concept-card-link]');
    const cardStaleEl = document.querySelector('[data-concept-card-stale]');
    const heroWrapEl = document.querySelector('[data-concept-hero-wrap]');
    const heroImgEl = document.querySelector('[data-concept-hero]');
    const heroLinkEl = document.querySelector('[data-concept-hero-link]');
    const docsWrapEl = document.querySelector('[data-concept-docs-wrap]');
    const docsImgEl = document.querySelector('[data-concept-docs]');
    const docsLinkEl = document.querySelector('[data-concept-docs-link]');
    const webLeverageEl = document.querySelector('[data-concept-web-leverage]');
    const avoidWrapEl = document.querySelector('[data-concept-avoid-wrap]');
    const avoidEl = document.querySelector('[data-concept-avoid]');
    const positionEl = document.querySelector('[data-concept-position]');
    const editForm = document.querySelector('[data-edit-form]');
    const toast = document.querySelector('[data-toast]');
    const reviewStage = document.querySelector('[data-concept-form]').closest('.worlds-review-stage');
    const actionNote = document.querySelector('[data-action-note]');
    const decisionNoteInput = document.querySelector('[data-decision-note]');
    const strengthButtons = [...document.querySelectorAll('[data-strength-option]')];
    const ratingGroup = document.querySelector('[data-rating-group]');
    const ratingButtons = [...document.querySelectorAll('[data-rating-option]')];
    const breadthToggle = document.querySelector('[data-breadth-toggle]');
    const coveragePanel = document.querySelector('[data-coverage]');
    const cardGrid = document.querySelector('[data-card-grid]');
    const reviewControls = document.querySelector('.worlds-review-controls');
    const reviewActions = document.querySelector('.worlds-review-actions');
    const cardGridItems = document.querySelector('[data-card-grid-items]');
    const cardGridEmpty = document.querySelector('[data-card-grid-empty]');
    const conceptBody = document.querySelector('.worlds-concept-body');
    const modesGroup = document.querySelector('[data-modes-group]');
    const modeOptions = [...document.querySelectorAll('[data-mode-option]')];
    let notedConceptId = '';
    const reviewNoteWrapEl = document.querySelector('[data-concept-review-note-wrap]');
    const reviewNoteEl = document.querySelector('[data-concept-review-note]');
    const undoButton = document.querySelector('[data-undo]');
    const undoLabel = document.querySelector('[data-undo-label]');
    const familySearchInput = document.querySelector('[data-family-search]');
    const familyExpandButton = document.querySelector('[data-family-expand]');
    const familyEmpty = document.querySelector('[data-family-empty]');
    const familyButtons = [...document.querySelectorAll('[data-family-filter]')];
    // The header runtime indicator already states write mode; this line only
    // carries transient operation messages (saving, restoring, errors).
    const defaultActionNote = '';
    let toastTimer = 0;
    let familyExpanded = true;
    let lastReview = null;
    let editorBaseline = '';

    function currentConcept() {
      return conceptMap.get(state.currentId) || null;
    }

    function searchableText(concept) {
      return [concept.id, concept.form, concept.spark, concept.lineage, concept.familyLabel, concept.wellLabel, concept.webLeverage, ...concept.tags, ...concept.system].join(' ').toLowerCase();
    }

    function filteredConcepts() {
      const query = state.query.trim().toLowerCase();
      return concepts.filter(concept => {
        if (state.status === 'unrated') {
          if (concept.status !== 'approved' || concept.review?.rating) return false;
        } else if (state.status !== 'all' && concept.status !== state.status) {
          return false;
        }
        if (state.family !== 'all' && concept.familyId !== state.family) return false;
        // A world with no allowedModes is eligible everywhere, so it matches every
        // mode filter. 'scoped' is the inverse view: only worlds someone narrowed.
        if (state.mode !== 'all') {
          const allowed = concept.review?.allowedModes;
          const scoped = Array.isArray(allowed) && allowed.length > 0;
          if (state.mode === 'scoped') {
            if (!scoped) return false;
          } else if (state.mode === 'unscoped') {
            if (scoped) return false;
          } else if (scoped && !allowed.includes(state.mode)) {
            return false;
          }
        }
        return !query || searchableText(concept).includes(query);
      });
    }

    // Coverage: where the catalog is crowded and where it is open. Computed live
    // from the same rules scripts/lib/world-occupancy.mjs uses, so the page and
    // the CLI report never disagree.
    //
    // The axis health line is the important part. A value nobody matches reads as
    // a wide-open opening, and a wave briefed from that would chase a hole that
    // does not exist, so an axis that places too little of the corpus says so
    // instead of quietly reporting zeroes.
    const AXES = payload.aestheticAxes?.axes || [];
    const DIGITAL_FAMILIES = new Set(['medium-native', 'digital-design-canon']);
    const MODE_LIST = ['persuade', 'operate', 'read', 'experience'];
    const TIER_LIST = ['graphic', 'interaction', 'atmosphere'];

    function axisText(concept, axis) {
      if (axis.rule === 'all') return (concept.form + ' ' + (concept.system || []).join(' ')).toLowerCase();
      return ((concept.system || []).find(rule => rule.startsWith(axis.rule)) || '').toLowerCase();
    }
    function axisMatches(concept, axis, value) {
      const text = axisText(concept, axis);
      if (!text) return false;
      // Escaping via a replacer function, not a $& string: a literal $& in a
      // replacement re-inserts the matched text, which is exactly how this line
      // got mangled the first time.
      const says = word => new RegExp(`\\b${word.replace(/[.*+?^${}()|[\]\\]/g, m => '\\' + m)}\\b`, 'i').test(text);
      // A count axis asks how many things a rule names rather than whether it
      // says one: palette rules enumerate pigments instead of naming a strategy.
      if (axis.kind === "count") {
        const found = new Set((axis.lexicon || []).filter(says));
        if (found.size === 0) return false;
        if (value.min != null && found.size < value.min) return false;
        if (value.max != null && found.size > value.max) return false;
        return true;
      }
      return (value.match || []).some(says);
    }

    // Coverage: where the catalog is crowded, where it is open, and whether the
    // measurement can be trusted. Editable, because fixing an axis means changing
    // a keyword and immediately seeing which worlds it caught; doing that by hand
    // in JSON and re-running a script loses the loop that makes it work.
    const coverageState = { open: null, dirty: false };

    function coverageWorlds() {
      return concepts.filter(concept => concept.status === 'approved');
    }

    function axisPlacement(axis, pool) {
      const placed = pool.filter(concept => (axis.values || []).some(value => axisMatches(concept, axis, value)));
      return { placed, unplaced: pool.filter(concept => !placed.includes(concept)) };
    }

    function renderCoverage() {
      const showing = state.view === 'coverage';
      coveragePanel.hidden = !showing;
      if (!showing) return;
      const pool = coverageWorlds();
      const digital = concept => DIGITAL_FAMILIES.has(concept.familyId);
      const modesOf = concept => {
        const allowed = concept.review?.allowedModes;
        return Array.isArray(allowed) && allowed.length ? allowed : MODE_LIST;
      };
      const esc = value => String(value).replace(/[&<>"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]));
      const parts = [];

      parts.push('<p class="worlds-coverage-lede">' + pool.length
        + ' approved worlds. Crowded rows are what the catalog already does; thin rows on a trusted axis are what a wave is briefed from. Click any value to see what it caught.'
        + (coverageState.dirty ? ' <strong>Unsaved axis edits.</strong>' : '') + '</p>');

      parts.push('<h3>Lineage by tier</h3><table class="worlds-coverage-table"><thead><tr><th>lineage</th>'
        + TIER_LIST.map(t => '<th>' + t + '</th>').join('') + '</tr></thead><tbody>'
        + [['digital-native', true], ['physical / cultural', false]].map(([label, want]) =>
            '<tr><th>' + label + '</th>' + TIER_LIST.map(tier => {
              const n = pool.filter(c => digital(c) === want && c.wellTier === tier).length;
              return '<td' + (n === 0 ? ' class="is-empty"' : '') + '>' + n + '</td>';
            }).join('') + '</tr>').join('')
        + '</tbody></table>');

      parts.push('<h3>What each mode can draw</h3><table class="worlds-coverage-table"><thead><tr><th>mode</th><th>digital</th><th>physical</th><th>total</th></tr></thead><tbody>'
        + MODE_LIST.map(mode => {
            const p2 = pool.filter(c => modesOf(c).includes(mode));
            return '<tr><th>' + mode + '</th><td>' + p2.filter(digital).length + '</td><td>'
              + (p2.length - p2.filter(digital).length) + '</td><td>' + p2.length + '</td></tr>';
          }).join('')
        + '</tbody></table>');

      for (const axis of AXES) {
        const { placed, unplaced } = axisPlacement(axis, pool);
        // Recorded-only axes (prohibition is an absence, variance needs two
        // instances) cannot be probed, so zero is "no wave has assigned this yet"
        // rather than a broken probe someone should go fix.
        const recordedOnly = axis.recorded === true;
        const recorded = pool.filter(c => c.axes?.[axis.id] != null).length;
        const trustworthy = recordedOnly
          ? recorded >= pool.length * 0.6
          : placed.length >= pool.length * 0.6;
        parts.push('<h3>' + esc(axis.label) + (axis.question ? ' <small>' + esc(axis.question) + '</small>' : '') + '</h3>');
        if (axis.note) parts.push('<p class="worlds-coverage-note">' + esc(axis.note) + '</p>');
        // One value carrying most of an axis is a smell: density once cleared the
        // trust bar on the bare word "every", which 129 worlds contain.
        const counts = (axis.values || []).map(v => pool.filter(c => axisMatches(c, axis, v)).length);
        const topShare = placed.length ? Math.max(...counts, 0) / placed.length : 0;
        if (!recordedOnly && placed.length > 0 && topShare > 0.6) {
          parts.push('<p class="worlds-coverage-warn">One value carries ' + Math.round(topShare * 100)
            + '% of what this axis places. Check it is not matching a common word.</p>');
        }
        if (!trustworthy && recordedOnly) {
          parts.push('<p class="worlds-coverage-warn">Recorded only: ' + recorded + ' of ' + pool.length
            + ' assigned so far. This dimension cannot be read from a world\'s prose, so it fills as waves'
            + ' assign and record it rather than by finding better keywords.</p>');
        } else if (!trustworthy) {
          parts.push('<p class="worlds-coverage-warn">Places only ' + placed.length + ' of ' + pool.length
            + '. Either the values are wrong or the dimension was never authored, and until it is one or the other'
            + ' nothing here is an opening: a value nobody matches looks exactly like one.'
            + ' <button type="button" class="worlds-coverage-link" data-unplaced="' + esc(axis.id) + '">read the '
            + unplaced.length + ' it missed</button></p>');
        }
        parts.push('<table class="worlds-coverage-table"><thead><tr><th>value</th><th>worlds</th><th>share</th><th>digital</th><th>weight</th></tr></thead><tbody>');
        for (const value of (axis.values || [])) {
          const hits = pool.filter(c => axisMatches(c, axis, value));
          const share = pool.length ? hits.length / pool.length : 0;
          const weight = Math.max(1, Math.round((1 - share) * 10));
          const thin = share < 0.1 && trustworthy;
          const key = axis.id + '/' + value.id;
          const open = coverageState.open === key;
          parts.push('<tr' + (thin ? ' class="is-opening"' : '') + (open ? ' class="is-open"' : '') + '>'
            + '<th><button type="button" class="worlds-coverage-link" data-value-key="' + esc(key) + '">'
            + esc(value.label) + '</button></th>'
            + '<td>' + hits.length + '</td><td>' + Math.round(share * 100) + '%</td>'
            + '<td>' + hits.filter(digital).length + '</td><td>' + weight + '</td></tr>');
          if (open) {
            parts.push('<tr class="worlds-coverage-detail"><td colspan="5">');
            if (axis.kind === 'count') {
              parts.push('<p>Counted from the axis lexicon (' + (axis.lexicon || []).length
                + ' terms) against <code>' + esc(axis.rule) + '</code>, between '
                + (value.min ?? 'any') + ' and ' + (value.max ?? 'any') + '.</p>');
            } else {
              parts.push('<label class="worlds-coverage-edit"><span>match words</span>'
                + '<input type="text" data-match-key="' + esc(key) + '" value="' + esc((value.match || []).join(', ')) + '"'
                + (canWrite ? '' : ' disabled') + '></label>'
                + '<p class="worlds-coverage-hint">Comma separated, matched on word boundaries against <code>'
                + esc(axis.rule) + '</code>. Edits recount live; nothing is written until you save.</p>');
            }
            parts.push('<p class="worlds-coverage-hint">' + hits.length + ' matched:</p><ul class="worlds-coverage-list">'
              + hits.slice(0, 14).map(c => '<li>' + esc(c.form.split(',')[0].slice(0, 96)) + '</li>').join('')
              + (hits.length > 14 ? '<li>and ' + (hits.length - 14) + ' more</li>' : '')
              + (hits.length === 0 ? '<li><em>nothing, which is either an opening or a bad probe</em></li>' : '')
              + '</ul></td></tr>');
          }
        }
        parts.push('</tbody></table>');
        if (coverageState.open === 'unplaced/' + axis.id) {
          parts.push('<div class="worlds-coverage-detail-block"><p class="worlds-coverage-hint">'
            + unplaced.length + ' worlds no value caught. Read these to invent the missing value, not to widen an existing one:</p>'
            + '<ul class="worlds-coverage-list">'
            + unplaced.slice(0, 20).map(c => '<li>' + esc(((c.system || []).find(r => r.startsWith(axis.rule)) || c.form).slice(0, 128)) + '</li>').join('')
            + (unplaced.length > 20 ? '<li>and ' + (unplaced.length - 20) + ' more</li>' : '')
            + '</ul></div>');
        }
      }

      if (canWrite) {
        parts.push('<div class="worlds-coverage-actions">'
          + '<button type="button" class="worlds-coverage-save" data-save-axes' + (coverageState.dirty ? '' : ' disabled') + '>'
          + (coverageState.dirty ? 'Save axes' : 'No axis changes') + '</button></div>');
      }
      coveragePanel.innerHTML = parts.join('');
    }


    let cardSignature = null;
    function renderCardGrid() {
      const showing = state.view === 'cards';
      cardGrid.hidden = !showing;
      conceptBody.hidden = state.view !== 'detail';
      // Every verdict control acts on the current concept, not on the grid, so
      // showing them beside a wall of cards invites judging the wrong entry.
      // Finding happens here; deciding happens on the detail stage.
      reviewControls.hidden = state.view !== 'detail';
      reviewActions.hidden = state.view !== 'detail';
      for (const item of document.querySelectorAll('[data-view]')) {
        item.setAttribute('aria-pressed', String(item.dataset.view === state.view));
      }
      if (!showing) return;
      const rows = filteredConcepts();
      // Cheap identity for the current set: rebuilding 500-odd images on every
      // keystroke of the search box stutters badly.
      const signature = rows.length + ':' + (rows[0]?.id || '') + ':' + (rows[rows.length - 1]?.id || '');
      cardGridEmpty.hidden = rows.length > 0;
      if (signature === cardSignature) return;
      cardSignature = signature;
      cardGridItems.replaceChildren(...rows.map(concept => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'worlds-card';
        button.dataset.cardId = concept.id;
        button.setAttribute('aria-current', String(concept.id === state.currentId));
        const figure = document.createElement('span');
        figure.className = 'worlds-card-thumb';
        if (concept.card?.src) {
          const img = document.createElement('img');
          img.src = concept.card.src;
          img.alt = '';
          // Native lazy loading, so a 531-card grid does not fetch everything at once.
          img.loading = 'lazy';
          img.decoding = 'async';
          figure.append(img);
        } else {
          figure.classList.add('is-unrendered');
          figure.textContent = 'no card';
        }
        const label = document.createElement('span');
        label.className = 'worlds-card-label';
        label.textContent = concept.form.split(',')[0];
        const meta = document.createElement('span');
        meta.className = 'worlds-card-meta';
        meta.dataset.status = concept.status;
        const rating = concept.review?.rating ? '\u2605'.repeat(concept.review.rating) : '';
        const scoped = Array.isArray(concept.review?.allowedModes) && concept.review.allowedModes.length > 0
          ? concept.review.allowedModes.join(' ')
          : '';
        meta.textContent = [concept.status, rating, scoped].filter(Boolean).join('  ');
        button.append(figure, label, meta);
        return button;
      }));
    }

    function showToast(message, kind = 'success') {
      clearTimeout(toastTimer);
      toast.textContent = message;
      toast.dataset.kind = kind;
      toast.hidden = false;
      toastTimer = window.setTimeout(() => { toast.hidden = true; }, kind === 'error' ? 6400 : 3200);
    }

    function setReviewBusy(isBusy, message = defaultActionNote) {
      reviewStage.setAttribute('aria-busy', String(isBusy));
      actionNote.textContent = message;
    }

    function syncStatusTabs() {
      document.querySelectorAll('[data-status-filter]').forEach(item => {
        item.setAttribute('aria-pressed', String(item.dataset.statusFilter === state.status));
      });
    }

    function renderFamilyDirectory() {
      const query = familySearchInput.value.trim().toLowerCase();
      let matches = 0;
      for (const button of familyButtons) {
        const isAll = button.dataset.familyFilter === 'all';
        const isSelected = button.getAttribute('aria-pressed') === 'true';
        const matchesQuery = !query || button.dataset.familyLabel?.includes(query);
        const visible = isAll || isSelected || (query ? matchesQuery : familyExpanded);
        button.hidden = !visible;
        if (visible && !isAll && matchesQuery) matches += 1;
        button.tabIndex = isSelected ? 0 : -1;
      }
      for (const heading of document.querySelectorAll('[data-well-heading]')) {
        const wellId = heading.dataset.wellHeading;
        heading.hidden = !familyButtons.some(button => button.dataset.familyWell === wellId && !button.hidden);
      }
      familyEmpty.hidden = !query || matches > 0;
      familyExpandButton.hidden = Boolean(query);
      familyExpandButton.setAttribute('aria-expanded', String(familyExpanded));
      familyExpandButton.textContent = familyExpanded
        ? 'Show selected family only'
        : `Browse all ${families.length} families`;
    }

    function statusCounts() {
      return concepts.reduce((counts, concept) => {
        counts[concept.status] += 1;
        return counts;
      }, { approved: 0, pending: 0, rejected: 0 });
    }

    function renderCounts() {
      const counts = statusCounts();
      document.querySelector('[data-count-approved]').textContent = counts.approved.toLocaleString();
      document.querySelector('[data-count-pending]').textContent = counts.pending.toLocaleString();
      document.querySelector('[data-count-rejected]').textContent = counts.rejected.toLocaleString();
      document.querySelector('[data-count-unrated]').textContent = concepts
        .filter(concept => concept.status === 'approved' && !concept.review?.rating).length.toLocaleString();
      document.querySelector('[data-count-total]').textContent = concepts.length.toLocaleString();
      // Mode counts are scoped to the current status filter, so they answer how
      // many of what you are looking at each mode can draw from. A world nobody
      // narrowed is eligible everywhere and counts toward every mode.
      const inStatus = concepts.filter(concept => {
        if (state.status === 'unrated') return concept.status === 'approved' && !concept.review?.rating;
        return state.status === 'all' || concept.status === state.status;
      });
      const scopedOf = concept => {
        const allowed = concept.review?.allowedModes;
        return Array.isArray(allowed) && allowed.length > 0 ? allowed : null;
      };
      const modeCount = key => {
        if (key === 'all') return inStatus.length;
        if (key === 'unscoped') return inStatus.filter(c => !scopedOf(c)).length;
        if (key === 'scoped') return inStatus.filter(c => scopedOf(c)).length;
        return inStatus.filter(c => { const a = scopedOf(c); return !a || a.includes(key); }).length;
      };
      for (const cell of document.querySelectorAll('[data-mode-count]')) {
        cell.textContent = modeCount(cell.dataset.modeCount).toLocaleString();
      }
      const reviewed = counts.approved + counts.rejected;
      const percent = Math.round((reviewed / concepts.length) * 100);
      document.querySelector('[data-progress-percent]').textContent = `${percent}%`;
      const progress = document.querySelector('[data-progress-track]');
      progress.setAttribute('aria-valuenow', String(reviewed));
      document.querySelector('[data-progress-fill]').style.setProperty('--worlds-progress', `${(reviewed / concepts.length) * 100}%`);

      for (const button of document.querySelectorAll('[data-family-filter]')) {
        const familyId = button.dataset.familyFilter;
        const count = concepts.filter(concept =>
          (familyId === 'all' || concept.familyId === familyId)
          && (state.status === 'all' || concept.status === state.status)
        ).length;
        button.querySelector('span:last-child')?.replaceChildren(document.createTextNode(count.toLocaleString()));
      }
    }

    function ensureCurrent(rows) {
      if (rows.some(concept => concept.id === state.currentId)) return;
      state.currentId = rows[0]?.id || '';
    }

    function renderQueue(rows) {
      ensureCurrent(rows);
      const currentIndex = Math.max(0, rows.findIndex(concept => concept.id === state.currentId));
      const start = Math.max(0, Math.min(currentIndex - 24, Math.max(0, rows.length - 60)));
      const visible = rows.slice(start, start + 60);
      queueList.replaceChildren();

      if (visible.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'worlds-queue-empty';
        empty.innerHTML = '<strong>No concepts match.</strong><p>Change the status, family, or search query.</p>';
        queueList.append(empty);
      } else {
        for (const [offset, concept] of visible.entries()) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'worlds-queue-item';
          button.dataset.queueConceptId = concept.id;
          button.setAttribute('aria-pressed', String(concept.id === state.currentId));
          button.setAttribute('aria-label', `${start + offset + 1} in current queue: ${concept.form}`);
          button.tabIndex = concept.id === state.currentId ? 0 : -1;
          const index = document.createElement('span');
          index.textContent = String(start + offset + 1).padStart(3, '0');
          const copy = document.createElement('span');
          const family = document.createElement('small');
          family.textContent = concept.familyLabel;
          const form = document.createElement('strong');
          form.textContent = concept.form.split(',')[0];
          copy.append(family, form);
          const status = document.createElement('i');
          status.className = `is-${concept.status}`;
          status.setAttribute('aria-label', concept.status);
          button.append(index, copy, status);
          queueList.append(button);
        }
        queueList.querySelector('[aria-pressed="true"]')?.scrollIntoView({ block: 'nearest' });
      }

      resultCount.textContent = rows.length.toLocaleString();
      windowLabel.textContent = rows.length
        ? `Showing ${start + 1}–${Math.min(start + 60, rows.length)} of ${rows.length.toLocaleString()}`
        : 'No results';
      queueTitle.textContent = state.status === 'pending'
        ? 'Backlog'
        : state.status.charAt(0).toUpperCase() + state.status.slice(1);
    }

    function renderConcept(rows) {
      const concept = currentConcept();
      if (!concept) {
        formEl.textContent = 'No concept selected';
        wellEl.textContent = '';
        familyEl.textContent = 'Empty queue';
        idEl.textContent = 'none';
        statusEl.textContent = 'empty';
        statusEl.className = 'worlds-status-badge';
        lineageEl.textContent = 'Change the current filters to continue.';
        tagsEl.replaceChildren();
        systemEl.replaceChildren();
        sparkEl.textContent = '';
        webLeverageEl.textContent = '';
        avoidWrapEl.hidden = true;
        avoidEl.replaceChildren();
        cardWrapEl.hidden = true;
        cardImgEl.removeAttribute('src');
        cardLinkEl.removeAttribute('href');
        heroWrapEl.hidden = true;
        heroImgEl.removeAttribute('src');
        heroLinkEl.removeAttribute('href');
        docsWrapEl.hidden = true;
        docsImgEl.removeAttribute('src');
        docsLinkEl.removeAttribute('href');
        reviewNoteWrapEl.hidden = true;
        reviewNoteEl.textContent = '';
        decisionNoteInput.value = '';
        notedConceptId = '';
        return;
      }

      const globalIndex = concepts.findIndex(item => item.id === concept.id);
      formEl.textContent = concept.form;
      wellEl.textContent = concept.wellLabel;
      familyEl.textContent = concept.familyLabel;
      idEl.textContent = concept.id;
      // Truncated parts keep their full value reachable on hover.
      familyEl.title = concept.familyLabel;
      idEl.title = concept.id;
      statusEl.textContent = concept.status;
      statusEl.className = `worlds-status-badge is-${concept.status}`;
      lineageEl.textContent = concept.lineage;
      systemEl.replaceChildren(...concept.system.map(rule => {
        const item = document.createElement('li');
        item.textContent = rule;
        return item;
      }));
      sparkEl.textContent = concept.spark;
      webLeverageEl.textContent = concept.webLeverage;
      avoidWrapEl.hidden = !concept.avoid?.length;
      avoidEl.replaceChildren(...(concept.avoid || []).map(item => {
        const li = document.createElement('li');
        li.textContent = item;
        return li;
      }));
      const reviewNote = concept.review?.note || '';
      reviewNoteWrapEl.hidden = !reviewNote;
      reviewNoteEl.textContent = reviewNote;
      strengthButtons.forEach(button => {
        button.setAttribute('aria-pressed', String(button.dataset.strengthOption === concept.strength));
      });
      ratingGroup.hidden = concept.status !== 'approved';
      ratingButtons.forEach(button => {
        button.setAttribute('aria-pressed', String((concept.review?.rating || 0) >= Number(button.dataset.ratingOption)));
      });
      modesGroup.hidden = concept.status !== 'approved';
      const allowed = concept.review?.allowedModes;
      for (const option of modeOptions) {
        const on = !Array.isArray(allowed) || allowed.length === 0 || allowed.includes(option.dataset.modeOption);
        option.setAttribute('aria-pressed', String(on));
      }
      breadthToggle.hidden = concept.status !== 'approved';
      breadthToggle.setAttribute('aria-pressed', String(concept.review?.breadth === 'niche'));
      // The decision-note field mirrors the current concept's saved note.
      // Only refill when the concept changes so re-renders never clobber typing.
      if (concept.id !== notedConceptId) {
        decisionNoteInput.value = reviewNote;
        notedConceptId = concept.id;
      }
      if (concept.card) {
        cardWrapEl.hidden = false;
        cardImgEl.src = concept.card.src;
        cardImgEl.alt = `Design-system translation of ${concept.form}`;
        cardLinkEl.href = concept.card.src;
        cardStaleEl.hidden = !concept.card.stale;
      } else {
        cardWrapEl.hidden = true;
        cardImgEl.removeAttribute('src');
        cardLinkEl.removeAttribute('href');
      }
      if (concept.card?.heroSrc) {
        heroWrapEl.hidden = false;
        heroImgEl.src = concept.card.heroSrc;
        heroImgEl.alt = `Landing page composed in the world of ${concept.form}`;
        heroLinkEl.href = concept.card.heroSrc;
      } else {
        heroWrapEl.hidden = true;
        heroImgEl.removeAttribute('src');
        heroLinkEl.removeAttribute('href');
      }
      if (concept.card?.docsSrc) {
        docsWrapEl.hidden = false;
        docsImgEl.src = concept.card.docsSrc;
        docsImgEl.alt = `Documentation page composed in the world of ${concept.form}`;
        docsLinkEl.href = concept.card.docsSrc;
      } else {
        docsWrapEl.hidden = true;
        docsImgEl.removeAttribute('src');
        docsLinkEl.removeAttribute('href');
      }
      positionEl.textContent = String(globalIndex + 1).padStart(3, '0');
      tagsEl.replaceChildren(...concept.tags.map(tag => {
        const span = document.createElement('span');
        span.textContent = tag;
        return span;
      }));
      history.replaceState(null, '', `#concept=${encodeURIComponent(concept.id)}`);

      for (const button of document.querySelectorAll('[data-review-status]')) {
        button.classList.toggle('is-current', button.dataset.reviewStatus === concept.status);
      }
      const position = rows.findIndex(item => item.id === concept.id);
      document.querySelector('[data-previous]').disabled = position <= 0;
      document.querySelector('[data-next]').disabled = position === -1 || position >= rows.length - 1;
    }

    function render() {
      const rows = filteredConcepts();
      renderCounts();
      renderQueue(rows);
      renderConcept(rows);
      renderCardGrid();
      renderCoverage();
    }

    function move(delta, focusQueue = false) {
      const rows = filteredConcepts();
      if (rows.length === 0) return;
      const currentIndex = Math.max(0, rows.findIndex(concept => concept.id === state.currentId));
      const nextIndex = Math.max(0, Math.min(rows.length - 1, currentIndex + delta));
      state.currentId = rows[nextIndex].id;
      renderQueue(rows);
      renderConcept(rows);
      if (focusQueue) queueList.querySelector('[aria-pressed="true"]')?.focus();
    }

    async function persistReview(concept, status, note = '') {
      const response = await fetch('/__impeccable/worlds', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'review', id: concept.id, status, ...(note ? { note } : {}) }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Review could not be saved');
      return result.result.review;
    }

    function revealUndo(review) {
      lastReview = review;
      undoLabel.textContent = `Undo ${review.nextStatus}: ${review.form.split(',')[0]}`;
      undoButton.hidden = false;
    }

    async function review(status) {
      const concept = currentConcept();
      if (!canWrite || !concept) return;
      const note = decisionNoteInput.value.trim();
      const sameStatus = concept.status === status;
      const savedNote = concept.review?.note || '';
      // A same-status decision re-saves only when the note changed (added,
      // edited, or cleared); otherwise it is a no-op. Backlog entries hold no
      // review record, so notes cannot attach to them.
      if (note && status === 'pending') {
        showToast('Notes attach to approve or reject; clear the note first to return to backlog', 'error');
        return;
      }
      if (sameStatus && note === savedNote) return;
      const rowsBefore = filteredConcepts();
      const indexBefore = rowsBefore.findIndex(item => item.id === concept.id);
      const previousStatus = concept.status;
      const buttons = [...document.querySelectorAll('[data-review-status]')];
      buttons.forEach(button => { button.disabled = true; });
      undoButton.disabled = true;
      setReviewBusy(true, sameStatus ? 'Saving note…' : `Saving ${status} decision…`);
      try {
        const savedReview = await persistReview(concept, status, note);
        concept.status = status;
        concept.review = savedReview;
        if (!sameStatus) revealUndo({ id: concept.id, form: concept.form, previousStatus, nextStatus: status });
        const rowsAfter = filteredConcepts();
        if (!rowsAfter.some(item => item.id === concept.id)) {
          state.currentId = rowsAfter[Math.min(Math.max(indexBefore, 0), Math.max(0, rowsAfter.length - 1))]?.id || '';
        }
        render();
        showToast(sameStatus
          ? `${note ? 'Note saved' : 'Note removed'}: ${concept.form.split(',')[0]}`
          : `${status === 'pending' ? 'Returned' : status === 'approved' ? 'Approved' : 'Rejected'}: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      } finally {
        buttons.forEach(button => { button.disabled = !canWrite; });
        undoButton.disabled = !canWrite;
        setReviewBusy(false);
      }
    }

    async function setStrength(strength) {
      const concept = currentConcept();
      if (!canWrite || !concept || concept.strength === strength) return;
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'strength', id: concept.id, strength }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Strength could not be saved');
        concept.strength = strength;
        document.querySelector('[data-catalog-version]').textContent = result.result.catalogVersion;
        render();
        showToast(`Typed as ${strength}: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      }
    }

    async function setRating(value) {
      const concept = currentConcept();
      if (!canWrite || !concept || concept.status !== 'approved') return;
      // Rating the current value again clears it.
      const rating = concept.review?.rating === value ? null : value;
      const rowsBefore = filteredConcepts();
      const indexBefore = rowsBefore.findIndex(item => item.id === concept.id);
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'rate', id: concept.id, rating }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Rating could not be saved');
        concept.review = result.result.review;
        // In the unrated filter a rated item leaves the list; advance in place.
        const rowsAfter = filteredConcepts();
        if (!rowsAfter.some(item => item.id === concept.id)) {
          state.currentId = rowsAfter[Math.min(Math.max(indexBefore, 0), Math.max(0, rowsAfter.length - 1))]?.id || concept.id;
        }
        render();
        showToast(rating
          ? `Rated ${'★'.repeat(rating)}: ${concept.form.split(',')[0]}`
          : `Rating cleared: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      }
    }

    // Breadth is not a quality grade. It answers whether a world can serve an
    // arbitrary build, so an excellent but narrow world can be held out of
    // challenger draws without being libelled as marginal.
    async function toggleBreadth() {
      const concept = currentConcept();
      if (!canWrite || !concept || concept.status !== 'approved') return;
      const breadth = concept.review?.breadth === 'niche' ? 'general' : 'niche';
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'breadth', id: concept.id, breadth }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Breadth could not be saved');
        concept.review = result.result.review;
        render();
        showToast(breadth === 'niche'
          ? `Held out of challenger draws: ${concept.form.split(',')[0]}`
          : `Back in challenger draws: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      }
    }

    // Mode eligibility is a ceiling, not a category. A world with every mode on
    // is eligible everywhere, which is also what an absent field means, so the
    // endpoint stores nothing in that case and the buttons simply read as all-on.
    async function toggleMode(mode) {
      const concept = currentConcept();
      if (!canWrite || !concept || concept.status !== 'approved') return;
      const current = Array.isArray(concept.review?.allowedModes) && concept.review.allowedModes.length > 0
        ? [...concept.review.allowedModes]
        : ['persuade', 'operate', 'read', 'experience'];
      const next = current.includes(mode) ? current.filter(entry => entry !== mode) : [...current, mode];
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'modes', id: concept.id, allowedModes: next }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Mode eligibility could not be saved');
        concept.review = result.result.review;
        render();
        const saved = result.result.allowedModes;
        showToast(saved
          ? `Eligible for ${saved.join(', ')}: ${concept.form.split(',')[0]}`
          : `Eligible in every mode: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      }
    }

    async function undoLastReview() {
      if (!canWrite || !lastReview) return;
      const review = lastReview;
      const concept = conceptMap.get(review.id);
      if (!concept) return;
      const buttons = [...document.querySelectorAll('[data-review-status]')];
      buttons.forEach(button => { button.disabled = true; });
      undoButton.disabled = true;
      setReviewBusy(true, 'Restoring the previous decision…');
      try {
        concept.review = await persistReview(concept, review.previousStatus);
        concept.status = review.previousStatus;
        state.currentId = concept.id;
        lastReview = null;
        undoButton.hidden = true;
        render();
        showToast(`Restored: ${concept.form.split(',')[0]}`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      } finally {
        buttons.forEach(button => { button.disabled = !canWrite; });
        undoButton.disabled = !canWrite;
        setReviewBusy(false);
      }
    }

    function editorSnapshot() {
      const data = new FormData(editForm);
      return JSON.stringify([...data.entries()]);
    }

    function openEditor() {
      const concept = currentConcept();
      if (!canWrite || !concept) return;
      editForm.elements.form.value = concept.form;
      editForm.elements.familyId.value = concept.familyId;
      editForm.elements.lineage.value = concept.lineage;
      editForm.elements.tag1.value = concept.tags[0];
      editForm.elements.tag2.value = concept.tags[1];
      editForm.elements.tag3.value = concept.tags[2];
      editForm.elements.system1.value = concept.system[0];
      editForm.elements.system2.value = concept.system[1];
      editForm.elements.system3.value = concept.system[2];
      editForm.elements.system4.value = concept.system[3];
      editForm.elements.system5.value = concept.system[4];
      editForm.elements.spark.value = concept.spark;
      editForm.elements.webLeverage.value = concept.webLeverage;
      editorBaseline = editorSnapshot();
      editForm.hidden = false;
      editForm.elements.form.focus();
    }

    function closeEditor(force = false) {
      if (!force && !editForm.hidden && editorSnapshot() !== editorBaseline) {
        const discard = window.confirm('Discard your unsaved concept edits?');
        if (!discard) return false;
      }
      editForm.hidden = true;
      return true;
    }

    async function saveEdit(event) {
      event.preventDefault();
      const concept = currentConcept();
      if (!canWrite || !concept) return;
      const submit = editForm.querySelector('[type="submit"]');
      submit.disabled = true;
      const data = new FormData(editForm);
      const body = {
        action: 'update',
        id: concept.id,
        form: data.get('form'),
        familyId: data.get('familyId'),
        lineage: data.get('lineage'),
        tags: [data.get('tag1'), data.get('tag2'), data.get('tag3')],
        system: [data.get('system1'), data.get('system2'), data.get('system3'), data.get('system4'), data.get('system5')],
        spark: data.get('spark'),
        webLeverage: data.get('webLeverage'),
      };
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Concept could not be saved');
        const previousStatus = concept.status;
        const saved = result.result.concept;
        concept.form = saved.form;
        concept.lineage = saved.lineage;
        concept.tags = saved.tags;
        concept.system = saved.system;
        concept.spark = saved.spark;
        concept.webLeverage = saved.webLeverage;
        concept.status = result.result.status;
        concept.review = null;
        if (concept.card) concept.card.stale = true;
        if (concept.familyId !== result.result.familyId) {
          const target = familyMap.get(result.result.familyId);
          concept.familyId = result.result.familyId;
          concept.familyLabel = target.label;
          concept.wellId = target.wellId;
          concept.wellLabel = target.wellLabel;
        }
        document.querySelector('[data-catalog-version]').textContent = result.result.catalogVersion;
        if (lastReview?.id === concept.id) {
          lastReview = null;
          undoButton.hidden = true;
        }
        editorBaseline = editorSnapshot();
        closeEditor(true);
        render();
        showToast(previousStatus === 'pending'
          ? 'Concept source updated'
          : 'Concept updated and returned to the backlog');
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      } finally {
        submit.disabled = false;
      }
    }

    for (const button of document.querySelectorAll('[data-view]')) {
      button.addEventListener('click', () => {
        state.view = button.dataset.view;
        render();
      });
    }
    // Clicking a card opens it, because the grid is for finding one rather than
    // for judging in place: every decision control lives on the detail stage.
    // Coverage interactions. Expanding a value is how a real opening is told from
    // a bad probe: a row at 1% with nothing under it is a hole, a row at 1% whose
    // matched list is full of the wrong worlds is a keyword problem.
    coveragePanel.addEventListener('click', event => {
      const valueButton = event.target.closest('[data-value-key]');
      if (valueButton) {
        const key = valueButton.dataset.valueKey;
        coverageState.open = coverageState.open === key ? null : key;
        renderCoverage();
        return;
      }
      const unplacedButton = event.target.closest('[data-unplaced]');
      if (unplacedButton) {
        const key = 'unplaced/' + unplacedButton.dataset.unplaced;
        coverageState.open = coverageState.open === key ? null : key;
        renderCoverage();
        return;
      }
      if (event.target.closest('[data-save-axes]')) saveAxes();
    });

    // Recount as you type, so a keyword change shows its effect before it is
    // written. The input keeps focus and the caret, since re-rendering the whole
    // panel under a typing cursor is otherwise unusable.
    coveragePanel.addEventListener('input', event => {
      const input = event.target.closest('[data-match-key]');
      if (!input) return;
      const [axisId, valueId] = input.dataset.matchKey.split('/');
      const axis = AXES.find(a => a.id === axisId);
      const value = axis?.values?.find(v => v.id === valueId);
      if (!value) return;
      value.match = input.value.split(',').map(word => word.trim()).filter(Boolean);
      coverageState.dirty = true;
      const caret = input.selectionStart;
      renderCoverage();
      const again = coveragePanel.querySelector('[data-match-key="' + input.dataset.matchKey + '"]');
      if (again) {
        again.focus();
        again.setSelectionRange(caret, caret);
      }
    });

    async function saveAxes() {
      if (!canWrite || !coverageState.dirty) return;
      try {
        const response = await fetch('/__impeccable/worlds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ catalog: 'axes', action: 'axes', axes: { ...payload.aestheticAxes, axes: AXES } }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Axes could not be saved');
        coverageState.dirty = false;
        renderCoverage();
        showToast('Axes saved: ' + result.result.axes + ' axes');
      } catch (error) {
        showToast(error instanceof Error ? error.message : String(error), 'error');
      }
    }

    cardGridItems.addEventListener('click', event => {
      const card = event.target.closest('[data-card-id]');
      if (!card) return;
      state.currentId = card.dataset.cardId;
      state.view = 'detail';
      render();
    });
    document.querySelectorAll('[data-mode-filter]').forEach(button => {
      button.addEventListener('click', () => {
        state.mode = button.dataset.modeFilter;
        document.querySelectorAll('[data-mode-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        render();
      });
    });
    document.querySelectorAll('[data-status-filter]').forEach(button => {
      button.addEventListener('click', () => {
        state.status = button.dataset.statusFilter;
        document.querySelectorAll('[data-status-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        render();
      });
    });
    document.querySelectorAll('[data-family-filter]').forEach(button => {
      button.addEventListener('click', () => {
        state.family = button.dataset.familyFilter;
        document.querySelectorAll('[data-family-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        renderFamilyDirectory();
        render();
      });
    });
    familySearchInput.addEventListener('input', renderFamilyDirectory);
    familyExpandButton.addEventListener('click', () => {
      familyExpanded = !familyExpanded;
      renderFamilyDirectory();
    });
    document.querySelector('.worlds-family-scroll').addEventListener('keydown', event => {
      if (!event.target.matches('[data-family-filter]')) return;
      if (!['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const visible = familyButtons.filter(button => !button.hidden);
      const index = visible.indexOf(event.target);
      const nextIndex = event.key === 'Home'
        ? 0
        : event.key === 'End'
          ? visible.length - 1
          : Math.max(0, Math.min(visible.length - 1, index + (['ArrowDown', 'ArrowRight'].includes(event.key) ? 1 : -1)));
      visible.forEach(button => { button.tabIndex = -1; });
      visible[nextIndex].tabIndex = 0;
      visible[nextIndex].focus();
    });
    queueList.addEventListener('click', event => {
      const button = event.target.closest('[data-queue-concept-id]');
      if (!button) return;
      state.currentId = button.dataset.queueConceptId;
      render();
    });
    queueList.addEventListener('keydown', event => {
      if (!event.target.closest('[data-queue-concept-id]')) return;
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        move(1, true);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        move(-1, true);
      }
    });
    searchInput.addEventListener('input', () => {
      state.query = searchInput.value;
      render();
    });
    document.querySelector('[data-previous]').addEventListener('click', () => move(-1));
    document.querySelector('[data-next]').addEventListener('click', () => move(1));
    strengthButtons.forEach(button => {
      button.addEventListener('click', () => setStrength(button.dataset.strengthOption));
    });
    ratingButtons.forEach(button => {
      button.addEventListener('click', () => setRating(Number(button.dataset.ratingOption)));
    });
    breadthToggle.addEventListener('click', () => toggleBreadth());
    for (const option of modeOptions) {
      option.addEventListener('click', () => toggleMode(option.dataset.modeOption));
    }
    document.querySelectorAll('[data-review-status]').forEach(button => {
      button.addEventListener('click', () => review(button.dataset.reviewStatus));
    });
    undoButton.addEventListener('click', undoLastReview);
    document.querySelector('[data-edit-toggle]').addEventListener('click', openEditor);
    document.querySelectorAll('[data-edit-cancel]').forEach(button => button.addEventListener('click', () => closeEditor()));
    editForm.addEventListener('submit', saveEdit);
    window.addEventListener('hashchange', () => {
      const id = location.hash.startsWith('#concept=') ? decodeURIComponent(location.hash.slice(9)) : '';
      if (conceptMap.has(id)) {
        state.currentId = id;
        render();
      }
    });
    document.addEventListener('keydown', event => {
      const target = event.target;
      if (event.key === 'Escape' && !editForm.hidden) {
        event.preventDefault();
        closeEditor();
        return;
      }
      if (target === decisionNoteInput && event.altKey) {
        // Decision shortcuts stay live while typing a note: write the reason,
        // then commit with the same keys. event.code sidesteps macOS Alt
        // remapping inside text inputs.
        if (event.code === 'KeyA') { event.preventDefault(); review('approved'); return; }
        if (event.code === 'KeyR') { event.preventDefault(); review('rejected'); return; }
        if (event.code === 'KeyU') { event.preventDefault(); review('pending'); return; }
      }
      if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement || target.isContentEditable) {
        return;
      }
      if (event.key === '/') {
        event.preventDefault();
        searchInput.focus();
      } else if (event.key.toLowerCase() === 'j') {
        move(1, Boolean(target.closest?.('[data-queue-list]')));
      } else if (event.key.toLowerCase() === 'k') {
        move(-1, Boolean(target.closest?.('[data-queue-list]')));
      } else if (event.key === 'ArrowDown' && !event.altKey && !event.metaKey && !event.ctrlKey) {
        event.preventDefault();
        move(1, Boolean(target.closest?.('[data-queue-list]')));
      } else if (event.key === 'ArrowUp' && !event.altKey && !event.metaKey && !event.ctrlKey) {
        event.preventDefault();
        move(-1, Boolean(target.closest?.('[data-queue-list]')));
      } else if (event.altKey && event.key.toLowerCase() === 'a') {
        event.preventDefault();
        review('approved');
      } else if (event.altKey && event.key.toLowerCase() === 'r') {
        event.preventDefault();
        review('rejected');
      } else if (event.altKey && event.key.toLowerCase() === 'u') {
        event.preventDefault();
        review('pending');
      } else if (event.altKey && event.key.toLowerCase() === 'z') {
        event.preventDefault();
        undoLastReview();
      } else if (event.key.toLowerCase() === 'e') {
        openEditor();
      } else if (['1', '2', '3'].includes(event.key) && !event.altKey && !event.metaKey && !event.ctrlKey) {
        setRating(Number(event.key));
      } else if (event.key.toLowerCase() === 'n' && !event.altKey && !event.metaKey && !event.ctrlKey) {
        toggleBreadth();
      }
    });
    window.addEventListener('beforeunload', event => {
      if (!editForm.hidden && editorSnapshot() !== editorBaseline) event.preventDefault();
    });

    if (!conceptMap.has(state.currentId)) state.currentId = filteredConcepts()[0]?.id || concepts[0]?.id || '';
    syncStatusTabs();
    renderFamilyDirectory();
    render();
  </script>
</Base>
