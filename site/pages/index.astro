---
import Base from '../layouts/Base.astro';
import Testimonials from '../components/Testimonials.astro';
import HeroProof from '../components/HeroProof.astro';
import LiveSteeringDemo from '../components/LiveSteeringDemo.astro';
import SlopPatternPreview from '../components/SlopPatternPreview.astro';
import WorldsRoll from '../components/WorldsRoll.astro';
import CommandConsole from '../components/CommandConsole.astro';
import '../styles/main.css';
// The build materializes cli/ from the public repo, so this count is the
// engine's own at build time; a literal here goes stale whenever the public
// rule set changes and fails the deploy days later on an unrelated push.
import { ANTIPATTERNS } from '../../cli/engine/registry/antipatterns.mjs';
const detectionRuleCount = new Set(ANTIPATTERNS.map(rule => rule.id)).size;
import '../styles/sub-pages.css';
import '../styles/home-kinpaku.css';
import '../styles/home-sections.css';
import '../styles/home-demos.css';
import '../styles/testimonials.css';
import '../styles/worlds-roll.css';
---

<Base
  title="Impeccable: The missing design vocabulary for agents"
  description="1 skill, 23 commands, and curated anti-patterns for impeccable frontend design. Works with Cursor, Claude Code, GitHub Copilot, Gemini CLI, and Codex CLI."
  activeNav="home"
  canonicalPath="/"
  bodyClass="home-kinpaku kinpaku-chrome"
  mainId="main-content"
  mainClass="site-content"
  ogTitle="Impeccable: The missing design vocabulary for agents"
  ogDescription="1 skill, 23 commands, and curated anti-patterns for impeccable frontend design. Works with Cursor, Claude Code, GitHub Copilot, Gemini CLI, and Codex CLI."
  ogImage="https://impeccable.style/og-image-v3.jpg"
  twitterSite="@pbakaus"
  twitterCreator="@pbakaus"
>

<Fragment slot="head">
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TEXGHC7V34"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TEXGHC7V34');
  </script>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#f9f9f9">
</Fragment>

<Fragment slot="after-header">
  <!-- 1. HERO -->
  <section id="hero" class="hero">
    <svg class="hero-cable" data-hero-cable aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="hero-cable-ink" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="0">
          <stop offset="0" stop-color="var(--ks-ink)" />
          <stop offset="0.18" stop-color="var(--ks-ink)" />
          <stop offset="0.42" stop-color="var(--ks-gray-2)" />
          <stop offset="1" stop-color="var(--ks-gray-2)" />
        </linearGradient>
      </defs>
      <path class="hero-cable-lead" d="" />
    </svg>
    <div class="hero-container">
      <div class="hero-left">
        <h1 class="hero-title">The missing design <span class="hero-cable-from" data-cable-from><span class="hero-cable-v" data-cable-v>v</span>ocabular<span class="hero-cable-y" data-cable-y>y</span></span> for agents.</h1>

        <p class="hero-body">
          Impeccable strips the slop from AI-generated interfaces, gives you precise commands
          to steer, and iterates visual variants live in your product.
        </p>

        <div class="hero-actions">
          <a href="#downloads" class="ks-button ks-button-primary">
            Get started
            <span class="ks-button-arrow" aria-hidden="true">
              <svg viewBox="0 0 16 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
                <path d="M0 4h14M10 0l4 4-4 4"/>
              </svg>
            </span>
          </a>
          <a href="/designing" class="ks-button ks-button-ghost">How it works</a>
        </div>

        <div class="hero-logos" aria-label="AI coding harnesses Impeccable works with">
          <span class="hero-logo has-tooltip" data-tooltip="Codex CLI"><img src="assets/openai-logo.png" alt="Codex CLI" width="20" height="20" loading="lazy"></span>
          <span class="hero-logo has-tooltip" data-tooltip="Claude Code"><img src="assets/claude-logo.png" alt="Claude Code" width="22" height="22" loading="lazy"></span>
          <span class="hero-logo has-tooltip" data-tooltip="GitHub Copilot"><img src="assets/github-copilot-logo.svg" alt="GitHub Copilot" width="20" height="20" loading="lazy"></span>
          <span class="hero-logo has-tooltip" data-tooltip="Cursor"><img src="assets/cursor-logo.png" alt="Cursor" width="22" height="22" loading="lazy"></span>
          <span class="hero-logo has-tooltip" data-tooltip="Gemini CLI"><img src="assets/gemini-logo.png" alt="Gemini CLI" width="20" height="20" loading="lazy"></span>
          <span class="hero-logo has-tooltip" data-tooltip="Grok Build"><img src="assets/grok-logo.png" alt="Grok Build" width="20" height="20" loading="lazy"></span>
          <span class="hero-logo has-tooltip" data-tooltip="Antigravity"><img src="assets/antigravity-logo.png" alt="Antigravity" width="20" height="20" loading="lazy"></span>
          <span class="hero-logo has-tooltip" data-tooltip="OpenCode"><img src="assets/opencode-logo.png" alt="OpenCode" width="20" height="20" loading="lazy"></span>
          <span class="hero-logo has-tooltip" data-tooltip="Pi"><img src="assets/pi-logo.svg" alt="Pi" width="20" height="20" loading="lazy"></span>
          <span class="hero-logo has-tooltip" data-tooltip="Hermes Agent"><img src="assets/hermes-logo.png" alt="Hermes Agent" width="20" height="20" loading="lazy"></span>
          <span class="hero-logos-caption" aria-hidden="true">Codex CLI · Claude Code · GitHub Copilot · Cursor · Gemini CLI · Grok Build · Antigravity · OpenCode · Pi · Hermes Agent</span>
        </div>
      </div>

      <div class="hero-right">
        <HeroProof />
      </div>
    </div>
  </section>
</Fragment>

    <!-- 01b. TESTIMONIALS: five-variant section, switcher in the bottom-right
         floating panel. Sits between the hero and the slop teaser. The dot-grid
         divider that used to open the slop section now opens this one. -->
    <Testimonials />


    <SlopPatternPreview />

    <!-- 02. THE LANGUAGE - The command console, then two steering surfaces -->
    <section class="language-section" id="language">
      <div id="solution" style="height:0;overflow:hidden;visibility:hidden"></div>
      <div class="section-header" data-reveal>
        <h2 class="section-title">The Language</h2>
        <p class="section-lead">23 commands give you a shared design vocabulary with your AI. Each names one kind of intervention: <code>/typeset</code> for type, <code>/distill</code> for complexity, <code>/audit</code> for production quality. One design sits in the window. Every control touches it.<br /><a href="/docs" class="cheatsheet-link">Browse the full reference &rarr;</a></p>
      </div>
      <div id="commands-section" style="height:0;overflow:hidden;visibility:hidden"></div>
      <div class="language-content">
        <CommandConsole />

        <section class="language-steering" aria-labelledby="language-steering-title">
          <header class="language-steering-head">
            <h3 id="language-steering-title">Steer from the chat, or point at the page.</h3>
            <p>Every command runs in your agent's thread. Live Mode adds a picker to your running app: point at an element, choose a variant, and it lands in your source.</p>
          </header>

          <div class="steering-desktop" data-steering-desktop data-mobile-pane="agent" data-impeccable-ignore="gpt-thin-border-wide-shadow">
            <div class="steering-desktop-bar">
              <span class="steering-window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="steering-desktop-context">main</span>
              <span class="steering-desktop-brand"><i aria-hidden="true"></i> Claudex Cocursor</span>
            </div>

            <div class="steering-mobile-tabs ks-instrument-strip is-paper" role="tablist" aria-label="Steering demo view">
              <button type="button" role="tab" class="ks-instrument-key is-active" data-steering-mobile-tab="agent" aria-selected="true">Agent thread</button>
              <button type="button" role="tab" class="ks-instrument-key" data-steering-mobile-tab="browser" aria-selected="false">In-app browser</button>
            </div>

            <div class="steering-desktop-panes">
              <article class="steering-pane steering-agent" tabindex="0" data-steering-pane="agent">
                <header class="steering-pane-head">
                  <span class="steering-pane-title"><span class="ks-tag">01</span> In your agent</span>
                  <span class="steering-pane-meta">Working tree</span>
                </header>

                <div class="steering-thread" data-steering-thread aria-label="Example Impeccable agent thread">
                  <div class="steering-thread-scene" data-steering-thread-scene="polish">
                    <div class="steering-thread-user">
                      <span>You</span>
                      <p><code>/impeccable <span data-steering-active-command>polish</span></code> the pricing page. Keep our sharp corners and sober palette. Remove the AI tells.</p>
                    </div>

                    <div class="steering-thread-agent" aria-live="polite">
                      <span>Agent</span>
                      <p data-steering-agent-copy>I’ll polish the page within its existing design system, then run the detector before I hand it back.</p>
                      <div class="steering-hook-log">
                        <p><i aria-hidden="true">↳</i><strong>DESIGN.md loaded</strong><small>Existing system preserved</small></p>
                        <p><i aria-hidden="true">↳</i><strong>4 tells found</strong><small>AI beige · italic serif · side-tab · pulsing dot</small></p>
                        <p><i aria-hidden="true">✓</i><strong>Written to source</strong><small>0 detector findings</small></p>
                      </div>
                    </div>
                  </div>

                  <div class="steering-thread-scene steering-thread-scene--live" data-steering-thread-scene="live">
                    <div class="steering-thread-user">
                      <span>You</span>
                      <p><code>/impeccable live</code></p>
                    </div>

                    <div class="steering-thread-agent">
                      <span>Agent</span>
                      <p>Starting Live Mode against the running app. I’ll open the page, then wait for element picks and page-level steering.</p>
                      <div class="steering-hook-log">
                        <p><i aria-hidden="true">↳</i><strong>Live helper started</strong><small>Picker injected into the app</small></p>
                        <p><i aria-hidden="true">↳</i><strong>localhost:3000 opened</strong><small>Production source connected</small></p>
                        <p><i aria-hidden="true">●</i><strong>Waiting for input</strong><small>Pick an element or steer the whole page</small></p>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="steering-composer-wrap">
                  <div class="steering-command-menu" aria-label="Impeccable commands">
                    <div class="steering-command-query"><span>/impeccable</span><small>Choose a command</small></div>
                    <button type="button" class="is-active" data-steering-command="polish" data-agent-copy="I’ll polish the page within its existing design system, then run the detector before I hand it back." aria-pressed="true"><strong>polish</strong><span>Final quality pass</span><kbd>↵</kbd></button>
                    <button type="button" data-steering-command="audit" data-agent-copy="I’ll audit the page for accessibility, responsive behavior, and production quality." aria-pressed="false"><strong>audit</strong><span>Production quality</span><kbd>↵</kbd></button>
                    <button type="button" data-steering-command="typeset" data-agent-copy="I’ll clarify the type hierarchy while preserving the project’s existing fonts and tokens." aria-pressed="false"><strong>typeset</strong><span>Typography hierarchy</span><kbd>↵</kbd></button>
                    <button type="button" data-steering-command="distill" data-agent-copy="I’ll remove nonessential UI and make the primary task unmistakable." aria-pressed="false"><strong>distill</strong><span>Strip to the essence</span><kbd>↵</kbd></button>
                  </div>
                  <button type="button" class="steering-composer" aria-label="Choose an Impeccable command">
                    <span class="steering-composer-plus" aria-hidden="true">+</span>
                    <p><code>/impeccable <span data-steering-active-command data-steering-composer-command>polish</span></code><span class="steering-composer-caret" aria-hidden="true"></span></p>
                    <span class="steering-composer-send" aria-hidden="true"><svg viewBox="0 0 16 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M0 4h14M10 0l4 4-4 4"/></svg></span>
                  </button>
                </div>
              </article>

              <article class="steering-pane steering-browser" tabindex="0" data-steering-pane="browser">
                <header class="steering-pane-head">
                  <span class="steering-pane-title"><span class="ks-tag">02</span> Live Mode, in the browser</span>
                  <span class="steering-pane-meta">Live preview</span>
                </header>
                <div class="steering-browser-toolbar" aria-hidden="true">
                  <span class="steering-browser-nav">
                    <i><svg viewBox="0 0 16 16"><path d="m9.75 3.5-4.5 4.5 4.5 4.5M5.5 8h6.25" /></svg></i>
                    <i><svg viewBox="0 0 16 16"><path d="m6.25 3.5 4.5 4.5-4.5 4.5M10.5 8H4.25" /></svg></i>
                    <i><svg viewBox="0 0 16 16"><path d="M12.5 6A5 5 0 1 0 13 9M12.5 3.5V6H10" /></svg></i>
                  </span>
                  <span class="steering-browser-address"><i></i> localhost:3000</span>
                  <span class="steering-browser-open"><svg viewBox="0 0 16 16"><path d="M9 3h4v4M13 3 7.5 8.5M12 9.5V13H3V4h3.5" /></svg></span>
                </div>
                <LiveSteeringDemo />
              </article>
            </div>
          </div>
        </section>
      </div>
    </section>

    <!-- 03. WORLDS: the live roll. Deals six flagship worlds from /api/roll,
         Neo Mirai anchors as the played card. Replaces the old Neo Mirai
         bento tile; the page only ever renders what a roll deals. -->
    <WorldsRoll />


    <!-- 05. READY TO DROP IN: bento grid with five tiles. Replaces the
         carousel (initWhyTabs in app.js returns early when .why-layout is
         missing, so leaving that JS in place is harmless). Tiles share
         inner content classes (.why-panel-title, .why-panel-body,
         .why-visual--*) with the old carousel; only the outer chrome
         changed. -->
    <section class="why-section" id="why">
      <div class="why-content" data-reveal>
        <div class="section-header">
          <h2 class="section-title">Ready to drop in</h2>
        </div>

        <div class="ks-bento why-bento">
          <!-- T1: hero, wide. Respects your design system. -->
          <article class="ks-bento-tile ks-bento-tile--span-8" id="why-respects">
            <span class="ks-tag" data-impeccable-ignore="undersized-ui-text">01</span>
            <h3 class="why-panel-title">Respects your design system.</h3>
            <p class="why-panel-body">Inherits your tokens, components, and conventions instead of overwriting them. New work fits the system, not the model's defaults.</p>
            <div class="why-visual why-visual--terminal">
                <div class="why-terminal">
                  <div class="why-terminal-header">
                    <span class="why-terminal-dot"></span>
                    <span class="why-terminal-dot"></span>
                    <span class="why-terminal-dot"></span>
                    <span class="why-terminal-title">/impeccable polish : scanning codebase</span>
                  </div>
                  <div class="why-terminal-body">
                    <div class="why-terminal-line why-terminal-line--prompt"><span class="why-terminal-prompt">&rsaquo;</span> Walking src/…</div>
                    <div class="why-terminal-line">  <span class="why-terminal-ok">&check;</span> <span class="why-terminal-path">src/styles/tokens.css</span> &nbsp;<span class="why-terminal-meta">14 colors, 6 font sizes, 7 spacing steps</span></div>
                    <div class="why-terminal-line">  <span class="why-terminal-ok">&check;</span> <span class="why-terminal-path">tailwind.config.ts</span> &nbsp;<span class="why-terminal-meta">theme.extend merged</span></div>
                    <div class="why-terminal-line">  <span class="why-terminal-ok">&check;</span> <span class="why-terminal-path">src/components/</span> &nbsp;<span class="why-terminal-meta">34 components</span></div>
                    <div class="why-terminal-line">&nbsp;&nbsp;&nbsp;&nbsp;<span class="why-terminal-meta">&middot; Button: primary, secondary, ghost, destructive</span></div>
                    <div class="why-terminal-line">&nbsp;&nbsp;&nbsp;&nbsp;<span class="why-terminal-meta">&middot; Card: 3 variants, 8px / 16px radii</span></div>
                    <div class="why-terminal-line">&nbsp;&nbsp;&nbsp;&nbsp;<span class="why-terminal-meta">&middot; Input, Select, Dialog, Toast, Table&hellip;</span></div>
                    <div class="why-terminal-line">  <span class="why-terminal-ok">&check;</span> <span class="why-terminal-path">DESIGN.md</span> &nbsp;<span class="why-terminal-meta">brand rules loaded</span></div>
                    <div class="why-terminal-line why-terminal-line--hint"><span class="why-terminal-arrow">&rarr;</span> Matching your system. Not inventing one.</div>
                  </div>
                </div>
              </div>
          </article>

          <!-- T2: narrow. Real product context: PRODUCT.md as an editor sees
               it, and the commands that read it taking turns on the strip. -->
          <article class="ks-bento-tile ks-bento-tile--span-4" id="why-product">
            <span class="ks-tag" data-impeccable-ignore="undersized-ui-text">02</span>
            <h3 class="why-panel-title">Real product context.</h3>
            <p class="why-panel-body">The brief lives in <code>PRODUCT.md</code>. Every command reads it first.</p>
            <div class="why-visual why-visual--productmd">
              <div class="why-pm-file" role="img" aria-label="PRODUCT.md open in an editor, with Mode, Users and Anti-references fields filled in.">
                <div class="why-pm-header">
                  <span class="why-pm-filename">PRODUCT.md</span>
                  <span class="why-pm-lang">Markdown</span>
                </div>
                <ol class="why-pm-lines" aria-hidden="true">
                  <li class="why-pm-key">## Mode</li>
                  <li>Operate. Design serves the task.</li>
                  <li class="why-pm-blank"></li>
                  <li class="why-pm-key">## Users</li>
                  <li>SREs on call, reading fast, often in the dark.</li>
                  <li class="why-pm-blank"></li>
                  <li class="why-pm-key">## Anti-references</li>
                  <li>Purple gradients. Glassmorphism. "Boost your productivity."</li>
                </ol>
              </div>
              <div class="why-pm-reads" aria-hidden="true">
                <span class="why-pm-reads-label">Read by</span>
                <div class="ks-instrument-strip is-paper why-pm-strip" data-why-reads>
                  <span class="ks-instrument-key is-active">polish</span>
                  <span class="ks-instrument-key">audit</span>
                  <span class="ks-instrument-key">layout</span>
                </div>
              </div>
            </div>
          </article>

          <!-- T3: narrow. DESIGN.md travels. Restored from the parked panel
               at site/_parked/the-case.astro. -->
          <article class="ks-bento-tile ks-bento-tile--span-4" id="why-designmd">
            <span class="ks-tag" data-impeccable-ignore="undersized-ui-text">03</span>
            <h3 class="why-panel-title">Travels as DESIGN.md.</h3>
            <p class="why-panel-body"><code>/impeccable document</code> writes one in the <a href="https://stitch.withgoogle.com/docs/design-md/overview/" target="_blank" rel="noopener">Google Stitch format</a>. Your visual system becomes portable.</p>
            <div class="why-visual why-visual--designmd-v2">
              <div class="why-dm-header">
                <span class="why-dm-filename">DESIGN.md</span>
                <span class="why-dm-badge">Google Stitch spec</span>
              </div>
              <div class="why-dm-grid">
                <div class="why-dm-tile why-dm-tile--color" style="--c: var(--ks-kinpaku);">
                  <div class="why-dm-tile-meta"><span>Primary</span><span>oklch(78% .12 82)</span></div>
                  <div class="why-dm-color-hero"></div>
                  <div class="why-dm-color-ramp">
                    <span style="background: oklch(22% .04 78)"></span>
                    <span style="background: oklch(34% .06 78)"></span>
                    <span style="background: oklch(48% .08 78)"></span>
                    <span style="background: oklch(61% .085 78)"></span>
                    <span style="background: oklch(72% .105 82)"></span>
                    <span style="background: oklch(78% .12 82)"></span>
                    <span style="background: oklch(84% .075 84)"></span>
                    <span style="background: oklch(89% .055 84)"></span>
                  </div>
                </div>
                <div class="why-dm-tile why-dm-tile--type">
                  <div class="why-dm-tile-meta"><span>Wordmark</span><span>Spaced 400</span></div>
                  <div class="why-dm-type-specimen">IM</div>
                  <div class="why-dm-type-family">Avenir Next</div>
                </div>
                <div class="why-dm-tile why-dm-tile--type">
                  <div class="why-dm-tile-meta"><span>Body</span><span>Regular 400</span></div>
                  <div class="why-dm-type-specimen why-dm-type-specimen--sans">Aa</div>
                  <div class="why-dm-type-family">Avenir Next</div>
                </div>
                <div class="why-dm-tile why-dm-tile--components">
                  <div class="why-dm-tile-meta"><span>Components</span><span>34</span></div>
                  <div class="why-dm-comp-row">
                    <span class="why-dm-comp-chip why-dm-comp-chip--primary">Primary</span>
                    <span class="why-dm-comp-chip">Ghost</span>
                  </div>
                  <div class="why-dm-comp-input">Email address</div>
                </div>
              </div>
              <div class="why-dm-foot">Readable by every DESIGN.md-aware tool.</div>
            </div>
          </article>

          <!-- T4: medium. Surface modes as four miniatures; the mode the
               PRODUCT.md demo names (Operate) is the lit one. -->
          <article class="ks-bento-tile ks-bento-tile--span-4" id="why-modes">
            <span class="ks-tag" data-impeccable-ignore="undersized-ui-text">04</span>
            <h3 class="why-panel-title">Knows what the surface is for.</h3>
            <p class="why-panel-body">A landing page persuades, a dashboard gets out of the way. Impeccable names the mode before it draws.</p>
            <div class="why-visual why-visual--modes">
              <ul class="why-modes" aria-label="The four surface modes">
                <li class="why-mode">
                  <span class="why-mode-thumb why-mode-thumb--persuade" aria-hidden="true">
                    <i class="why-mode-nav"></i>
                    <i class="why-mode-h1"></i>
                    <i class="why-mode-h1 why-mode-h1--short"></i>
                    <i class="why-mode-cta"></i>
                    <i class="why-mode-art"></i>
                  </span>
                  <span class="why-mode-label">Persuade</span>
                </li>
                <li class="why-mode is-lit">
                  <span class="why-mode-thumb why-mode-thumb--operate" aria-hidden="true">
                    <i class="why-mode-side"></i>
                    <i class="why-mode-bar"></i>
                    <i class="why-mode-cell"></i>
                    <i class="why-mode-cell"></i>
                    <i class="why-mode-cell"></i>
                    <i class="why-mode-panel"></i>
                  </span>
                  <span class="why-mode-label">Operate</span>
                </li>
                <li class="why-mode">
                  <span class="why-mode-thumb why-mode-thumb--read" aria-hidden="true">
                    <i class="why-mode-title"></i>
                    <i class="why-mode-line"></i>
                    <i class="why-mode-line"></i>
                    <i class="why-mode-line"></i>
                    <i class="why-mode-line"></i>
                    <i class="why-mode-line why-mode-line--short"></i>
                  </span>
                  <span class="why-mode-label">Read</span>
                </li>
                <li class="why-mode">
                  <span class="why-mode-thumb why-mode-thumb--experience" aria-hidden="true">
                    <i class="why-mode-mark"></i>
                    <i class="why-mode-caption"></i>
                  </span>
                  <span class="why-mode-label">Experience</span>
                </li>
              </ul>
            </div>
          </article>

          <!-- T5: medium. One pass of the design hook, drawn as a timeline:
               the edit, the findings it returns, the fix, the ready PR. -->
          <article class="ks-bento-tile ks-bento-tile--span-4" id="why-ci">
            <span class="ks-tag" data-impeccable-ignore="undersized-ui-text">05</span>
            <h3 class="why-panel-title">Block slop before it ships.</h3>
            <p class="why-panel-body">A hook reads every UI edit and hands the findings back to the agent before a PR opens.</p>
            <div class="why-visual why-visual--hook">
              <ol class="why-hook" aria-label="One pass of the design hook">
                <li class="why-hook-step">
