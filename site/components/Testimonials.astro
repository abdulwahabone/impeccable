---
// Testimonials section: a single marquee row of testimonial cards.
// Data lives in site/data/testimonials.js and is ordered for impact:
// the row leads with the punchiest quotes.
//
// The card list renders twice so the loop can wrap, but the second set is
// presentation-only: aria-hidden and untabbable, so keyboard and screen-reader
// users meet every quote exactly once. Quotes without a source url (video
// transcriptions) render as plain divs instead of dead links.
import { testimonials } from '../data/testimonials.js';

const initial = (handle) => (handle || '@?').replace('@', '').charAt(0).toUpperCase();
const all = testimonials;
---

<section class="testimonials-section" id="testimonials" aria-label="What people say about Impeccable" data-impeccable-ignore="marquee">
    <div class="t-marquee">
      <div class="t-marquee-row">
        <div class="t-marquee-track">
          {[false, true].map(duplicate => (
            <div class="t-marquee-set" aria-hidden={duplicate ? 'true' : undefined}>
              {all.map(t => {
                const Card = t.url ? 'a' : 'div';
                return (
                  <Card
                    class="t-card t-card--plinth"
                    href={t.url || undefined}
                    target={t.url ? '_blank' : undefined}
                    rel={t.url ? 'noopener' : undefined}
                    tabindex={duplicate && t.url ? '-1' : undefined}
                  >
                    <p class="t-card-quote">{t.quote}</p>
                    <div class="t-card-meta">
                      {t.avatar
                        ? <img class="t-avatar" src={t.avatar} alt="" loading="lazy" width="28" height="28" />
                        : <span class="t-coin" aria-hidden="true">{initial(t.handle)}</span>}
                      <span class="t-name-block">
                        <span class="t-name">{t.name || t.handle}</span>
                        <span class="t-handle">{t.handle}</span>
                      </span>
                    </div>
                  </Card>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </div>
</section>
